// The operating system a build targets, as a typed value chosen at compile time.
//
// `Build.platform()` already answers which OS a build is aimed at, but it answers
// with a String, so every reader compares spelling and a typo compares false in
// silence. `Platform` is the enum form: a `match` over it is exhaustive, and a
// platform the program forgot is a missing arm the compiler names.
//
// `platformCurrent!()` folds to the target's case during macro expansion, off
// the same `Build.platform()` the syscall table refuses declarations by. Because
// the fold happens before the program is analyzed, `platformCurrent!()` is the
// case for the machine being built for — a Mac cross-building aarch64-linux gets
// `.Linux`, not `.MacOS` — and the cases it is not never reach the program.
enum Platform {
    Linux
    MacOS
    Windows
    Ios
    Wasm
    Unknown
}

comptime macro platformCurrent {
    kind { function }
    expand(input: Syntax) -> Syntax {
        let _ = input
        let os = Build.platform()
        if os == "linux" {
            return quote { Platform.Linux }
        }
        if os == "macos" {
            return quote { Platform.MacOS }
        }
        if os == "windows" {
            return quote { Platform.Windows }
        }
        if os == "ios" {
            return quote { Platform.Ios }
        }
        if os == "emscripten" {
            return quote { Platform.Wasm }
        }
        return quote { Platform.Unknown }
    }
}
