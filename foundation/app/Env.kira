// Foundation's environment.
//
// What the process was started with, read-only. Like the filesystem beside it,
// these sit on compiler intrinsics (`env*`) rather than on FFI: the VM answers
// them itself and native code routes them through `kira_rt_env_*`, so a program
// can ask on every backend without a C toolchain and without naming a native
// library.
//
// Naming a library is exactly what went wrong before this existed. A package
// that wanted a debug flag declared `getenv` as an `@FFI.Extern` against
// whichever library was already in scope — the UI Foundation read its `KIRA_UI_*`
// variables through `library: kira_metal` — so a compositor could not link on a
// machine with no Metal, to answer a question that has nothing to do with
// graphics.
//
// Nothing here fails. An unset variable is an ordinary answer: an empty string,
// or `false`.

// Whether `name` is set, however empty its value.
//
// Separate from `environmentValue` because "" and unset are different states: `KIRA_UI_TRACE=`
// is a deliberate empty setting, not an absent one, and a caller that can only
// read the text cannot tell them apart. This is the one to use for a flag whose
// presence is the whole signal.
function environmentIsSet(name: borrow String) -> Bool {
    return envIsSet(name)
}
// The value of `name`, empty when it is unset.
function environmentValue(name: borrow String) -> String {
    return envText(name)
}

// The value of `name` read as a whole number, or `fallback`.
//
// `fallback` covers unset, empty, and text that is not a number — a caller
// tuning a size or a frame count wants a usable number, not three ways to fail.
//
// Text that is *nearly* a number is not one: `16x` reads as the fallback rather
// than as 16. A partial read would turn a typo in an environment variable into a
// value the caller cannot tell from a deliberate setting.
function environmentInt(name: borrow String, fallback: Int) -> Int {
    let written = envText(name)
    if !written.isInt() {
        return fallback
    }
    return written.toInt()
}

// The arguments passed to the compiled program, excluding its executable
// path. The count/index pair keeps this usable from every backend without
// exposing a raw host argv pointer to Kira code.
function processArgumentCount() -> Int {
    return envArgumentCount()
}

// The zero-based user argument at `index`, or an empty string when `index` is
// outside the argument list. Callers should normally range over
// `processArgumentCount()`.
function processArgument(index: Int) -> String {
    return envArgument(index)
}

// Pause the current process for `milliseconds`. This is a wall-clock pause
// for terminal tools; unlike taskSleep, it is not the virtual task scheduler's
// logical clock.
function sleepMilliseconds(milliseconds: Int) {
    processSleep(milliseconds)
    return
}
