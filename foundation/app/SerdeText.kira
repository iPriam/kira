// The reader and writer helpers Foundation's Serde derives generate calls to.
//
// Beside the macros rather than inside them: a generated function is emitted
// once per derived type, and these are the same code for every one of them. The
// wire format itself is described where the macros are, in `DeriveSerde.kira`.
//
// Every name here carries a reserved prefix — `__kira_deser_` for the reading
// half, `__kira_serde_` for the writing half — so a program that derives Serde
// cannot collide with them.
//
// Malformed input traps deterministically on every backend: a structural
// violation drives an out-of-range `charAt` or an inverted `substring`, both of
// which the runtime turns into a hard trap. A value either round-trips or the
// program stops; there is no partial parse and no sentinel.

// A deterministic hard trap in Int context: one past the last byte is always
// out of range.
function __kira_deser_trap(s: borrow String) -> Int {
    return s.charAt(s.count)
}

// The same trap in String context: an inverted substring always traps.
function __kira_deser_trap_str(s: borrow String) -> String {
    return s.substring(s.count + 1, s.count)
}

// Scan forward from `start` over one field VALUE and return the exclusive end
// index — the position of the top-level `;` or `}` that terminates it.
// Brace-aware, so a nested struct value carrying its own `;` is consumed whole;
// a scalar or a quoted string has no braces and stops at the first delimiter,
// which is why one scanner serves every field type.
function __kira_deser_scan(s: borrow String, start: Int) -> Int {
    var pos: Int = start
    var depth: Int = 0
    // Inside a quoted value every byte is content, delimiters included: a
    // `String` holding `;` or `}` is written as itself, and a scanner that read
    // it as structure would end the field early and parse the rest of the text
    // as fields. A `\` skips the byte after it, which is what makes a `\"`
    // inside a value stay inside it.
    var quoted: Bool = false
    let n: Int = s.count
    while pos < n {
        let c: Int = s.charAt(pos)
        if quoted {
            if c == 92 {
                pos = pos + 1
            } else {
                if c == 34 {
                    quoted = false
                }
            }
        } else {
            if c == 34 {
                quoted = true
            } else {
                if c == 123 {
                    depth = depth + 1
                } else {
                    if c == 125 {
                        if depth == 0 {
                            return pos
                        }
                        depth = depth - 1
                    } else {
                        if c == 59 {
                            if depth == 0 {
                                return pos
                            }
                        }
                    }
                }
            }
        }
        pos = pos + 1
    }
    return pos
}

// Parse a signed decimal integer, trapping on empty text, a lone `-`, or any
// non-digit byte.
function __kira_deser_int(s: borrow String) -> Int {
    let n: Int = s.count
    if n == 0 {
        return __kira_deser_trap(s)
    }
    var i: Int = 0
    var neg: Bool = false
    let first: Int = s.charAt(0)
    if first == 45 {
        neg = true
        i = 1
    }
    if i >= n {
        return __kira_deser_trap(s)
    }
    var acc: Int = 0
    while i < n {
        let d: Int = s.charAt(i)
        var digit: Int = 0
        if d < 48 {
            digit = __kira_deser_trap(s)
        } else {
            if d > 57 {
                digit = __kira_deser_trap(s)
            } else {
                digit = d - 48
            }
        }
        acc = acc * 10 + digit
        i = i + 1
    }
    if neg {
        acc = 0 - acc
    }
    return acc
}

// Parse a Bool from exactly "true" / "false"; trap on anything else.
function __kira_deser_bool(s: borrow String) -> Bool {
    if s == "true" {
        return true
    }
    if s == "false" {
        return false
    }
    return __kira_deser_trap(s) == 0
}

// Strip the surrounding `"` from a serialized String value and undo the
// escapes the writer applied; trap when the quotes are absent or an escape is
// not one this format defines.
//
// The escapes are the format's whole answer to a value that contains its own
// delimiters: without them a `String` holding `"`, `,`, or `}` ends the field
// early and the rest of the value is read as structure. That is silent
// corruption — the parse succeeds and answers something else — which is the
// one failure a wire format must not have.
function __kira_deser_unquote(s: borrow String) -> String {
    let n: Int = s.count
    if n < 2 {
        return __kira_deser_trap_str(s)
    }
    if s.charAt(0) != 34 {
        return __kira_deser_trap_str(s)
    }
    if s.charAt(n - 1) != 34 {
        return __kira_deser_trap_str(s)
    }
    return __kira_deser_unescape(s.substring(1, n - 1))
}

// Undo one escaped body: `\"`, `\\`, `\n`, `\r`, `\t`, and `\0`. Any other
// escape is malformed input and traps, because a reader that passed an unknown
// escape through would answer with text nothing wrote.
function __kira_deser_unescape(s: borrow String) -> String {
    var out: String = ""
    var i: Int = 0
    let n: Int = s.count
    while i < n {
        let c: Int = s.charAt(i)
        if c != 92 {
            out = out + scalarText(Int(c))
            i = i + 1
        } else {
            if i + 1 >= n {
                return __kira_deser_trap_str(s)
            }
            let e: Int = s.charAt(i + 1)
            if e == 34 {
                out = out + "\""
            } else {
                if e == 92 {
                    out = out + "\\"
                } else {
                    if e == 110 {
                        out = out + "\n"
                    } else {
                        if e == 114 {
                            out = out + "\r"
                        } else {
                            if e == 116 {
                                out = out + "\t"
                            } else {
                                if e == 48 {
                                    out = out + scalarText(0)
                                } else {
                                    return __kira_deser_trap_str(s)
                                }
                            }
                        }
                    }
                }
            }
            i = i + 2
        }
    }
    return out
}

// A `Float` as the exact bits it is, written `0x` and sixteen hex digits.
//
// Not a decimal rendering: `String(0.1)` is a reading of the value, and reading
// it back is a second rounding, so a decimal wire format loses the low bits of
// almost every float and cannot carry a signed zero, an infinity, or a NaN
// payload at all. The bits are the value, and they read back as themselves.
function __kira_serde_float(v: Float) -> String {
    return "0x" + __kira_serde_hex(floatToBits(v), 16)
}

// `digits` hex digits of `bits`, most significant first, zero-padded.
function __kira_serde_hex(bits: U64, digits: Int) -> String {
    let table: String = "0123456789abcdef"
    var out: String = ""
    var index: Int = digits - 1
    while index >= 0 {
        let shift: U64 = U64(index * 4)
        let nibble: Int = Int((bits >> shift) & U64(15))
        out = out + table.substring(nibble, nibble + 1)
        index = index - 1
    }
    return out
}

// The `Float` a `0x`-prefixed sixteen-digit body names, trapping on anything
// that is not exactly that.
function __kira_deser_float(s: borrow String) -> Float {
    return bitsToFloat(__kira_deser_hex(s, 16))
}

// The bits a `0x` body names. Traps on a missing prefix, a wrong length, or a
// byte that is not a hex digit: a float read from malformed text would be a
// number nothing wrote.
function __kira_deser_hex(s: borrow String, digits: Int) -> U64 {
    if s.count != digits + 2 {
        return U64(__kira_deser_trap(s))
    }
    if s.charAt(0) != 48 {
        return U64(__kira_deser_trap(s))
    }
    if s.charAt(1) != 120 {
        return U64(__kira_deser_trap(s))
    }
    var bits: U64 = U64(0)
    var index: Int = 2
    while index < s.count {
        let c: Int = Int(s.charAt(index))
        var value: Int = 0
        if c >= 48 && c <= 57 {
            value = c - 48
        } else {
            if c >= 97 && c <= 102 {
                value = c - 87
            } else {
                value = __kira_deser_trap(s)
            }
        }
        bits = (bits << U64(4)) | U64(value)
        index = index + 1
    }
    return bits
}

// The escaped body of a `String` value, without its surrounding quotes.
//
// Only the bytes that would otherwise be read as structure, plus the ones no
// single line can carry: a quote, a backslash, the two line endings, a tab, and
// a NUL. Everything else is written through, so ordinary text stays readable on
// the wire.
function __kira_serde_escape(s: borrow String) -> String {
    var out: String = ""
    var i: Int = 0
    let n: Int = s.count
    while i < n {
        let c: Int = s.charAt(i)
        if c == 34 {
            out = out + "\\\""
        } else {
            if c == 92 {
                out = out + "\\\\"
            } else {
                if c == 10 {
                    out = out + "\\n"
                } else {
                    if c == 13 {
                        out = out + "\\r"
                    } else {
                        if c == 9 {
                            out = out + "\\t"
                        } else {
                            if c == 0 {
                                out = out + "\\0"
                            } else {
                                out = out + scalarText(Int(c))
                            }
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return out
}

