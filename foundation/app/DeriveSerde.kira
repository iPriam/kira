// Foundation's `@Derive(Serializable)` / `@Derive(Deserializable)` macros,
// written in pure Kira beside Derive.kira's Equatable / Clone.
//
//   @Derive(Serializable)   generates  function serialize_<Type>(v: borrow <Type>) -> String
//   @Derive(Deserializable) generates  function deserialize_<Type>(s: borrow String) -> <Type>
//
// WIRE FORMAT (v1, compact, deterministic, single line):
//
//   TypeName{field1:VALUE,field2:VALUE,...}
//
// An integer writes its spelling around its digits — `U8(7)`, `I32(-5)`; a
// Float is `Float(0x` and the sixteen hex digits of its exact bits, an F32 is
// `F32(0x` and eight; a Bool is `true` or `false`; a String field is its
// escaped text wrapped in `"`; a nested derived struct is
// `serialize_<FieldType>(value)` recursed inline, so
// `from:Point{id:TabId(U32(7))}` sits inside its parent's braces. A distinct
// writes its name around its representation the same way: `TabId(U32(7))`.
//
// An ENUM is written as `TypeName.Variant`, with a payload in parentheses after
// it — `Tool.Rotate`, `Note.Rank(Int(42))`, `Slot.At(Point{x:Int(1),y:Int(2)})`. The variant is
// named, never numbered: an ordinal would tie the format to declaration order,
// so inserting a variant would re-read every value ever written as its
// neighbour. An enum field inside a struct is just that text in the field's
// value slot, which the brace-aware scanner already consumes whole.
//
// Deserialization is the exact inverse. It validates the leading `TypeName{`,
// then for each field in declaration order locates `label:`, carves the value
// with a brace-aware scan (a `,` or `}` at brace depth 0 terminates it, and a
// quoted region counts as content, so a nested struct's own balanced braces
// are consumed whole), and converts by field type: an integer tag must name
// the field's width exactly and the digits are range-checked, so `U8(300)`
// traps and `Int(5)` in a `U8` field is refused. Malformed input traps
// deterministically
// on every backend: every structural violation drives an out-of-range `charAt`
// or an inverted `substring`, both of which the runtime turns into a hard trap.
// A value either round-trips or the program stops — there is no partial parse.
//
// ROUND-TRIP LAW: for every value `v` of a supported type,
// `deserialize_T(serialize_T(v))` equals `v` field-wise.
//
// A String value is escaped: `\"`, `\\`, `\n`, `\r`, `\t`, and `\0`. Everything
// else is written as itself, and the scanner that carves a field out treats a
// quoted region as content, so a value holding `,` or `}` round-trips.
//
// LIMITATIONS (v1):
//   * Array / generic / optional field types are refused by both, exactly as
//     Equatable / Clone refuse them.
//   * An enum payload follows the same field rules.
//
// The helpers both macros generate calls to live in `SerdeText.kira`, beside
// this file: they are the same code for every derived type, and only the format
// they read and write is described here.

// The helpers both macros generate calls to live in `SerdeText.kira`, beside
// this file: they are the same code for every derived type, and only the format
// they read and write is described here.
//
// The five functions below are the macros' own shared logic: classifying a
// type text, spelling an annotation for one, and writing or reading a value of
// one. They run at compile time, take and return plain values, and recurse for
// nested arrays — so there is one place that knows how each shape travels,
// however deeply it nests, instead of one copy per position that names it.

// The integer spelling `text` names, or `""` when it names none. The tag an
// integer writes and the check a reader applies come from here, so the eight
// spellings are listed once.
comptime function __kira_serde_int_tag(text: String) -> String {
    for sname in ["Int", "I8", "U8", "I16", "U16", "I32", "U32", "U64"] {
        if text == sname {
            return sname
        }
    }
    return ""
}

// Whether a value of the type `text` reads as can be generated: scalars,
// nested arrays of the same, and single identifiers addressed by name through
// generated `serialize_`/`deserialize_` calls. Generics, qualified names, and
// function types answer false — the generated code could not name what they
// mean — and the caller reports them with the span only it has.
comptime function __kira_serde_ok(text: String) -> Bool {
    var t: String = text.trim()
    if t.startsWith("[") {
        if t.endsWith("]") == false {
            return false
        }
        return __kira_serde_ok(t.substring(1, t.count - 1).trim())
    }
    if __kira_serde_int_tag(t) != "" {
        return true
    }
    if t == "Float" {
        return true
    }
    if t == "F32" {
        return true
    }
    if t == "Bool" {
        return true
    }
    if t == "String" {
        return true
    }
    if t == "CBool" {
        return true
    }
    if t.contains("<") {
        return false
    }
    if t.contains("(") {
        return false
    }
    if t.contains(")") {
        return false
    }
    if t.contains(",") {
        return false
    }
    if t.contains(":") {
        return false
    }
    if t.contains(" ") {
        return false
    }
    if t.contains("[") {
        return false
    }
    if t.contains("]") {
        return false
    }
    if t == "" {
        return false
    }
    return true
}

// The annotation syntax for the type `text` reads as: a plain name splices
// directly, and an array nests. Only called on text `__kira_serde_ok`
// accepted, so every name here resolves where the annotation lands.
comptime function __kira_serde_ann(text: String) -> Syntax {
    var t: String = text.trim()
    if t.startsWith("[") {
        var inner: Syntax = __kira_serde_ann(t.substring(1, t.count - 1).trim())
        return quote { [#{inner}] }
    }
    return quote { #{Identifier(t)} }
}

// Statements serializing the value `value` reads as — of the type `typeText`
// reads as — appended to the string `target` names. Scalars append one piece;
// an array appends its brackets around one element per turn, recursing for the
// element. Only called on text `__kira_serde_ok` accepted.
comptime function __kira_serde_write_into(typeText: String, value: Syntax, target: Syntax, stem: String) -> Syntax {
    var t: String = typeText.trim()
    var tag: String = __kira_serde_int_tag(t)
    if tag != "" {
        return quote { #{target} = #{target} + #{tag} + "(" + String(#{value}) + ")" }
    }
    if t == "Float" {
        return quote { #{target} = #{target} + __kira_serde_float(#{value}) }
    }
    if t == "F32" {
        return quote { #{target} = #{target} + __kira_serde_float32(#{value}) }
    }
    if t == "Bool" {
        return quote { #{target} = #{target} + String(#{value}) }
    }
    if t == "CBool" {
        return quote { #{target} = #{target} + String(#{value}) }
    }
    if t == "String" {
        return quote { #{target} = #{target} + "\"" + __kira_serde_escape(#{value}) + "\"" }
    }
    if t.startsWith("[") {
        var inner: String = t.substring(1, t.count - 1).trim()
        var nest: String = stem + "n"
        var wrote: Syntax = __kira_serde_write_into(inner, quote { #{Identifier("__e" + stem)} }, target, nest)
        return quote {
            #{target} = #{target} + "["
            var #{Identifier("__n" + stem)}: Int = 0
            for #{Identifier("__e" + stem)} in #{value} {
                if #{Identifier("__n" + stem)} != 0 {
                    #{target} = #{target} + ","
                }
                #{wrote}
                #{Identifier("__n" + stem)} = #{Identifier("__n" + stem)} + 1
            }
            #{target} = #{target} + "]"
        }
    }
    return quote { #{target} = #{target} + #{Identifier("serialize_" + t)}(#{value}) }
}

// Statements reading one value of the type `typeText` reads as out of the
// string `source` reads as, binding it to the name `result` carries. Scalars
// bind one conversion; an array carves its elements out of the brackets and
// recurses for each. Only called on text `__kira_serde_ok` accepted.
comptime function __kira_serde_read_value(typeText: String, source: Syntax, result: String, stem: String) -> Syntax {
    var t: String = typeText.trim()
    var ann: Syntax = __kira_serde_ann(t)
    var tag: String = __kira_serde_int_tag(t)
    if tag != "" {
        if t == "U64" {
            return quote { let #{Identifier(result)}: #{ann} = U64(__kira_deser_tagged_uint(#{source}, "U64")) }
        }
        return quote { let #{Identifier(result)}: #{ann} = #{Identifier(t)}(__kira_deser_tagged_int(#{source}, #{tag})) }
    }
    if t == "Float" {
        return quote { let #{Identifier(result)}: #{ann} = __kira_deser_float(#{source}) }
    }
    if t == "F32" {
        return quote { let #{Identifier(result)}: #{ann} = __kira_deser_float32(#{source}) }
    }
    if t == "Bool" {
        return quote { let #{Identifier(result)}: #{ann} = __kira_deser_bool(#{source}) }
    }
    if t == "String" {
        return quote { let #{Identifier(result)}: #{ann} = __kira_deser_unquote(#{source}) }
    }
    if t.startsWith("[") {
        var inner: String = t.substring(1, t.count - 1).trim()
        var nest: String = stem + "n"
        var read: Syntax = __kira_serde_read_value(inner, quote { #{Identifier("__e" + stem)} }, "__v" + nest, nest)
        return quote {
            let #{Identifier("__a" + stem)} = #{source}
            var #{Identifier("__o" + stem)}: #{ann} = []
            var #{Identifier("__p" + stem)}: Int = 1
            while #{Identifier("__p" + stem)} < #{Identifier("__a" + stem)}.count - 1 {
                let #{Identifier("__end" + stem)}: Int = __kira_deser_scan(#{Identifier("__a" + stem)}, #{Identifier("__p" + stem)})
                if #{Identifier("__end" + stem)} == #{Identifier("__p" + stem)} {
                    #{Identifier("__p" + stem)} = __kira_deser_trap(#{Identifier("__a" + stem)})
                }
                let #{Identifier("__e" + stem)}: String = #{Identifier("__a" + stem)}.substring(#{Identifier("__p" + stem)}, #{Identifier("__end" + stem)})
                #{read}
                #{Identifier("__o" + stem)}.append(#{Identifier("__v" + nest)})
                #{Identifier("__p" + stem)} = #{Identifier("__end" + stem)}
                if #{Identifier("__a" + stem)}.charAt(#{Identifier("__p" + stem)}) == 44 {
                    #{Identifier("__p" + stem)} = #{Identifier("__p" + stem)} + 1
                    if #{Identifier("__a" + stem)}.charAt(#{Identifier("__p" + stem)}) == 93 {
                        #{Identifier("__p" + stem)} = __kira_deser_trap(#{Identifier("__a" + stem)})
                    }
                }
            }
            if #{Identifier("__a" + stem)}.charAt(#{Identifier("__p" + stem)}) != 93 {
                #{Identifier("__p" + stem)} = __kira_deser_trap(#{Identifier("__a" + stem)})
            }
            let #{Identifier(result)}: #{ann} = #{Identifier("__o" + stem)}
        }
    }
    return quote { let #{Identifier(result)}: #{ann} = #{Identifier("deserialize_" + t)}(#{source}) }
}

comptime macro Serializable {
    kind { derive }
    appliesTo { struct enum distinct }
    expand(target: Declaration) -> Syntax {
        // A distinct type writes its name around the representation it is:
        // `TabId(Int(7))`, not `7` and not `TabId{raw=7}`. The outer tag is
        // the nominal identity the language keeps apart from the
        // representation, and the inner value is written exactly as it would
        // be anywhere else — including its own tag — so one reader shape
        // serves every position. A reader that wanted a `TabId` asked
        // `deserialize_TabId` for one.
        if target.kind == .Distinct {
            var rep: String = "Int"
            for field in target.fields {
                for sname in ["Int", "I8", "U8", "I16", "U16", "I32", "U32", "U64", "Float", "F32", "Bool", "String"] {
                    if field.type == sname {
                        rep = sname
                    }
                }
                if field.type == "RawPtr" {
                    Diagnostics.error(
                        "Derive(Serializable): a distinct type over `RawPtr` has nothing to write — an opaque foreign word is an address, and it means nothing in another process or another run",
                        at: target.syntax
                    )
                }
            }
            var repValue: Syntax = quote { String(v.raw) }
            if rep == "Float" {
                repValue = quote { __kira_serde_float(v.raw) }
            }
            if rep == "F32" {
                repValue = quote { __kira_serde_float32(v.raw) }
            }
            if rep == "String" {
                repValue = quote { "\"" + __kira_serde_escape(v.raw) + "\"" }
            }
            var repIntTag: String = ""
            for sname in ["Int", "I8", "U8", "I16", "U16", "I32", "U32", "U64"] {
                if rep == sname {
                    repIntTag = sname
                }
            }
            if repIntTag != "" {
                repValue = quote { #{repIntTag} + "(" + String(v.raw) + ")" }
            }
            return quote {
                function serialize_#{target.name}(v: borrow #{target.name}) -> String {
                    return #{target.name.asString()} + "(" + #{repValue} + ")"
                }
            }
        }
        // An enum writes the variant it holds by NAME — `Tool.Rotate` — and a
        // payload in parentheses after it. The name is the point: an ordinal
        // would make the wire format depend on declaration ORDER, so inserting a
        // variant would silently re-read every value ever written.
        if target.kind == .Enum {
            var arms: [Syntax] = []
            for variant in target.fields {
                var head: String = target.name.asString() + "." + variant.name.asString()
                if variant.type.asSyntax() == "" {
                    arms.append(quote { #{variant.name} -> return #{head} })
                } else {
                    // An integer payload is tagged exactly as a field is.
                    var intTag: String = ""
                    for sname in ["Int", "I8", "U8", "I16", "U16", "I32", "U32", "U64"] {
                        if variant.type == sname {
                            intTag = sname
                        }
                    }
                    var payloadText: String = String(variant.type.asSyntax()).trim()
                    var isArrayPayload: Bool = payloadText.startsWith("[") && payloadText.endsWith("]")
                    if isArrayPayload {
                        if __kira_serde_ok(payloadText) == false {
                            Diagnostics.error("Derive(Serializable): variant `" + variant.name.asString() + "` has payload type `" + payloadText + "`, which Serde cannot generate: array elements are an integer width, Float, F32, Bool, String, a nested array thereof, or a named type with its own `serialize_` function", at: variant.syntax)
                        } else {
                            var stem: String = "p" + variant.name.asString()
                            arms.append(quote {
                                #{variant.name}(payload) -> {
                                    var #{Identifier("__s" + stem)}: String = ""
                                    #{__kira_serde_write_into(payloadText, quote { payload }, quote { #{Identifier("__s" + stem)} }, stem)}
                                    return #{head} + "(" + #{Identifier("__s" + stem)} + ")"
                                }
                            })
                        }
                    } else if intTag != "" {
                        arms.append(quote {
                            #{variant.name}(payload) -> return #{head} + "(" + #{intTag} + "(" + String(payload) + "))"
                        })
                    // A float payload writes its bits, exactly as a float field
                    // does: a decimal rendering is a second rounding on the way
                    // back.
                    } else if variant.type == "Float" {
                        arms.append(quote {
                            #{variant.name}(payload) -> return #{head} + "(" + __kira_serde_float(payload) + ")"
                        })
                    } else if variant.type == "F32" {
                        arms.append(quote {
                            #{variant.name}(payload) -> return #{head} + "(" + __kira_serde_float32(payload) + ")"
                        })
                    } else if variant.type == "Bool" {
                        arms.append(quote {
                            #{variant.name}(payload) -> return #{head} + "(" + String(payload) + ")"
                        })
                    // `CBool` is a Foundation-level convention, not a compiler
                    // type with a tagged grammar form, so it keeps the
                    // rendering it always had: the reader takes it back through
                    // the same `deserialize_CBool` it always did.
                    } else if variant.type == "CBool" {
                        arms.append(quote {
                            #{variant.name}(payload) -> return #{head} + "(" + String(payload) + ")"
                        })
                    } else if variant.type == "String" {
                        arms.append(quote {
                            #{variant.name}(payload) -> return #{head} + "(\"" + __kira_serde_escape(payload) + "\")"
                        })
                    } else {
                        arms.append(quote {
                            #{variant.name}(payload) -> return #{head} + "(" + serialize_#{variant.type.asSyntax()}(payload) + ")"
                        })
                    }
                }
            }
            return quote {
                function serialize_#{target.name}(v: borrow #{target.name}) -> String {
                    match v {
                        #{arms}
                    }
                }
            }
        }
        var stmts: [Syntax] = []
        stmts.append(quote { var out: String = #{target.name.asString()} })
        stmts.append(quote { out = out + "{" })
        var idx: Int = 0
        for field in target.fields {
            var joined: String = ""
            for id in field.type.asSyntax().identifiers() {
                joined = joined + id.asString()
            }
            if joined != field.type.asSyntax() {
                var asArray: String = String(field.type.asSyntax()).trim()
                if asArray.startsWith("[") == false || asArray.endsWith("]") == false {
                    Diagnostics.error("Derive(Serializable): field has an unsupported generic type; only an integer width, Float, F32, Bool, String, an array thereof, or a nested @Derive(Serializable) struct field are supported", at: target.syntax)
                }
            }
            var sep: String = ""
            if idx != 0 {
                sep = ","
            }
            var fieldText: String = String(field.type.asSyntax()).trim()
            var isArrayField: Bool = fieldText.startsWith("[") && fieldText.endsWith("]")
            if isArrayField {
                if __kira_serde_ok(fieldText) == false {
                    Diagnostics.error("Derive(Serializable): field `" + field.name.asString() + "` has type `" + fieldText + "`, which Serde cannot generate: array elements are an integer width, Float, F32, Bool, String, a nested array thereof, or a named type with its own `serialize_` function", at: field.syntax)
                } else {
                    stmts.append(quote { out = out + #{sep} + #{field.name.asString()} + ":" })
                    stmts.append(__kira_serde_write_into(fieldText, quote { v.#{field.name} }, quote { out }, "f" + field.name.asString()))
                }
                idx = idx + 1
            } else {
            // An integer writes its spelling around its digits — `U8(7)`, not
            // `7` — so the value carries its width and a reader range-checks
            // it before building the field.
            var intTag: String = ""
            for sname in ["Int", "I8", "U8", "I16", "U16", "I32", "U32", "U64"] {
                if field.type == sname {
                    intTag = sname
                }
            }
            if intTag != "" {
                stmts.append(quote {
                    out = out + #{sep} + #{field.name.asString()} + ":" + #{intTag} + "(" + String(v.#{field.name}) + ")"
                })
            // A float writes its bits, not a rendering of them: see
            // `__kira_serde_float`.
            } else if field.type == "Float" {
                stmts.append(quote {
                    out = out + #{sep} + #{field.name.asString()} + ":" + __kira_serde_float(v.#{field.name})
                })
            } else if field.type == "F32" {
                stmts.append(quote {
                    out = out + #{sep} + #{field.name.asString()} + ":" + __kira_serde_float32(v.#{field.name})
                })
            } else if field.type == "Bool" {
                stmts.append(quote { out = out + #{sep} + #{field.name.asString()} + ":" + String(v.#{field.name}) })
            } else if field.type == "String" {
                stmts.append(quote { out = out + #{sep} + #{field.name.asString()} + ":" + "\"" + __kira_serde_escape(v.#{field.name}) + "\"" })
            } else {
                stmts.append(quote { out = out + #{sep} + #{field.name.asString()} + ":" + serialize_#{field.type.asSyntax()}(v.#{field.name}) })
            }
            }
            idx = idx + 1
        }
        stmts.append(quote { out = out + "}" })
        stmts.append(quote { return out })
        return quote {
            function serialize_#{target.name}(v: borrow #{target.name}) -> String {
                #{stmts}
            }
        }
    }
}

comptime macro Deserializable {
    kind { derive }
    appliesTo { struct enum distinct }
    expand(target: Declaration) -> Syntax {
        // The exact inverse of the distinct writer: validate `Name(`, read the
        // representation as the value it is — tag, digits, and range check
        // included — validate `)`, and build the type by calling it, which is
        // the one way into a distinct type.
        if target.kind == .Distinct {
            // One body for every representation: the inner read differs and
            // the call around it does not.
            var rep: String = "Int"
            for field in target.fields {
                for sname in ["Int", "I8", "U8", "I16", "U16", "I32", "U32", "U64", "Float", "F32", "Bool", "String"] {
                    if field.type == sname {
                        rep = sname
                    }
                }
                if field.type == "RawPtr" {
                    Diagnostics.error(
                        "Derive(Deserializable): a distinct type over `RawPtr` cannot be read back — an opaque foreign word is an address, and it means nothing in another process or another run",
                        at: target.syntax
                    )
                }
            }
            // The opener: `Name(` must lead, and the value must close. A
            // missing `(` makes `indexOf` answer -1, so the substring is
            // inverted and traps.
            var open: Syntax = quote {
                var __open: Int = s.indexOf("(")
                if s.substring(0, __open) != #{target.name.asString()} {
                    __open = __kira_deser_trap(s)
                }
                if s.charAt(s.count - 1) != 41 {
                    __open = __kira_deser_trap(s)
                }
                let __inner: String = s.substring(__open + 1, s.count - 1)
            }
            // One body for every representation: the inner read differs and
            // the call around it does not, because a splice in argument
            // position renders inline like any other splice.
            var readInner: Syntax = quote { __kira_deser_tagged_int(__inner, "Int") }
            if rep == "I8" {
                readInner = quote { I8(__kira_deser_tagged_int(__inner, "I8")) }
            }
            if rep == "U8" {
                readInner = quote { U8(__kira_deser_tagged_int(__inner, "U8")) }
            }
            if rep == "I16" {
                readInner = quote { I16(__kira_deser_tagged_int(__inner, "I16")) }
            }
            if rep == "U16" {
                readInner = quote { U16(__kira_deser_tagged_int(__inner, "U16")) }
            }
            if rep == "I32" {
                readInner = quote { I32(__kira_deser_tagged_int(__inner, "I32")) }
            }
            if rep == "U32" {
                readInner = quote { U32(__kira_deser_tagged_int(__inner, "U32")) }
            }
            if rep == "U64" {
                readInner = quote { U64(__kira_deser_tagged_uint(__inner, "U64")) }
            }
            if rep == "Float" {
                readInner = quote { __kira_deser_float(__inner) }
            }
            if rep == "F32" {
                readInner = quote { __kira_deser_float32(__inner) }
            }
            if rep == "Bool" {
                readInner = quote { __kira_deser_bool(__inner) }
            }
            if rep == "String" {
                readInner = quote { __kira_deser_unquote(__inner) }
            }
            return quote {
                function deserialize_#{target.name}(s: borrow String) -> #{target.name} {
                    #{open}
                    return #{target.name}(#{readInner})
                }
            }
        }
        // The inverse of the enum writer: validate `TypeName.`, read the variant
        // name up to `(` or the end, and rebuild that variant — carving the
        // payload out of the parentheses when there is one. An unknown name is a
        // structural violation and traps, exactly as a wrong struct name does.
        if target.kind == .Enum {
            var arms: [Syntax] = []
            // The name matched nothing, which is malformed input: every arm
            // above returned, so this trap is the only way out. It is written
            // as a payload-free variant when the enum has one, and otherwise as
            // the first variant carrying a payload that traps before it is
            // built — an enum has no value that means "no value", and returning
            // one anyway would answer with a variant nothing wrote.
            var fallback: Syntax = quote { }
            var haveFallback: Bool = false
            for variant in target.fields {
                if variant.type.asSyntax() == "" {
                    if haveFallback == false {
                        fallback = quote { return .#{variant.name} }
                        haveFallback = true
                    }
                }
            }
            if haveFallback == false {
                for variant in target.fields {
                    if haveFallback == false {
                        if variant.type == "Int" {
                            fallback = quote { return .#{variant.name}(__kira_deser_trap(s)) }
                        } else {
                            if variant.type == "Bool" {
                                fallback = quote { return .#{variant.name}(__kira_deser_bool(__kira_deser_trap_str(s))) }
                            } else {
                                if variant.type == "String" {
                                    fallback = quote { return .#{variant.name}(__kira_deser_trap_str(s)) }
                                } else {
                                    if variant.type == "Float" {
                                        fallback = quote { return .#{variant.name}(__kira_deser_float(__kira_deser_trap_str(s))) }
                                    } else {
                                        fallback = quote {
                                            return .#{variant.name}(deserialize_#{variant.type.asSyntax()}(__kira_deser_trap_str(s)))
                                        }
                                    }
                                }
                            }
                        }
                        haveFallback = true
                    }
                }
            }
            var seen: Int = 0
            for variant in target.fields {
                seen = seen + 1
                if variant.type.asSyntax() == "" {
                    arms.append(quote {
                        if __name == #{variant.name.asString()} {
                            return .#{variant.name}
                        }
                    })
                } else {
                    // One arm shape for every payload: only the conversion
                    // differs, and a splice in argument position renders inline
                    // like any other splice. An array payload parses through
                    // statements first, so its arm holds those too.
                    var payloadText: String = String(variant.type.asSyntax()).trim()
                    var isArrayPayload: Bool = payloadText.startsWith("[") && payloadText.endsWith("]")
                    if isArrayPayload {
                        if __kira_serde_ok(payloadText) == false {
                            Diagnostics.error("Derive(Deserializable): variant `" + variant.name.asString() + "` has payload type `" + payloadText + "`, which Serde cannot generate: array elements are an integer width, Float, F32, Bool, String, a nested array thereof, or a named type with its own `deserialize_` function", at: variant.syntax)
                        } else {
                            var stem: String = "p" + variant.name.asString()
                            arms.append(quote {
                                if __name == #{variant.name.asString()} {
                                    #{__kira_serde_read_value(payloadText, quote { __inner }, "__v" + stem, stem)}
                                    return .#{variant.name}(#{Identifier("__v" + stem)})
                                }
                            })
                        }
                    }
                    else {
                    var intTag: String = ""
                    for sname in ["Int", "I8", "U8", "I16", "U16", "I32", "U32"] {
                        if variant.type == sname {
                            intTag = sname
                        }
                    }
                    var conv: Syntax = quote { deserialize_#{variant.type.asSyntax()}(__inner) }
                    if intTag != "" {
                        conv = quote { #{variant.type.asSyntax()}(__kira_deser_tagged_int(__inner, #{intTag})) }
                    // The top half of the `U64` range is past what a signed
                    // accumulation can hold, so it parses unsigned.
                    } else if variant.type == "U64" {
                        conv = quote { U64(__kira_deser_tagged_uint(__inner, "U64")) }
                    } else if variant.type == "Bool" {
                        conv = quote { __kira_deser_bool(__inner) }
                    } else if variant.type == "String" {
                        conv = quote { __kira_deser_unquote(__inner) }
                    } else if variant.type == "Float" {
                        conv = quote { __kira_deser_float(__inner) }
                    } else if variant.type == "F32" {
                        conv = quote { __kira_deser_float32(__inner) }
                    }
                    arms.append(quote {
                        if __name == #{variant.name.asString()} {
                            return .#{variant.name}(#{conv})
                        }
                    })
                    }
                }
            }
            return quote {
                function deserialize_#{target.name}(s: borrow String) -> #{target.name} {
                    let __dot: Int = s.indexOf(".")
                    var __head: String = s.substring(0, __dot)
                    if __head != #{target.name.asString()} {
                        __head = __kira_deser_trap_str(s)
                    }
                    let __rest: String = s.substring(__dot + 1, s.count)
                    let __open: Int = __rest.indexOf("(")
                    var __name: String = __rest
                    var __inner: String = ""
                    if __open >= 0 {
                        __name = __rest.substring(0, __open)
                        if __rest.charAt(__rest.count - 1) != 41 {
                            __name = __kira_deser_trap_str(s)
                        }
                        __inner = __rest.substring(__open + 1, __rest.count - 1)
                    }
                    #{arms}
                    let __unknown: Int = __kira_deser_trap(s)
                    #{fallback}
                }
            }
        }
        var total: Int = 0
        for field in target.fields {
            total = total + 1
        }

        var stmts: [Syntax] = []
        // The leading `TypeName` up to the first `{`. A missing `{` gives
        // indexOf == -1, so the substring is inverted and traps; a present but
        // wrong name traps in the branch.
        stmts.append(quote { let __brace: Int = s.indexOf("{") })
        stmts.append(quote { var pos: Int = __brace + 1 })
        stmts.append(quote {
            if s.substring(0, __brace) != #{target.name.asString()} {
                pos = __kira_deser_trap(s)
            }
        })

        var inits: [Syntax] = []
        var idx: Int = 0
        for field in target.fields {
            var joined: String = ""
            for id in field.type.asSyntax().identifiers() {
                joined = joined + id.asString()
            }
            if joined != field.type.asSyntax() {
                var asArray: String = String(field.type.asSyntax()).trim()
                if asArray.startsWith("[") == false || asArray.endsWith("]") == false {
                    Diagnostics.error("Derive(Deserializable): field has an unsupported generic type; only an integer width, Float, F32, Bool, String, an array thereof, or a nested @Derive(Deserializable) struct field are supported", at: target.syntax)
                }
            }

            var fieldText: String = String(field.type.asSyntax()).trim()
            var isArrayField: Bool = fieldText.startsWith("[") && fieldText.endsWith("]")
            if isArrayField {
                if __kira_serde_ok(fieldText) == false {
                    Diagnostics.error("Derive(Deserializable): field `" + field.name.asString() + "` has type `" + fieldText + "`, which Serde cannot generate: array elements are an integer width, Float, F32, Bool, String, a nested array thereof, or a named type with its own `deserialize_` function", at: field.syntax)
                } else {
                    stmts.append(quote {
                        let __rest#{idx}: String = s.substring(pos, s.count)
                        let __eq#{idx}: Int = __rest#{idx}.indexOf(":")
                        let __eqAt#{idx}: Int = pos + __eq#{idx}
                        if s.substring(pos, __eqAt#{idx}) != #{field.name.asString()} {
                            pos = __kira_deser_trap(s)
                        }
                        pos = __eqAt#{idx} + 1
                        let __end#{idx}: Int = __kira_deser_scan(s, pos)
                        let __val#{idx}: String = s.substring(pos, __end#{idx})
                        pos = __end#{idx}
                    })
                    stmts.append(__kira_serde_read_value(fieldText, quote { __val#{idx} }, field.name.asString(), "f" + field.name.asString()))
                }
            } else {

            // The tag the writer wrote, checked exactly before the digits are
            // read, and the narrowing conversion that range-checks them: a
            // `U8` field reading `U8(300)` traps rather than wrapping, and one
            // reading `Int(5)` is refused a value of another type.
            var intTag: String = ""
            for sname in ["Int", "I8", "U8", "I16", "U16", "I32", "U32", "U64"] {
                if field.type == sname {
                    intTag = sname
                }
            }
            var conv: Syntax = quote { deserialize_#{field.type.asSyntax()}(__val#{idx}) }
            if intTag != "" {
                conv = quote { #{field.type.asSyntax()}(__kira_deser_tagged_int(__val#{idx}, #{intTag})) }
            }
            // The top half of the `U64` range is past what a signed
            // accumulation can hold, so it parses unsigned.
            if field.type == "U64" {
                conv = quote { U64(__kira_deser_tagged_uint(__val#{idx}, "U64")) }
            }
            if field.type == "Bool" {
                conv = quote { __kira_deser_bool(__val#{idx}) }
            }
            if field.type == "String" {
                conv = quote { __kira_deser_unquote(__val#{idx}) }
            }
            if field.type == "Float" {
                conv = quote { __kira_deser_float(__val#{idx}) }
            }
            if field.type == "F32" {
                conv = quote { __kira_deser_float32(__val#{idx}) }
            }

            stmts.append(quote {
                let __rest#{idx}: String = s.substring(pos, s.count)
                let __eq#{idx}: Int = __rest#{idx}.indexOf(":")
                let __eqAt#{idx}: Int = pos + __eq#{idx}
                if s.substring(pos, __eqAt#{idx}) != #{field.name.asString()} {
                    pos = __kira_deser_trap(s)
                }
                pos = __eqAt#{idx} + 1
                let __end#{idx}: Int = __kira_deser_scan(s, pos)
                let __val#{idx}: String = s.substring(pos, __end#{idx})
                let #{field.name}: #{field.type.asSyntax()} = #{conv}
                pos = __end#{idx}
            })
            }

            if idx < total - 1 {
                stmts.append(quote {
                    if s.charAt(pos) != 44 {
                        pos = __kira_deser_trap(s)
                    }
                    pos = pos + 1
                })
            }

            inits.append(quote { #{field.name}: #{field.name} })
            idx = idx + 1
        }

        stmts.append(quote {
            if s.charAt(pos) != 125 {
                pos = __kira_deser_trap(s)
            }
        })

        return quote {
            function deserialize_#{target.name}(s: borrow String) -> #{target.name} {
                #{stmts}
                return #{target.name} {
                    #{Syntax.join(inits, ", ")}
                }
            }
        }
    }
}
