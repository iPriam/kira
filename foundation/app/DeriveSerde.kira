// Foundation's `@Derive(Serializable)` / `@Derive(Deserializable)` macros,
// written in pure Kira beside Derive.kira's Equatable / Clone.
//
//   @Derive(Serializable)   generates  function serialize_<Type>(v: borrow <Type>) -> String
//   @Derive(Deserializable) generates  function deserialize_<Type>(s: borrow String) -> <Type>
//
// WIRE FORMAT (v1, compact, deterministic, single line):
//
//   TypeName{field1=VALUE;field2=VALUE;...}
//
// An Int, Float, or Bool field is `String(value)`; a String field is the text
// wrapped in `"`; a nested derived struct is `serialize_<FieldType>(value)`
// recursed inline, so `from=Point{x=1;y=2}` sits inside its parent's braces.
//
// An ENUM is written as `TypeName.Variant`, with a payload in parentheses after
// it — `Tool.Rotate`, `Note.Rank(42)`, `Slot.At(Point{x=1;y=2})`. The variant is
// named, never numbered: an ordinal would tie the format to declaration order,
// so inserting a variant would re-read every value ever written as its
// neighbour. An enum field inside a struct is just that text in the field's
// value slot, which the brace-aware scanner already consumes whole.
//
// Deserialization is the exact inverse. It validates the leading `TypeName{`,
// then for each field in declaration order locates `label=`, carves the value
// with a brace-aware scan (a `;` or `}` at brace depth 0 terminates it, so a
// nested struct's own balanced braces are consumed whole), converts by field
// type, and steps over the delimiter. Malformed input traps deterministically
// on every backend: every structural violation drives an out-of-range `charAt`
// or an inverted `substring`, both of which the runtime turns into a hard trap.
// A value either round-trips or the program stops — there is no partial parse.
//
// ROUND-TRIP LAW: for every value `v` of a supported type,
// `deserialize_T(serialize_T(v))` equals `v` field-wise.
//
// LIMITATIONS (v1):
//   * A String value is not escaped. A String field whose text contains `"`,
//     `;`, or `}` is out of contract: no error is raised, but the wire string is
//     then ambiguous and will not round-trip.
//   * `Deserializable` refuses a `Float` field. There is no lossless `Float`
//     parsing primitive, so refusing beats shipping a parser that silently
//     loses the low bits.
//   * Array / generic / optional field types are refused by both, exactly as
//     Equatable / Clone refuse them.
//   * An enum payload follows the same field rules: a `Float` payload is refused
//     by `Deserializable`, and a `String` payload is unescaped like any other.
//
// The shared helpers below are defined once and carry the reserved
// `__kira_deser_` prefix, so they can never collide with user code.

// A deterministic hard trap in Int context: one past the last byte is always
// out of range.
function __kira_deser_trap(s: borrow String) -> Int {
    return s.charAt(s.count)
}

// The same trap in String context: an inverted substring always traps.
function __kira_deser_trap_str(s: borrow String) -> String {
    return s.substring(s.count + 1, s.count)
}

// Scan forward from `start` over one field VALUE and return the exclusive end
// index — the position of the top-level `;` or `}` that terminates it.
// Brace-aware, so a nested struct value carrying its own `;` is consumed whole;
// a scalar or a quoted string has no braces and stops at the first delimiter,
// which is why one scanner serves every field type.
function __kira_deser_scan(s: borrow String, start: Int) -> Int {
    var pos: Int = start
    var depth: Int = 0
    let n: Int = s.count
    while pos < n {
        let c: Int = s.charAt(pos)
        if c == 123 {
            depth = depth + 1
        } else {
            if c == 125 {
                if depth == 0 {
                    return pos
                }
                depth = depth - 1
            } else {
                if c == 59 {
                    if depth == 0 {
                        return pos
                    }
                }
            }
        }
        pos = pos + 1
    }
    return pos
}

// Parse a signed decimal integer, trapping on empty text, a lone `-`, or any
// non-digit byte.
function __kira_deser_int(s: borrow String) -> Int {
    let n: Int = s.count
    if n == 0 {
        return __kira_deser_trap(s)
    }
    var i: Int = 0
    var neg: Bool = false
    let first: Int = s.charAt(0)
    if first == 45 {
        neg = true
        i = 1
    }
    if i >= n {
        return __kira_deser_trap(s)
    }
    var acc: Int = 0
    while i < n {
        let d: Int = s.charAt(i)
        var digit: Int = 0
        if d < 48 {
            digit = __kira_deser_trap(s)
        } else {
            if d > 57 {
                digit = __kira_deser_trap(s)
            } else {
                digit = d - 48
            }
        }
        acc = acc * 10 + digit
        i = i + 1
    }
    if neg {
        acc = 0 - acc
    }
    return acc
}

// Parse a Bool from exactly "true" / "false"; trap on anything else.
function __kira_deser_bool(s: borrow String) -> Bool {
    if s == "true" {
        return true
    }
    if s == "false" {
        return false
    }
    return __kira_deser_trap(s) == 0
}

// Strip the surrounding `"` from a serialized String value; trap when the
// quotes are absent.
function __kira_deser_unquote(s: borrow String) -> String {
    let n: Int = s.count
    if n < 2 {
        return __kira_deser_trap_str(s)
    }
    if s.charAt(0) != 34 {
        return __kira_deser_trap_str(s)
    }
    if s.charAt(n - 1) != 34 {
        return __kira_deser_trap_str(s)
    }
    return s.substring(1, n - 1)
}

comptime macro Serializable {
    kind { derive }
    appliesTo { struct enum distinct }
    expand(target: Declaration) -> Syntax {
        // A distinct type writes the representation it is, and nothing around
        // it. Not `TabId{raw=7}`: the type is one scalar word, so wrapping it
        // in a struct envelope would put a Kira-side nominal fact on a wire
        // that has no place to keep it and would make every reader parse a
        // shape that carries no information. `7` round-trips, and a reader
        // that wanted a `TabId` asked `deserialize_TabId` for one.
        if target.kind == .Distinct {
            for field in target.fields {
                if field.type == "RawPtr" {
                    Diagnostics.error(
                        "Derive(Serializable): a distinct type over `RawPtr` has nothing to write — an opaque foreign word is an address, and it means nothing in another process or another run",
                        at: target.syntax
                    )
                }
            }
            return quote {
                function serialize_#{target.name}(v: borrow #{target.name}) -> String {
                    return String(v.raw)
                }
            }
        }
        // An enum writes the variant it holds by NAME — `Tool.Rotate` — and a
        // payload in parentheses after it. The name is the point: an ordinal
        // would make the wire format depend on declaration ORDER, so inserting a
        // variant would silently re-read every value ever written.
        if target.kind == .Enum {
            var arms: [Syntax] = []
            for variant in target.fields {
                var head: String = target.name.asString() + "." + variant.name.asString()
                if variant.type.asSyntax() == "" {
                    arms.append(quote { #{variant.name} -> return #{head} })
                } else {
                    var isNumScalar: Bool = false
                    for sname in ["Int", "Float", "Bool", "I8", "U8", "I16", "U16", "I32", "U32", "U64", "F32", "CBool"] {
                        if variant.type == sname {
                            isNumScalar = true
                        }
                    }
                    if isNumScalar {
                        arms.append(quote {
                            #{variant.name}(payload) -> return #{head} + "(" + String(payload) + ")"
                        })
                    } else {
                        if variant.type == "String" {
                            arms.append(quote {
                                #{variant.name}(payload) -> return #{head} + "(\"" + payload + "\")"
                            })
                        } else {
                            arms.append(quote {
                                #{variant.name}(payload) -> return #{head} + "(" + serialize_#{variant.type.asSyntax()}(payload) + ")"
                            })
                        }
                    }
                }
            }
            return quote {
                function serialize_#{target.name}(v: borrow #{target.name}) -> String {
                    match v {
                        #{arms}
                    }
                }
            }
        }
        var stmts: [Syntax] = []
        stmts.append(quote { var out: String = #{target.name.asString()} })
        stmts.append(quote { out = out + "{" })
        var idx: Int = 0
        for field in target.fields {
            var joined: String = ""
            for id in field.type.asSyntax().identifiers() {
                joined = joined + id.asString()
            }
            if joined != field.type.asSyntax() {
                Diagnostics.error("Derive(Serializable): field has an unsupported array or generic type; only Int, Float, Bool, String, or a nested @Derive(Serializable) struct field are supported", at: target.syntax)
            }
            var sep: String = ""
            if idx != 0 {
                sep = ";"
            }
            var isNumScalar: Bool = false
            if field.type == "Int" {
                isNumScalar = true
            }
            if field.type == "Float" {
                isNumScalar = true
            }
            if field.type == "Bool" {
                isNumScalar = true
            }
            if isNumScalar {
                stmts.append(quote { out = out + #{sep} + #{field.name.asString()} + "=" + String(v.#{field.name}) })
            } else {
                if field.type == "String" {
                    stmts.append(quote { out = out + #{sep} + #{field.name.asString()} + "=" + "\"" + v.#{field.name} + "\"" })
                } else {
                    stmts.append(quote { out = out + #{sep} + #{field.name.asString()} + "=" + serialize_#{field.type.asSyntax()}(v.#{field.name}) })
                }
            }
            idx = idx + 1
        }
        stmts.append(quote { out = out + "}" })
        stmts.append(quote { return out })
        return quote {
            function serialize_#{target.name}(v: borrow #{target.name}) -> String {
                #{stmts}
            }
        }
    }
}

comptime macro Deserializable {
    kind { derive }
    appliesTo { struct enum distinct }
    expand(target: Declaration) -> Syntax {
        // The exact inverse of the distinct writer: read the representation and
        // build the type by calling it. `TabId(...)` rather than a brace
        // literal, because calling it is the one way into a distinct type — and
        // an integer literal reaches any integer width, so a representation of
        // `U32` needs no conversion between the parse and the construction.
        if target.kind == .Distinct {
            // Written as two whole function bodies rather than one body with an
            // interpolated argument: a `#{...}` in argument position splices as
            // a statement, which would turn `TabId(parse(s))` into a bare
            // `TabId` and a stray call. The enum branch below carries the same
            // rule for the same reason.
            var body: Syntax = quote {
                function deserialize_#{target.name}(s: borrow String) -> #{target.name} {
                    return #{target.name}(__kira_deser_int(s))
                }
            }
            for field in target.fields {
                if field.type == "Float" {
                    Diagnostics.error(
                        "Derive(Deserializable): a distinct type over `Float` is not supported — there is no lossless Float parser, so derive Serializable only, or declare the type over an Int width",
                        at: target.syntax
                    )
                }
                if field.type == "F32" {
                    Diagnostics.error(
                        "Derive(Deserializable): a distinct type over `F32` is not supported — there is no lossless Float parser, so derive Serializable only, or declare the type over an Int width",
                        at: target.syntax
                    )
                }
                if field.type == "RawPtr" {
                    Diagnostics.error(
                        "Derive(Deserializable): a distinct type over `RawPtr` cannot be read back — an opaque foreign word is an address, and it means nothing in another process or another run",
                        at: target.syntax
                    )
                }
                if field.type == "Bool" {
                    body = quote {
                        function deserialize_#{target.name}(s: borrow String) -> #{target.name} {
                            return #{target.name}(__kira_deser_bool(s))
                        }
                    }
                }
            }
            return body
        }
        // The inverse of the enum writer: validate `TypeName.`, read the variant
        // name up to `(` or the end, and rebuild that variant — carving the
        // payload out of the parentheses when there is one. An unknown name is a
        // structural violation and traps, exactly as a wrong struct name does.
        if target.kind == .Enum {
            var arms: [Syntax] = []
            var fallback: Syntax = quote { }
            var seen: Int = 0
            for variant in target.fields {
                if seen == 0 {
                    fallback = quote { return .#{variant.name} }
                }
                seen = seen + 1
                if variant.type.asSyntax() == "" {
                    arms.append(quote {
                        if __name == #{variant.name.asString()} {
                            return .#{variant.name}
                        }
                    })
                } else {
                    // The conversion is written inline per payload type rather
                    // than interpolated as a prepared expression: a `#{...}` in
                    // argument position splices as a statement, which turns
                    // `.Rank(convert(x))` into a bare `.Rank` and a stray call.
                    if variant.type == "Int" {
                        arms.append(quote {
                            if __name == #{variant.name.asString()} {
                                return .#{variant.name}(__kira_deser_int(__inner))
                            }
                        })
                    } else {
                        if variant.type == "Bool" {
                            arms.append(quote {
                                if __name == #{variant.name.asString()} {
                                    return .#{variant.name}(__kira_deser_bool(__inner))
                                }
                            })
                        } else {
                            if variant.type == "String" {
                                arms.append(quote {
                                    if __name == #{variant.name.asString()} {
                                        return .#{variant.name}(__kira_deser_unquote(__inner))
                                    }
                                })
                            } else {
                                if variant.type == "Float" {
                                    Diagnostics.error("Derive(Deserializable): a Float payload is not supported — there is no lossless Float parser, so derive Serializable only, or carry the value as a String or an Int", at: target.syntax)
                                }
                                arms.append(quote {
                                    if __name == #{variant.name.asString()} {
                                        return .#{variant.name}(deserialize_#{variant.type.asSyntax()}(__inner))
                                    }
                                })
                            }
                        }
                    }
                }
            }
            return quote {
                function deserialize_#{target.name}(s: borrow String) -> #{target.name} {
                    let __dot: Int = s.indexOf(".")
                    var __head: String = s.substring(0, __dot)
                    if __head != #{target.name.asString()} {
                        __head = __kira_deser_trap_str(s)
                    }
                    let __rest: String = s.substring(__dot + 1, s.count)
                    let __open: Int = __rest.indexOf("(")
                    var __name: String = __rest
                    var __inner: String = ""
                    if __open >= 0 {
                        __name = __rest.substring(0, __open)
                        if __rest.charAt(__rest.count - 1) != 41 {
                            __name = __kira_deser_trap_str(s)
                        }
                        __inner = __rest.substring(__open + 1, __rest.count - 1)
                    }
                    #{arms}
                    let __unknown: Int = __kira_deser_trap(s)
                    #{fallback}
                }
            }
        }
        var total: Int = 0
        for field in target.fields {
            total = total + 1
        }

        var stmts: [Syntax] = []
        // The leading `TypeName` up to the first `{`. A missing `{` gives
        // indexOf == -1, so the substring is inverted and traps; a present but
        // wrong name traps in the branch.
        stmts.append(quote { let __brace: Int = s.indexOf("{") })
        stmts.append(quote { var pos: Int = __brace + 1 })
        stmts.append(quote {
            if s.substring(0, __brace) != #{target.name.asString()} {
                pos = __kira_deser_trap(s)
            }
        })

        var inits: [Syntax] = []
        var idx: Int = 0
        for field in target.fields {
            var joined: String = ""
            for id in field.type.asSyntax().identifiers() {
                joined = joined + id.asString()
            }
            if joined != field.type.asSyntax() {
                Diagnostics.error("Derive(Deserializable): field has an unsupported array or generic type; only Int, Bool, String, or a nested @Derive(Deserializable) struct field are supported", at: target.syntax)
            }

            var conv: Syntax = quote { __kira_deser_int(__val#{idx}) }
            if field.type == "Bool" {
                conv = quote { __kira_deser_bool(__val#{idx}) }
            }
            if field.type == "String" {
                conv = quote { __kira_deser_unquote(__val#{idx}) }
            }
            if field.type == "Float" {
                Diagnostics.error("Derive(Deserializable): a Float field is not supported — there is no lossless Float parser, so derive Serializable only, or store the value as a String or an Int", at: target.syntax)
            }
            var isKnown: Bool = false
            if field.type == "Int" {
                isKnown = true
            }
            if field.type == "Bool" {
                isKnown = true
            }
            if field.type == "String" {
                isKnown = true
            }
            if field.type == "Float" {
                isKnown = true
            }
            if isKnown == false {
                conv = quote { deserialize_#{field.type.asSyntax()}(__val#{idx}) }
            }

            stmts.append(quote {
                let __rest#{idx}: String = s.substring(pos, s.count)
                let __eq#{idx}: Int = __rest#{idx}.indexOf("=")
                let __eqAt#{idx}: Int = pos + __eq#{idx}
                if s.substring(pos, __eqAt#{idx}) != #{field.name.asString()} {
                    pos = __kira_deser_trap(s)
                }
                pos = __eqAt#{idx} + 1
                let __end#{idx}: Int = __kira_deser_scan(s, pos)
                let __val#{idx}: String = s.substring(pos, __end#{idx})
                let #{field.name}: #{field.type.asSyntax()} = #{conv}
                pos = __end#{idx}
            })

            if idx < total - 1 {
                stmts.append(quote {
                    if s.charAt(pos) != 59 {
                        pos = __kira_deser_trap(s)
                    }
                    pos = pos + 1
                })
            }

            inits.append(quote { #{field.name}: #{field.name} })
            idx = idx + 1
        }

        stmts.append(quote {
            if s.charAt(pos) != 125 {
                pos = __kira_deser_trap(s)
            }
        })

        return quote {
            function deserialize_#{target.name}(s: borrow String) -> #{target.name} {
                #{stmts}
                return #{target.name} {
                    #{Syntax.join(inits, ", ")}
                }
            }
        }
    }
}
