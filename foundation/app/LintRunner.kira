// Foundation's lint runner: the `collector` macro that reads a package's
// `Lint` entries and checks the package against them.
//
// A collector runs once for the whole program. Every other macro form is
// attached to the declaration or call it rewrites, so none of them can ask
// what a program *contains*. It is handed every declaration in the program,
// which is both halves of a lint run at
// once: the `Lint` entries a `linter.kira` wrote, and the code they judge.
//
// Nothing here is privileged. The selection is `d.family == "Lint"` — a string
// compare against the family a declaration was written in — so a library could
// declare its own family and its own runner with no change to the compiler.
//
// # What a lint may look at
//
// Reflection hands a declaration its name, its family, its fields — each with a
// name, a written type, an initializer and its annotations — and the source
// text of the whole thing, which a lint may search with the same `contains` /
// `startsWith` / `split` a program has.
//
// It also hands over a declaration's *body* — the statements inside it, each
// with its kind, the expression it branches on, and the statements nested in
// turn — so a lint about what a function does is a walk rather than a guess at
// text. What is still missing is expression structure: a lint can read what a
// condition says, not take it apart.
//
// A collector must return syntax; a lint generates nothing, so this returns an
// empty `quote`, which is appended to no file.

comptime macro LintRunner {
    kind { collector }
    expand(declarations: [Declaration]) -> Syntax {
        // Only when a verb asked. A lint runs during expansion, so without
        // this gate every `check`, `run` and `build` would pay for the whole
        // pass and report findings nobody asked to see.
        if !Build.linting() {
            return quote { }
        }
        // The configuration: a built-in level per lint, moved by whatever the
        // package said.
        //
        // Every lint has a level before a `linter.kira` exists, so `kira lint`
        // in a package that configured nothing runs the standard set. It used
        // to run nothing at all, and printed `ok` while doing it.
        //
        // Three layers, each overriding the one before: the built-in default,
        // a `LintDefaults` entry moving all of them, then a `Lint` entry
        // moving one. Entries are matched by their `code`, never by the
        // declaration's name — a name is a label for whoever reads the file,
        // and matching on it meant renaming an entry turned its lint off.
        var qualifiedLevel: LintLevel = .Allow
        var indexLoopLevel: LintLevel = .Warn
        // Restriction: a line ceiling is a policy a project chooses, not a
        // defect. Off unless asked for by group or named outright.
        var fileLengthLevel: LintLevel = .Allow
        // Which groups this run asks for.
        //
        // A lint belongs to a group, and a group decides whether it is asked at
        // all — separately from the level, which decides what a finding costs.
        // The default set is everything except pedantry and policy, which is
        // what makes `kira lint` worth running in a package that configured
        // nothing.
        var askPedantic: Bool = false
        var askRestriction: Bool = false
        for entry in declarations {
            if entry.family == "LintDefaults" {
                for member in entry.fields {
                    if member.name.asString() == "groups" {
                        // The cases as written. A member's value reaches a
                        // macro as its source text, so the list is matched by
                        // the case names in it rather than compared as values —
                        // the one place text is unavoidable, and it is a
                        // boundary rather than a representation.
                        let asked = String(member.initializer)
                        if asked.contains("Pedantic") {
                            askPedantic = true
                        }
                        if asked.contains("Restriction") {
                            askRestriction = true
                        }
                    }
                }
            }
        }

        // Allowed by default, which is not where a finished lint sits.
        //
        // It is right about what it finds and cannot yet tell generated code
        // from written code: a `quote { function name() -> Int { return #{n} } }`
        // reaches the runner as an ordinary declaration carrying the macro's
        // own path, so thirteen of the seventeen it finds in the kik harness
        // are macro output nobody can rewrite. On by default, that is thirteen
        // warnings a reader cannot act on, which is how a lint teaches people
        // to ignore lints.
        //
        // Opt in with a `Lint` entry until a generated declaration can be told
        // apart from a written one.
        var constantFunctionLevel: LintLevel = .Allow
        // Whether a `Lint` entry named these outright, which beats a group.
        var fileLengthNamed: Bool = false
        var constantFunctionNamed: Bool = false
        // 700 is the ceiling every Kira repo here writes to, and a lint that
        // needed the number spelled in every `linter.kira` would drift between
        // packages. An entry's `limit` overrides it; leaving it out takes this.
        var fileLengthLimit: Int = 700

        // A package-wide default first, so a per-lint entry can still move one
        // back out of it.
        for entry in declarations {
            if entry.family == "LintDefaults" {
                for member in entry.fields {
                    if member.name.asString() == "level" {
                        let written = String(member.initializer)
                        var moved: LintLevel = .Warn
                        if written.contains("Allow") {
                            moved = .Allow
                        }
                        if written.contains("Deny") {
                            moved = .Deny
                        }
                        qualifiedLevel = moved
                        indexLoopLevel = moved
                        fileLengthLevel = moved
                        constantFunctionLevel = moved
                    }
                }
            }
        }

        for entry in declarations {
            if entry.family == "Lint" {
                var code: String = ""
                var level: LintLevel = .Warn
                var levelWritten: Bool = false
                var limit: Int = 0
                for member in entry.fields {
                    // An initializer arrives as the text it was written with,
                    // so a string's quotes are part of it and an enum case
                    // arrives as `.Warn` or `LintLevel.Warn`.
                    let written = String(member.initializer)
                    // Written as `.KLINT002` or `KiraError.KLINT002`, so the
                    // case name is what is matched. The quotes a string
                    // initializer carried are gone with the string.
                    if member.name.asString() == "code" {
                        for known in ["KLINT001", "KLINT002", "KLINT003", "KLINT004"] {
                            if written.contains(known) {
                                code = known
                            }
                        }
                    }
                    if member.name.asString() == "level" {
                        levelWritten = true
                        level = .Warn
                        if written.contains("Allow") {
                            level = .Allow
                        }
                        if written.contains("Deny") {
                            level = .Deny
                        }
                    }
                    if member.name.asString() == "limit" {
                        limit = Int(written)
                    }
                }
                if levelWritten {
                    if code == "KLINT003" {
                        fileLengthNamed = true
                    }
                    if code == "KLINT004" {
                        constantFunctionNamed = true
                    }
                    if code == "KLINT001" {
                        qualifiedLevel = level
                    }
                    if code == "KLINT002" {
                        indexLoopLevel = level
                    }
                    if code == "KLINT003" {
                        fileLengthLevel = level
                    }
                    if code == "KLINT004" {
                        constantFunctionLevel = level
                    }
                }
                if code == "KLINT003" && limit > 0 {
                    fileLengthLimit = limit
                }
            }
        }

        let qualifiedOn: Bool = qualifiedLevel != .Allow
        let indexLoopOn: Bool = indexLoopLevel != .Allow
        let fileLengthOn: Bool = fileLengthLevel != .Allow
        // A group turns its lints on where nothing named them. An entry that
        // named one still wins, in either direction: asking for pedantry does
        // not override a package that allowed this one by hand.
        if askPedantic && constantFunctionNamed == false {
            constantFunctionLevel = .Warn
        }
        if askRestriction && fileLengthNamed == false {
            fileLengthLevel = .Warn
        }
        let constantFunctionOn: Bool = constantFunctionLevel != .Allow

        // KLINT000 — the receipt. Always emitted, before any lint runs.
        //
        // Silence has two meanings and they are opposites: "every lint ran and
        // found nothing" and "no lint ran at all". A reader cannot tell them
        // apart, and the second one has already been mistaken for the first in
        // this repo — a runner that failed to evaluate reported nothing, under a
        // printed `ok`. So the runner says how many lints it ran, every time,
        // and `kira lint` refuses to call a run clean without this. It is not a
        // finding, so the verb consumes it rather than printing it.
        var enabled: Int = 0
        if qualifiedOn {
            enabled = enabled + 1
        }
        if constantFunctionOn {
            enabled = enabled + 1
        }
        if indexLoopOn {
            enabled = enabled + 1
        }
        if fileLengthOn {
            enabled = enabled + 1
        }
        Diagnostics.note("{\"lintsRan\":" + String(enabled) + "}", code: "KLINT000")

        // KLINT001 — an enum variant written with the type it already belongs
        // to.
        //
        // `material: FoundationMaterial.LiquidGlass` names the type twice: once
        // in the parameter's declaration and again at the call. Kira resolves a
        // leading dot against the expected type — `.LiquidGlass` — and compiles
        // `c == .Red` to a tag compare with no throwaway enum, so the qualified
        // spelling is longer and does more work.
        //
        // Found by searching a declaration's own text for `<EnumName>.`, where
        // the enum names are the ones this very program declares — which is why
        // this has to be a collector: no other macro form is handed the whole
        // program, and without that the lint would not know which names are
        // enums.
        //
        // The enum names are gathered in their own pass first. Asking "is this
        // one an enum" inside the inner loop walked every declaration in the
        // *program* — Foundation and every library included — once per
        // declaration, and a real package has thousands: the run took minutes
        // on a tree-walking evaluator. Gathering first makes the inner loop as
        // long as the enum list rather than as long as the program.
        var enumNames: [String] = []
        if qualifiedOn {
            for declared in declarations {
                if declared.kind == .Enum {
                    enumNames.append(declared.name.asString())
                }
            }
        }
        if qualifiedOn {
            for target in declarations {
                if target.family == "Lint" {
                    continue
                }
                for name in enumNames {
                    let qualified = name + "."
                    // A declaration mentioning its own name is declaring it,
                    // not qualifying a variant with it.
                    if target.name.asString() == name {
                        continue
                    }
                    if target.syntax.contains(qualified) {
                        let message = "`" + qualified +
                            "…` names the enum a leading dot already resolves to"
                        if qualifiedLevel == .Deny {
                            Diagnostics.error(message, at: target.syntax, code: "KLINT001")
                        }
                        if qualifiedLevel != .Deny {
                            Diagnostics.warning(message, at: target.syntax, code: "KLINT001")
                        }
                    }
                }
            }
        }

        // KLINT002 — a `while` counting an index by hand.
        //
        // `while i < xs.count { … i = i + 1 }` is a `for` written the long way,
        // and the long way is where an off-by-one lives.
        //
        // Reported only when the rewrite is actually safe, which is three
        // questions a text search cannot answer:
        //
        //   * does the body grow or shrink the collection? A `for` reads its
        //     bound once and a `while` re-reads it, so those differ;
        //   * does the body `continue`? That skips a manual step but not a
        //     `for`'s, so converting changes behaviour;
        //   * is the counter read after the loop? Then it cannot become the
        //     loop's own binding.
        //
        // All three need the body's *shape* — which statement is last, what is
        // nested, what comes after — so this lint is why declarations carry a
        // structured body at all.
        //
        // Every statement of the declaration is judged, nested blocks included,
        // and each candidate is judged on its own, so two manual loops share
        // neither a report nor a run: a walk that stopped at the first finding,
        // or at the body's top level, made `kira lint --fix` surface them one
        // run at a time.
        if indexLoopOn {
            for target in declarations {
                if target.family == "Lint" {
                    continue
                }
                // `@Allow(KLINT002)` above the declaration turns this lint off
                // for it alone.
                //
                // Some code is the exception the lint is written to find and is
                // right anyway: a test *about* `while` has to keep its `while`,
                // and without a per-site allow the only way to keep it is to
                // turn the check off for the whole package. One site should not
                // cost the other fifteen hundred.
                var allowedHere: Bool = false
                for annotation in target.annotations {
                    if annotation.contains("Allow") && annotation.contains("KLINT002") {
                        allowedHere = true
                    }
                }
                if allowedHere {
                    continue
                }
                // Bound once: reading `target.body` re-parses the declaration,
                // and this walk looks at every statement twice.
                let body = target.body
                // The whole declaration flattened once, breadth after breadth:
                // `stmts` holds every statement, `afters` the text written
                // after it — its later siblings plus everything that follows
                // every enclosing block — and `prevs` the sibling directly
                // above it, which is where the counter's initializer lives.
                var stmts: [Statement] = []
                var afters: [String] = []
                var prevs: [String] = []
                var above: [Statement] = []
                var suffix: String = ""
                var k = body.count
                while k > 0 {
                    k = k - 1
                    let statement = body[k]
                    var prev: String = ""
                    var prevAt = statement
                    if k > 0 {
                        let before = k - 1
                        let sibling = body[before]
                        prev = String(sibling.syntax)
                        prevAt = sibling
                    }
                    stmts.append(statement)
                    afters.append(suffix)
                    prevs.append(prev)
                    above.append(prevAt)
                    suffix = suffix + String(statement.syntax) + " "
                }
                // Expanding and judging share one pass: each entry hands its
                // children their own tail of what comes after, so a nested
                // loop is tested against the rest of the declaration, not just
                // the block that holds it.
                var i = 0
                while i < stmts.count {
                    let statement = stmts[i]
                    let after = afters[i]
                    let prev = prevs[i]
                    let prevAt = above[i]
                    // Advance before anything else: every guard below skips to
                    // the next entry, and a step left for the loop's tail would
                    // be skipped with them.
                    i = i + 1
                    let kids = statement.body
                    var innerSuffix = after
                    var j = kids.count
                    while j > 0 {
                        j = j - 1
                        let child = kids[j]
                        var childPrev: String = ""
                        var childPrevAt = child
                        if j > 0 {
                            let childAbove = kids[j - 1]
                            childPrev = String(childAbove.syntax)
                            childPrevAt = childAbove
                        }
                        stmts.append(child)
                        afters.append(innerSuffix)
                        prevs.append(childPrev)
                        above.append(childPrevAt)
                        innerSuffix = innerSuffix + String(child.syntax) + " "
                    }
                    if statement.kind != "while" {
                        continue
                    }
                    // A compound condition is not a `for`: the extra test is
                    // an early exit, and a range loop has none.
                    var compound: Bool = false
                    if statement.head.contains("&&") {
                        compound = true
                    }
                    if statement.head.contains("||") {
                        compound = true
                    }
                    if compound {
                        continue
                    }
                    var counter: String = ""
                    var bound: String = ""
                    for piece in statement.head.split(" < ") {
                        if counter == "" {
                            counter = piece
                        }
                        bound = piece
                    }
                    // The bound has to be the same on every turn, because a
                    // `for` reads it once where a `while` re-reads it.
                    //
                    // A `.count` qualifies when the body leaves the collection
                    // alone, which the `mutates` check below settles. A literal
                    // qualifies always: it cannot change. Anything else — a
                    // variable, a call — might change under the loop, so it is
                    // left alone rather than guessed at.
                    //
                    // Only `.count` used to qualify, which is why a counted
                    // loop over a fixed number was never reported.
                    var boundIsFixed: Bool = bound.contains(".count")
                    if boundIsFixed == false && bound != "" {
                        var allDigits: Bool = true
                        for character in bound.split("") {
                            if character != "" && "0123456789".contains(character) == false {
                                allDigits = false
                            }
                        }
                        boundIsFixed = allDigits
                    }
                    if boundIsFixed == false {
                        continue
                    }
                    var last: String = ""
                    if kids.count > 0 {
                        let lastAt = kids.count - 1
                        last = String(kids[lastAt].syntax)
                    }
                    // The whole subtree, however deep: a `continue` two blocks
                    // down skips the manual step exactly as much as one right
                    // inside the loop.
                    var jumps: Bool = false
                    var mutates: Bool = false
                    var scan = statement.body
                    var s = 0
                    while s < scan.count {
                        let node = scan[s]
                        if node.kind == "continue" {
                            jumps = true
                        }
                        if node.syntax.contains(".append(") {
                            mutates = true
                        }
                        for deeper in node.body {
                            scan.append(deeper)
                        }
                        s = s + 1
                    }
                    if last.contains(" + 1") == false {
                        continue
                    }
                    if jumps {
                        continue
                    }
                    if mutates {
                        continue
                    }
                    // The `var i = 0` sits directly above; span both so the fix
                    // can collapse them into one `for`.
                    if prev.contains("var " + counter + " = 0") == false {
                        continue
                    }
                    // After the loop: is the counter named again? Then it cannot
                    // become the loop's own binding. Matched one whole word at
                    // a time rather than by substring — `return` holds an `r`
                    // and `.count` holds a `u`, and neither of those reads the
                    // counter — but a substring hit never reported, so a word
                    // match keeps every report the old test kept.
                    var usedAfter: Bool = false
                    if counter == "" {
                        usedAfter = true
                    }
                    var words: [String] = [after]
                    for mark in ["\n", "\t", "\"", "'", "{", "}", "(", ")", "[", "]", "<", ">", "+", "-", "*", "/", "=", "&", "|", "!", ",", ";", ":", ".", "?", "%", "@", "#"] {
                        var pieces: [String] = []
                        for piece in words {
                            for part in piece.split(mark) {
                                pieces.append(part)
                            }
                        }
                        words = pieces
                    }
                    for word in words {
                        if word == counter {
                            usedAfter = true
                        }
                    }
                    if usedAfter {
                        continue
                    }
                    let reportAt = prevAt.through(statement)
                    // The replacement is the run itself, edited line by line:
                    // the counter's declaration and the hand-written step are
                    // whole lines and go with their indentation, and the
                    // `while` header becomes the `for`. The first surviving
                    // line is trimmed because the replacement lands at the
                    // declaration's own column; every later line keeps the
                    // absolute indentation it was written with.
                    var fixText = ""
                    var firstKept = true
                    for line in String(reportAt).split("\n") {
                        let content = line.trim()
                        if content == "var " + counter + " = 0" {
                            continue
                        }
                        if content == counter + " = " + counter + " + 1" {
                            continue
                        }
                        let kept = line.replace(
                            "while " + counter + " < " + bound + " {",
                            "for " + counter + " in 0.." + bound + " {"
                        )
                        if firstKept {
                            firstKept = false
                            fixText = kept.trim()
                        } else {
                            fixText = fixText + "\n" + kept
                        }
                    }
                    let indexLoopMessage: String = "this `while` counts an index by hand; `for " +
                        counter + " in 0.." + bound +
                        "` does it for you, and the counter is not read after the loop"
                    // Emitted at the level the package asked for, like every
                    // other lint. This one always warned, so a `linter.kira`
                    // that denied it got a warning and a build that passed.
                    if indexLoopLevel == .Deny {
                        Diagnostics.error(
                            indexLoopMessage,
                            at: reportAt,
                            code: "KLINT002",
                            fix: fixText
                        )
                    } else {
                        Diagnostics.warning(
                            indexLoopMessage,
                            at: reportAt,
                            code: "KLINT002",
                            fix: fixText
                        )
                    }
                }
            }
        }

        // KLINT004 — a zero-argument function returning a literal.
        //
        // `function limit() -> Int { return 700 }` is a constant written as a
        // call. Kira has module-scope `let`, so it can be one: `let limit = 700`
        // reads as the value it is, costs no call, and cannot be confused with
        // something that computes.
        //
        // The shape is narrow on purpose, because everything outside it might
        // do something:
        //
        //   * zero parameters, read off the head — a function taking anything
        //     is not a constant;
        //   * exactly one statement, and it a `return` — a body that branches
        //     or binds is a body;
        //   * the returned text a literal, not a name or a call. `return 700`
        //     and `return "ok"` qualify; `return other()` and `return LIMIT`
        //     do not, because what they read might change and a `let` would
        //     fix the order they are read in.
        //
        // Annotated declarations are left alone entirely. `@Native`,
        // `@FFI.Syscall` and `@Main` all mean the function is reached by
        // something other than a Kira call, and `packages/linux` is written
        // exactly this way — `@Native function linuxMountReadOnly() -> Int {
        // return 1 }` is a constant to a reader and a symbol to the runtime.
        // Rewriting one would take the symbol away.
        if constantFunctionOn {
            for target in declarations {
                if target.kind != .Function {
                    continue
                }
                var annotated: Bool = false
                var allowedHere: Bool = false
                for annotation in target.annotations {
                    annotated = true
                    if annotation.contains("Allow") && annotation.contains("KLINT004") {
                        allowedHere = true
                    }
                }
                if annotated || allowedHere {
                    continue
                }
                let head: String = String(target.syntax)
                // Zero parameters: the head reaches `()` before its body.
                var signature: String = ""
                for piece in head.split("{") {
                    if signature == "" {
                        signature = piece
                    }
                }
                if signature.contains("()") == false {
                    continue
                }
                let body = target.body
                if body.count != 1 {
                    continue
                }
                let only = body[0]
                if only.kind != "return" {
                    continue
                }
                var returned: String = String(only.syntax)
                for piece in returned.split("return ") {
                    returned = piece
                }
                returned = returned.trim()
                // A literal and nothing else. Digits, a quoted string, or one
                // of the two boolean words — anything naming something is left
                // alone, because a `let` would decide when it is read.
                var isLiteral: Bool = returned == "true" || returned == "false"
                if returned.startsWith("\"") && returned.endsWith("\"") {
                    isLiteral = true
                }
                // A number is recognised by what it starts with. A literal
                // opens with a digit or a minus; a name never does, and a call
                // or a collection opens with something else again. Read this
                // way rather than by walking the characters, which the
                // evaluator cannot do, or by `Int(text)`, which refuses a
                // non-number outright rather than answering that it is not one.
                if returned != "" && isLiteral == false {
                    let first: String = returned.substring(0, 1)
                    isLiteral = "0123456789-".contains(first)
                }
                // An enum case is a constant too, in both spellings. `.Red`
                // is unambiguous — nothing else opens with a dot. `Colour.Red`
                // is read as one when what precedes the dot is capitalised,
                // which is how Kira spells a type: `config.retries` is a field
                // of something and might be anything, and is left alone.
                if isLiteral == false && returned != "" {
                    let opener: String = returned.substring(0, 1)
                    if opener == "." {
                        isLiteral = true
                    }
                    if "ABCDEFGHIJKLMNOPQRSTUVWXYZ".contains(opener) && returned.contains(".") {
                        isLiteral = true
                    }
                }
                // Nothing that reaches for anything else, whatever it starts
                // with: a call, an index, or a constructed value is not a
                // literal even when it begins with a digit or names a type.
                //
                // `U8(3)` is excluded with them, and is the one exclusion worth
                // naming: it *is* a constant, and a `let` would hold it. There
                // is nothing in the text that tells a conversion from any other
                // call, so admitting it would admit `readConfig()` beside it.
                if returned.contains("(") || returned.contains("[") || returned.contains("{") {
                    isLiteral = false
                }
                if isLiteral == false {
                    continue
                }
                let name: String = String(target.name.asString())
                let constantMessage: String = "`" + name +
                    "` takes nothing and returns a literal; `let " + name + " = " + returned +
                    "` says the same thing as a value"
                if constantFunctionLevel == .Deny {
                    Diagnostics.error(constantMessage, at: target.syntax, code: "KLINT004")
                } else {
                    Diagnostics.warning(constantMessage, at: target.syntax, code: "KLINT004")
                }
            }
        }

        // KLINT003 — a file past the line ceiling.
        //
        // Size is the one property of a file a lint can judge without reading
        // any of it, and the one a reviewer notices last: nothing about a
        // 1400-line file fails to compile, so it grows until somebody measures.
        //
        // Reported once per file, on the LAST declaration in it — the one the
        // file grew past the ceiling to hold, and the natural place to cut. A
        // declaration re-scanned from detached text belongs to no file and
        // reports `0` for both numbers, so it is skipped rather than counted as
        // a zero-line file.
        //
        // "Last in its file" is read off the order rather than searched for.
        // Declarations arrive grouped by file, in file order, so the last one
        // of a file is whichever sits immediately before the file changes —
        // one pass, carrying the previous. Searching each declaration for a
        // later sibling instead walked the whole program once per declaration,
        // which is minutes on a real package.
        //
        // No `fix:`. Where to cut a long file is a judgement about what belongs
        // together, and a lint that guessed would move code by line count.
        //
        // The report is written twice rather than through a helper: an `expand`
        // body runs on the compile-time evaluator, which calls no ordinary Kira
        // function.
        if fileLengthOn {
            var pendingFile: Int = -1
            var pendingLines: Int = 0
            var pendingAt: Syntax = quote { }
            for target in declarations {
                // Generated bindings are exempt, always. A `bindings/`
                // directory holds machine-written code — a file per foreign
                // API, as long as that API is — and measuring it says nothing
                // about how the package is organized: nobody reads it, nobody
                // splits it, and the generator would put it straight back.
                // Exempt here rather than through a per-package setting because
                // it is true of every package that has one.
                //
                // Matched on a separator-normalized copy: Windows hands these
                // paths over as `app\bindings\foreign.kira`, so testing for
                // "/bindings/" alone exempted nothing there and every generated
                // binding was measured — a 27,000-line Vulkan binding reported
                // as a file to split.
                if target.path.replace("\\", "/").contains("/bindings/") {
                    continue
                }
                if target.fileId != pendingFile {
                    if pendingLines > fileLengthLimit {
                        let message = "this file is " + String(pendingLines) +
                            " lines, past the " + String(fileLengthLimit) +
                            "-line ceiling; split it into cohesive modules"
                        if fileLengthLevel == .Deny {
                            Diagnostics.error(message, at: pendingAt, code: "KLINT003")
                        }
                        if fileLengthLevel != .Deny {
                            Diagnostics.warning(message, at: pendingAt, code: "KLINT003")
                        }
                    }
                    pendingFile = target.fileId
                }
                pendingLines = target.fileLines
                pendingAt = target.syntax
            }
            // The final file has no successor to notice the change.
            if pendingLines > fileLengthLimit {
                let message = "this file is " + String(pendingLines) +
                    " lines, past the " + String(fileLengthLimit) +
                    "-line ceiling; split it into cohesive modules"
                if fileLengthLevel == .Deny {
                    Diagnostics.error(message, at: pendingAt, code: "KLINT003")
                }
                if fileLengthLevel != .Deny {
                    Diagnostics.warning(message, at: pendingAt, code: "KLINT003")
                }
            }
        }

        return quote { }
    }
}
