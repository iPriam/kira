// Foundation's test vocabulary: the `Test` construct family a suite is written
// in, and the value types a runner answers with.
//
// A test case is a declaration backed by `Test`, providing the two members the
// family requires — what the case does, and what it should come to:
//
//     Test SumsToTen {
//         test { return add(4, 6) }
//         expect { let e: Result<Int, TestFailure> = .Ok(10); return e }
//     }
//
// `Test` is an ordinary construct family declared here in Kira. The compiler
// knows nothing about the name: it sees one construct family among any others a
// library could declare, and every rule that shapes a case is a rule of the
// construct surface.
//
// Each requirement writes its result type, and `Any` is what makes that
// possible: cases answer with whatever they measure — an `Int` here, a `String`
// there — and the top type names exactly that. A `test { … }` member therefore
// returns `Any`, and an `expect { … }` member a `Result<Any, TestFailure>`,
// which is the shape a runner reads without the family having to know what any
// one case measures. See `docs/foundation.md`.

// One case's outcome: what it was called, and whether it held.
struct TestResult {
    let name: String
    let passed: Bool
}

// A whole run's tally.
struct TestReport {
    let passed: Int
    let failed: Int
    let total: Int
}

// Whether a case held.
enum TestStatus {
    Passed
    Failed
}

// Why a case did not hold.
//
// The three are the three places a case can come apart: the program ran and
// answered wrongly, the compiler refused it, or the build never produced
// anything to run.
enum TestFailure {
    Runtime(String)
    Diagnostic(KiraError)
    Compile(String)
}

// The reporting seam a runner drives a suite through.
struct TestRuntime {
    // Records one case's outcome under the name it was declared with.
    function report(name: borrow String, passed: Bool) -> TestResult {
        return TestResult(name: name, passed: passed)
    }
}

// A test case: what it does, and what it should come to.
construct Test {
    @Required function test() -> Any
    @Required function expect() -> Result<Any, TestFailure>
}
