// The operating system a build targets, as a typed value chosen at compile time.
//
// `Build.platform()` already answers which OS a build is aimed at, but it answers
// with a String, so every reader compares spelling and a typo compares false in
// silence. `TargetPlatform` is the enum form: a `match` over it is exhaustive,
// and a platform the program forgot is a missing arm the compiler names.
//
// The name carries the `Target` because Foundation is merged into every package,
// so a bare `Platform` would collide with the one a graphics or UI library means
// by the word. This is the platform a build is *for*, which is the distinction
// `Build.platform()` was introduced to make.
//
// `targetPlatform!()` folds to the target's case during macro expansion, off the
// same `Build.platform()` the syscall table refuses declarations by. Because the
// fold happens before the program is analyzed, it is the case for the machine
// being built for — a Mac cross-building aarch64-linux gets `.Linux`, not
// `.MacOS` — and the cases it is not never reach the program.
enum TargetPlatform {
    Linux
    MacOS
    Windows
    Ios
    Wasm
    Unknown
}

comptime macro targetPlatform {
    kind { function }
    expand(input: Syntax) -> Syntax {
        let _ = input
        let os = Build.platform()
        if os == "linux" {
            return quote { TargetPlatform.Linux }
        }
        if os == "macos" {
            return quote { TargetPlatform.MacOS }
        }
        if os == "windows" {
            return quote { TargetPlatform.Windows }
        }
        if os == "ios" {
            return quote { TargetPlatform.Ios }
        }
        if os == "emscripten" {
            return quote { TargetPlatform.Wasm }
        }
        return quote { TargetPlatform.Unknown }
    }
}
