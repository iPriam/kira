// Structs: stored members with defaults, field reads and writes, nesting, and
// the value semantics that make a copy independent of what it was copied from.
struct Vec3 {
    var x: Int
    var y: Int
    var z: Int
}

struct Box {
    var origin: Vec3
    var label: String = "unnamed"
    var count: Int = 0
}

function sum(v: borrow Vec3) -> Int {
    return v.x + v.y + v.z
}

function scaled(v: borrow Vec3, k: Int) -> Vec3 {
    return Vec3 { x = v.x * k, y = v.y * k, z = v.z * k }
}

@Main
function main() {
    let v = Vec3 { x = 1, y = 2, z = 3 }
    print(sum(v))
    print(sum(scaled(v, 10)))

    // A field the literal omits takes its declared default.
    var b = Box { origin = v }
    print(b.label)
    print(b.count)

    // A nested field is written in place, however deep it sits.
    b.origin.x = 100
    print(sum(b.origin))

    // A struct is a value: copying one and writing to the copy leaves the
    // original alone, strings included.
    var copy = b
    copy.label = "renamed"
    print(b.label)
    print(copy.label)
    return
}
