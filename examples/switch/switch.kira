// switch: dispatch on a subject, compared to each case label with `==`.
@Main
function main() {
    // The first matching arm runs; `default` catches the rest. There is no
    // fallthrough, so nothing after the matching arm runs.
    for i in 0..4 {
        var name = "?"
        switch i % 3 {
            case 0 { name = "zero" }
            case 1 { name = "one" }
            case 2 { name = "two" }
            default { name = "other" }
        }
        print(name)
    }

    // A label may be any type `==` accepts against the subject. The `:` after
    // a label is optional.
    var kind = 0
    switch "beta" {
        case "alpha": { kind = 1 }
        case "beta": { kind = 2 }
        default: { kind = 9 }
    }
    print(kind)

    switch 2 > 1 {
        case true { print("yes") }
        default { print("no") }
    }

    // No `default` and no match: the switch does nothing. A switch is not
    // checked for exhaustiveness.
    var untouched = 7
    switch 99 {
        case 1 { untouched = 1 }
        case 2 { untouched = 2 }
    }
    print(untouched)

    // A `break` in an arm belongs to the enclosing loop: a switch is not a
    // loop, so there is nothing for it to break out of here but the `for`.
    var seen = 0
    for i in 0..10 {
        switch i {
            case 3 { break }
            default { seen = seen + 1 }
        }
    }
    print(seen)
    return
}
