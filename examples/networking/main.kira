// Every operation below is started from an async body and joined through Kira's
// cooperative Task scheduler. The native functions only schedule Tokio work;
// they never block the Kira task while a socket is doing I/O.

import Foundation

@FFI.Extern { library: kira_network, symbol: kira_network_http1_server, abi: c }
function http1Server() -> Int
@FFI.Extern { library: kira_network, symbol: kira_network_http1_client, abi: c }
function http1Client(port: U16) -> Int

@FFI.Extern { library: kira_network, symbol: kira_network_http2_server, abi: c }
function http2Server() -> Int
@FFI.Extern { library: kira_network, symbol: kira_network_http2_client, abi: c }
function http2Client(port: U16) -> Int

@FFI.Extern { library: kira_network, symbol: kira_network_http3_server, abi: c }
function http3Server() -> Int
@FFI.Extern { library: kira_network, symbol: kira_network_http3_client, abi: c }
function http3Client(port: U16) -> Int

@FFI.Extern { library: kira_network, symbol: kira_network_websocket_server, abi: c }
function websocketServer() -> Int
@FFI.Extern { library: kira_network, symbol: kira_network_websocket_client, abi: c }
function websocketClient(port: U16) -> Int

@FFI.Extern { library: kira_network, symbol: kira_network_io_roundtrip, abi: c }
function ioRoundtrip() -> Int

@FFI.Extern { library: kira_network, symbol: kira_network_server_port, abi: c }
function serverPort(handle: Int) -> Int
@FFI.Extern { library: kira_network, symbol: kira_network_poll, abi: c }
function networkPoll(handle: Int) -> I32
@FFI.Extern { library: kira_network, symbol: kira_network_result, abi: c }
function networkResult(handle: Int) -> Int
@FFI.Extern { library: kira_network, symbol: kira_network_close, abi: c }
function networkClose(handle: Int)
@FFI.Extern { library: kira_network, symbol: kira_network_cancel, abi: c }
function networkCancel(handle: Int)

@FFI.Extern { library: kira_network, symbol: kira_network_https_server, abi: c }
function httpsServer() -> Int

// A request is assembled against a handle and then sent. Every part crosses as
// a `CString`, which is the one direction text moves at a C boundary: Kira
// copies its `String` out NUL-terminated for the length of the call.
@FFI.Extern { library: kira_network, symbol: kira_network_request_new, abi: c }
function requestNew(method: CString, url: CString) -> Int
@FFI.Extern { library: kira_network, symbol: kira_network_request_header, abi: c }
function requestHeader(request: Int, name: CString, value: CString) -> Int
@FFI.Extern { library: kira_network, symbol: kira_network_request_body_text, abi: c }
function requestBodyText(request: Int, text: CString) -> Int
@FFI.Extern { library: kira_network, symbol: kira_network_request_version, abi: c }
function requestVersion(request: Int, version: I32) -> Int
@FFI.Extern { library: kira_network, symbol: kira_network_request_trust_loopback, abi: c }
function requestTrustLoopback(request: Int, port: U16) -> Int
@FFI.Extern { library: kira_network, symbol: kira_network_request_timeout_ms, abi: c }
function requestTimeoutMs(request: Int, milliseconds: Int) -> Int
@FFI.Extern { library: kira_network, symbol: kira_network_request_send, abi: c }
function requestSend(request: Int) -> Int
@FFI.Extern { library: kira_network, symbol: kira_network_request_discard, abi: c }
function requestDiscard(request: Int)

@FFI.Extern { library: kira_network, symbol: kira_network_response_status, abi: c }
function responseStatus(handle: Int) -> Int
@FFI.Extern { library: kira_network, symbol: kira_network_response_select_body, abi: c }
function responseSelectBody(handle: Int) -> Int
@FFI.Extern { library: kira_network, symbol: kira_network_response_read_scalar, abi: c }
function responseReadScalar(handle: Int) -> Int

// Polling is a Kira yield point, so the Kira scheduler keeps driving sibling
// protocol tasks while Tokio completes the actual socket future.
function waitOperation(handle: Int) -> Int {
    if handle <= 0 {
        return handle
    }
    var state = networkPoll(handle)
    while state == 0 {
        taskYield()
        state = networkPoll(handle)
    }
    let value = networkResult(handle)
    networkClose(handle)
    return value
}

// How long any request in this example may take before it is abandoned.
//
// Generous, because it is not a performance bound: it is the difference between
// a peer that stops answering and a program that never finishes. Every request
// here talks to a loopback server started three lines earlier, so reaching this
// at all means something is wrong rather than slow.
function requestDeadlineMs() -> Int {
    return 30000
}

// Waits without releasing the handle, for a request whose response is read from
// that same handle after it completes.
//
// The deadline is the library's, set on the request before it is sent, so a
// peer that sends headers and then stops still completes this operation with a
// timeout rather than leaving it pending. Without one this loop yields forever:
// `networkPoll` answers 0 for as long as nothing has arrived, and nothing ever
// arriving is exactly the case a timeout exists for.
function waitResponse(handle: Int) -> Int {
    if handle <= 0 {
        return handle
    }
    var state = networkPoll(handle)
    while state == 0 {
        taskYield()
        state = networkPoll(handle)
    }
    return networkResult(handle)
}

// The response arrives one Unicode scalar at a time, because a C function
// returning `int64_t` has no way to hand back owned text; `scalarText` turns
// each code point into the `String` this builds.
function responseText(handle: Int) -> String {
    var text = ""
    var scalar = responseReadScalar(handle)
    while scalar >= 0 {
        text = text + scalarText(scalar)
        scalar = responseReadScalar(handle)
    }
    return text
}

async function runHttp1() -> Int {
    let server = http1Server()
    if server <= 0 {
        return server
    }
    let port = serverPort(server)
    if port <= 0 {
        networkClose(server)
        return port
    }
    let client = http1Client(U16(port))
    if client <= 0 {
        networkClose(server)
        return client
    }
    let clientResult = waitOperation(client)
    if clientResult <= 0 {
        networkClose(server)
        return clientResult
    }
    return clientResult + waitOperation(server)
}

async function runHttp2() -> Int {
    let server = http2Server()
    if server <= 0 {
        return server
