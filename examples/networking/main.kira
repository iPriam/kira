async function runWebsocket() -> Int {
    let server = websocketServer()
    if server <= 0 {
        return server
    }
    let port = serverPort(server)
    if port <= 0 {
        networkClose(server)
        return port
    }
    let client = websocketClient(U16(port))
    if client <= 0 {
        networkClose(server)
        return client
    }
    let clientResult = waitOperation(client)
    if clientResult <= 0 {
        networkClose(server)
        return clientResult
    }
    return clientResult + waitOperation(server)
}

async function runIo() -> Int {
    return waitOperation(ioRoundtrip())
}

async function runCancellation() -> Int {
    let handle = ioRoundtrip()
    if handle <= 0 {
        return handle
    }
    networkCancel(handle)
    if networkPoll(handle) == -101 {
        return 1
    }
    return -1
}

// One real HTTPS request. TLS is verified, not skipped: the loopback server
// generates its certificate at startup, and `requestTrustLoopback` adds that one
// certificate to the public roots for this request. A request to a public
// service is the same code without that line.
async function runHttpsRequest() -> Int {
    let server = httpsServer()
    if server <= 0 {
        return server
    }
    let port = serverPort(server)
    if port <= 0 {
        networkClose(server)
        return port
    }
    let request = requestNew("POST", "https://127.0.0.1:" + String(port) + "/echo")
    if request <= 0 {
        networkClose(server)
        return request
    }
    // Every setter answers 0 or a negative error code, so one carried value
    // says whether the request is still whole. A request that is not gets
    // discarded rather than sent: it holds native storage until it is.
    var configured = requestTrustLoopback(request, U16(port))
    if configured >= 0 {
        configured = requestVersion(request, I32(2))
    }
    if configured >= 0 {
        configured = requestHeader(request, "x-kira-test", "carried")
    }
    if configured >= 0 {
        configured = requestBodyText(request, "{\"hello\":\"kira\"}")
    }
    if configured < 0 {
        requestDiscard(request)
        networkClose(server)
        return configured
    }
    requestTimeoutMs(request, requestDeadlineMs())
    let operation = requestSend(request)
    if operation <= 0 {
        networkClose(server)
        return operation
    }
    let status = waitResponse(operation)
    let reported = responseStatus(operation)
    let length = responseSelectBody(operation)
    let text = responseText(operation)
    networkClose(operation)
    networkClose(server)
    if status != 200 || reported != status || length <= 0 {
        return -1
    }
    // The server answers with a transcript of what arrived, so this checks the
    // method, the header and the body actually crossed rather than that some
    // 200 came back.
    if text.contains("method=POST") && text.contains("x-kira-test=carried")
        && text.contains("body={\"hello\":\"kira\"}") {
        return 1
    }
    return -1
}

// The same request, answered as JSON and read as JSON.
//
// This is the shape a program calling a service actually writes: the response
// is a document, not a transcript to search, so it goes to `parseJson` and the
// fields come out by name. Nothing here knows the body was a network response —
// `responseText` produced an ordinary `String`, and Foundation reads it.
async function runJsonRequest() -> Int {
    let server = httpsServer()
    if server <= 0 {
        return server
    }
    let port = serverPort(server)
    if port <= 0 {
        networkClose(server)
        return port
    }
    let request = requestNew("POST", "https://127.0.0.1:" + String(port) + "/json")
    if request <= 0 {
        networkClose(server)
        return request
    }
    var configured = requestTrustLoopback(request, U16(port))
    if configured >= 0 {
        configured = requestHeader(request, "x-kira-test", "carried")
    }
    if configured >= 0 {
        configured = requestBodyText(request, "{\"hello\":\"kira\"}")
    }
    if configured < 0 {
        requestDiscard(request)
        networkClose(server)
        return configured
    }
    requestTimeoutMs(request, requestDeadlineMs())
    let operation = requestSend(request)
    if operation <= 0 {
        networkClose(server)
        return operation
    }
    let status = waitResponse(operation)
    let length = responseSelectBody(operation)
    let text = responseText(operation)
    networkClose(operation)
    networkClose(server)
    if status != 200 || length <= 0 {
        return -1
    }
    match parseJson(text) {
        Ok(document) -> {
            if jsonText(jsonField(document, "method"), "") != "POST" {
                return -1
            }
            if jsonText(jsonField(document, "marker"), "") != "carried" {
                return -1
            }
            let body = jsonText(jsonField(document, "body"), "")
            if body != "{\"hello\":\"kira\"}" {
                return -1
            }
            // The server counted the bytes it received, so this agrees only if
            // the body crossed whole.
            if jsonInt(jsonField(document, "length"), 0 - 1) != body.count {
                return -1
            }
            return 1
        }
        Error(problem) -> return -1
    }
}

async function runAllNetworking() -> Int {
    let http1 = Task { runHttp1() }
    let http2 = Task { runHttp2() }
    let http3 = Task { runHttp3() }
    let websocket = Task { runWebsocket() }
    let io = Task { runIo() }
    let cancellation = Task { runCancellation() }
    let https = Task { runHttpsRequest() }
    let json = Task { runJsonRequest() }
    return http1.await + http2.await + http3.await + websocket.await + io.await + cancellation.await
        + https.await + json.await
}

@Main function main() {
    let all = Task { runAllNetworking() }
    print(all.await)
    return
}
