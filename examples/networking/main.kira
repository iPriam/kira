// Every operation below is started from an async body and joined through Kira's
// cooperative Task scheduler. The transport is Foundation's — the `kira_network`
// functions it binds only schedule the runtime's socket work and never block the
// Kira task while a socket is doing I/O — so this example declares no FFI of its
// own and carries no `NativeLibs`: `import Foundation` is the whole of it.

import Foundation

// Polling is a Kira yield point, so the Kira scheduler keeps driving sibling
// protocol tasks while Tokio completes the actual socket future.
function waitOperation(handle: Int) -> Int {
    if handle <= 0 {
        return handle
    }
    var state = kira_network_poll(handle)
    while state == 0 {
        taskYield()
        state = kira_network_poll(handle)
    }
    let value = kira_network_result(handle)
    networkClose(handle)
    return value
}

// How long any request in this example may take before it is abandoned.
//
// Generous, because it is not a performance bound: it is the difference between
// a peer that stops answering and a program that never finishes. Every request
// here talks to a loopback server started three lines earlier, so reaching this
// at all means something is wrong rather than slow.
function requestDeadlineMs() -> Int {
    return 30000
}

// Waits without releasing the handle, for a request whose response is read from
// that same handle after it completes.
//
// The deadline is the library's, set on the request before it is sent, so a
// peer that sends headers and then stops still completes this operation with a
// timeout rather than leaving it pending. Without one this loop yields forever:
// `kira_network_poll` answers 0 for as long as nothing has arrived, and nothing ever
// arriving is exactly the case a timeout exists for.
function waitResponse(handle: Int) -> Int {
    if handle <= 0 {
        return handle
    }
    var state = kira_network_poll(handle)
    while state == 0 {
        taskYield()
        state = kira_network_poll(handle)
    }
    return kira_network_result(handle)
}

// The response arrives one Unicode scalar at a time, because a C function
// returning `int64_t` has no way to hand back owned text; `scalarText` turns
// each code point into the `String` this builds.
function responseText(handle: Int) -> String {
    var text = ""
    var scalar = kira_network_response_read_scalar(handle)
    while scalar >= 0 {
        text = text + scalarText(scalar)
        scalar = kira_network_response_read_scalar(handle)
    }
    return text
}

async function runHttp1() -> Int {
    let server = kira_network_http1_server()
    if server <= 0 {
        return server
    }
    let port = serverPort(server)
    if port <= 0 {
        networkClose(server)
        return port
    }
    let client = kira_network_http1_client(U16(port))
    if client <= 0 {
        networkClose(server)
        return client
    }
    let clientResult = waitOperation(client)
    if clientResult <= 0 {
        networkClose(server)
        return clientResult
    }
    return clientResult + waitOperation(server)
}

