// Seamless C-FFI: ordinary Kira code calls C functions with no `@Native`.
//
// Each `@FFI.Extern` declaration names the native library, the C symbol, and the
// C ABI, and is a bodyless function with an exact-width signature. The call
// sites below look like any other Kira call. Build the C archive first — see
// README.md — then run this on any backend:
//
//     kira run --backend vm main.kira
//     kira run --backend llvm main.kira
//     kira run --backend hybrid main.kira

@FFI.Extern { library: ffimath, symbol: ffi_add, abi: c }
function add(a: I32, b: I32) -> I32

// A Kira `String` reaches a `CString` parameter by a transient NUL-terminated
// copy; the caller keeps its `String`.
@FFI.Extern { library: ffimath, symbol: ffi_name_len, abi: c }
function nameLen(name: CString) -> U64

// `RawPtr` is an opaque target-width word Kira may store and pass back, never
// dereference or free.
@FFI.Extern { library: ffimath, symbol: ffi_origin, abi: c }
function origin() -> RawPtr

@FFI.Extern { library: ffimath, symbol: ffi_ptr_word, abi: c }
function ptrWord(p: RawPtr) -> Int

@Main function main() {
    print(add(20, 22))
    print(nameLen("kira"))
    print(ptrWord(origin()))
    return
}
