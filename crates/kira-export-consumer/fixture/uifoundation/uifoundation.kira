// UI Foundation: the motivating library, authored in Kira and consumed from
// Rust. This fixture exercises the export boundary with a class handle and
// scalar functions.
//
// A handle-eligible class: instances cross to Rust as opaque handles.
@Export
class Button {
    var title: String = ""
    var width: Int = 120
}

// Handle out: the constructor-shaped export.
@Export
function makeButton(title: String) -> Button {
    var button = Button()
    button.title = title
    return button
}

// Handle in, scalar out.
@Export
function buttonWidth(button: Button) -> Int {
    return button.width
}

// Handle in, owned string out.
@Export
function buttonLabel(button: Button) -> String {
    return button.title
}

// Several scalars in, a boolean out: Rust re-entering Kira per event is what a
// callback means in this direction.
@Export
function clickAt(button: Button, x: Int, y: Int) -> Bool {
    return x >= 0 && x < button.width && y >= 0
}

// The one function in this library that is not on the VM by default.
//
// On the **hybrid** engine this body is compiled machine code in a shared
// library, and `widen` below reaches it across the seam. On the other two
// engines the annotation is ignored — the VM engine compiles everything to
// bytecode, the native engine compiles everything to machine code — and all
// three must produce the same number, which is what makes this a parity case
// rather than a demonstration.
//
// It calls nothing. A `@Native` function that called a `@Runtime` one would be
// refused by the hybrid library build, by name: a library instance owns a heap
// and is entered through a mutable borrow, so it cannot be re-entered from
// inside a call.
@Native
function widenedWidth(width: Int, by: Int) -> Int {
    return width + by
}

// Handle in, handle out. An exported parameter is lent, so this returns a new
// button rather than widening the one it was given.
//
// `@Runtime` by default, and it must be: it takes and returns handles, which are
// roots into the VM instance's heap. An `@Export` that were also `@Native` is
// refused by the hybrid build for exactly that reason.
@Export
function widen(button: Button, by: Int) -> Button {
    var wider = Button()
    wider.title = button.title
    wider.width = widenedWidth(button.width, by)
    return wider
}

// No arguments, and a float, to keep the nullary and floating-point paths of
// the generator exercised by something that runs.
@Export
function defaultWidth() -> Int {
    return 120
}

@Export
function aspectRatio(button: Button) -> Float {
    return 0.5
}

// The library's own output. `print` is an effect, and the VM hands it to the
// host the embedder supplied rather than to a stream it picked itself — so this
// export is what proves `load_with` reaches a consumer's host at all.
@Export
function announce(button: Button) {
    print("showing " + button.title)
}

// Not exported. A library may hold whatever it likes behind the boundary; only
// what is marked crosses.
function hidden() -> Int {
    return 7
}
