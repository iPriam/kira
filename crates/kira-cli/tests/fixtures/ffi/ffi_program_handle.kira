// A single-member C handle struct (`struct { unsigned int id; }`) crosses the
// seam as its `U32` field: a result is rebuilt into the struct, and an argument
// has its field read out. Round-tripping it proves both directions produce
// byte-identical output on the VM, LLVM/native, and hybrid backends.

struct Handle {
    var id: U32
}

@FFI.Extern { library: ffifixture, symbol: ffi_make_handle, abi: c }
function makeHandle(id: U32) -> Handle

@FFI.Extern { library: ffifixture, symbol: ffi_handle_id, abi: c }
function handleId(handle: Handle) -> U32

@FFI.Extern { library: ffifixture, symbol: ffi_bump_handle, abi: c }
function bumpHandle(handle: Handle) -> Handle

@Main
function main() {
    // A scalar becomes a handle: the result `7` is rebuilt into `Handle { 7 }`.
    let handle = makeHandle(7)
    // A handle becomes a scalar: the argument's `id` field is read out.
    print(handleId(handle))
    // Both directions at once, then an ordinary field read of the rebuilt struct.
    let next = bumpHandle(handle)
    print(handleId(next))
    print(next.id)
    return
}
