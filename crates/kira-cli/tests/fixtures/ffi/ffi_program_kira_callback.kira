@FFI.Callback { abi: c; params: [I32, I32]; result: I32; }
struct Adder {}

@FFI.Struct { layout: c; }
struct Hooks { var add: Adder
var scale: I32 }

@FFI.Extern { library: ffifixture; symbol: ffi_call_adder; abi: c; }
function callAdder(add: Adder, a: I32, b: I32) -> I32;
@FFI.Extern { library: ffifixture; symbol: ffi_fold_adder; abi: c; }
function foldAdder(add: Adder, a: I32, b: I32) -> I32;
@FFI.Extern { library: ffifixture; symbol: ffi_store_adder; abi: c; }
function storeAdder(h: Hooks) -> Void;
@FFI.Extern { library: ffifixture; symbol: ffi_run_stored; abi: c; }
function runStored(a: I32, b: I32) -> I32;

// The function C calls back into. Ordinary Kira: it runs on whichever engine
// the program was built for.
function combine(a: I32, b: I32) -> I32 {
    return a * 10 + b
}

@Main function main() {
    // C calls straight back into Kira.
    print(callAdder(combine, 3, 4))
    // And twice in one call, with the first result feeding the second.
    print(foldAdder(combine, 3, 4))
    // The descriptor-struct shape: C keeps the callback and calls it later.
    storeAdder(Hooks { add: combine, scale: 2 })
    print(runStored(5, 6))
    return
}
