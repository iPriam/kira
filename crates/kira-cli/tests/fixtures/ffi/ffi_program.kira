// Exercises every supported `@FFI.Extern` type against the checked-in C fixture.
// The output is identical on the VM, LLVM/native, and hybrid backends, and the
// final two lines (1 then 2) prove the hybrid single-copy rule: a runtime-half
// foreign call and a native-half one share one counter.

@FFI.Extern { library: ffifixture; symbol: ffi_add_i32; abi: c; }
function addI32(a: I32, b: I32) -> I32;

@FFI.Extern { library: ffifixture; symbol: ffi_neg_i8; abi: c; }
function negI8(x: I8) -> I8;

@FFI.Extern { library: ffifixture; symbol: ffi_id_u8; abi: c; }
function idU8(x: U8) -> U8;

@FFI.Extern { library: ffifixture; symbol: ffi_neg_i16; abi: c; }
function negI16(x: I16) -> I16;

@FFI.Extern { library: ffifixture; symbol: ffi_id_u16; abi: c; }
function idU16(x: U16) -> U16;

@FFI.Extern { library: ffifixture; symbol: ffi_id_u32; abi: c; }
function idU32(x: U32) -> U32;

@FFI.Extern { library: ffifixture; symbol: ffi_add_i64; abi: c; }
function addI64(a: I64, b: I64) -> I64;

@FFI.Extern { library: ffifixture; symbol: ffi_id_u64; abi: c; }
function idU64(x: U64) -> U64;

@FFI.Extern { library: ffifixture; symbol: ffi_not; abi: c; }
function notBool(b: Bool) -> Bool;

@FFI.Extern { library: ffifixture; symbol: ffi_add_f32; abi: c; }
function addF32(a: F32, b: F32) -> F32;

@FFI.Extern { library: ffifixture; symbol: ffi_add_f64; abi: c; }
function addF64(a: F64, b: F64) -> F64;

@FFI.Extern { library: ffifixture; symbol: ffi_strlen; abi: c; }
function cstrLen(s: CString) -> U64;

@FFI.Extern { library: ffifixture; symbol: ffi_make_ptr; abi: c; }
function makePtr() -> RawPtr;

@FFI.Extern { library: ffifixture; symbol: ffi_null_ptr; abi: c; }
function nullPtr() -> RawPtr;

@FFI.Extern { library: ffifixture; symbol: ffi_ptr_word; abi: c; }
function ptrWord(p: RawPtr) -> I64;

@FFI.Extern { library: ffifixture; symbol: ffi_store; abi: c; }
function storeCell(v: I32);

@FFI.Extern { library: ffifixture; symbol: ffi_load; abi: c; }
function loadCell() -> I32;

@FFI.Extern { library: ffifixture; symbol: ffi_bump; abi: c; }
function bump() -> I64;

// One wrapper per engine: the hybrid backend runs the first on the VM half and
// the second as machine code, and both reach the same C counter.
@Runtime function bumpRuntime() -> I64 { return bump() }
@Native function bumpNative() -> I64 { return bump() }

@Main function main() {
    print(addI32(20, 22))
    print(negI8(5))
    print(idU8(200))
    print(negI16(9))
    print(idU16(40000))
    print(idU32(4000000000))
    print(addI64(1000, 975))
    print(idU64(5000000000))
    print(notBool(true))
    print(addF32(1.5, 2.25))
    print(addF64(1.5, 0.25))
    print(cstrLen("kira"))
    print(ptrWord(makePtr()))
    print(ptrWord(nullPtr()))
    storeCell(7)
    print(loadCell())
    print(bumpRuntime())
    print(bumpNative())
    return
}
