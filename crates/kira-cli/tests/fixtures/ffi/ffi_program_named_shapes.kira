// Named enum and array shapes in a C foreign signature.

enum Usage { Vertex Index Uniform }

@FFI.Struct { layout: c; }
struct Pair {
    let first: I32 = 0
    let second: I32 = 0
}

@FFI.Extern { library: ffifixture; symbol: ffi_usage_stride; abi: c; }
function ffiUsageStride(usage: Usage): I32;
@FFI.Extern { library: ffifixture; symbol: ffi_sum_floats; abi: c; }
function ffiSumFloats(values: [F32], count: I32): F32;
@FFI.Extern { library: ffifixture; symbol: ffi_pair_sum; abi: c; }
function ffiPairSum(pair: Pair): I32;

// The enum crosses as its case's number, so the named type stays on this side
// of the call rather than being mapped to an integer at every site.
@Native
function strideOf(usage: Usage) -> Int {
    return ffiUsageStride(usage)
}

// The parameter says `[F32]` rather than `RawPtr`, so the signature states what
// it takes.
@Native
function sumOf(values: borrow [F32]) -> Float {
    return ffiSumFloats(values, values.count)
}

@Native
function pairSum() -> Int {
    return ffiPairSum(Pair { first: 17, second: 25 })
}

@Main
function main() {
    print(strideOf(Usage.Vertex))
    print(strideOf(Usage.Index))
    print(strideOf(Usage.Uniform))
    print(sumOf([1.5, 2.25, 3.0]))
    print(pairSum())
    return
}
