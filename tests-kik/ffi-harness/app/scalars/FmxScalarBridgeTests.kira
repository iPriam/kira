import Foundation

// FmxScalarBridgeTests.kira — the crossing-heavy half of the scalar suite,
// continued from `FmxScalarTests.kira`.
//
// The `@Native`, `@Runtime` and callback helpers these cases call live in that
// file. Top-level names are package-scoped, so a case here reaches them by name;
// only the `import` is file-scoped, which is why Foundation is imported again.
//
// Split from it to keep both files under the 700-line limit. The seam is a group
// boundary rather than a line count: that file pins one scalar shape per case,
// and this one exercises what happens when the seam is crossed repeatedly —
// callbacks, loop churn, strings, and the combined catch-alls.
// All top-level names use prefix fmx / Fmx.

// Tests: Callbacks / closures
// ════════════════════════════════════════════════════════════════════════════

construct FmxCallbackSquare() extends Test {
    // closure -> @Native square: 6^2 = 36
    test {
        let cb: (Int) -> Int = { x in
            return fmxNativeSquare(x)
        }
        return fmxNativeInvokeOnce(move cb, 6)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(36) return e }
}

construct FmxCallbackInvokeTwice() extends Test {
    // cb(cb(10)) = cb(13) = 16
    test {
        let cb: (Int) -> Int = { x in
            return x + 3
        }
        return fmxNativeInvokeTwice(move cb, 10)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(16) return e }
}

construct FmxCallbackInvokeSum() extends Test {
    // cb(5)+cb(7) = 10+14 = 24
    test {
        let cb: (Int) -> Int = { x in
            return x * 2
        }
        return fmxNativeInvokeSum(move cb, 5, 7)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(24) return e }
}

construct FmxCallbackNativeInside() extends Test {
    // closure calls @Native, then passed to @Native: 32+10 = 42
    test {
        let cb: (Int) -> Int = { x in
            return fmxNativeAdd(x, 10)
        }
        return fmxNativeInvokeOnce(move cb, 32)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(42) return e }
}

construct FmxCallbackNRNInside() extends Test {
    // closure calls N->R bridge (fmxNativeCallDouble), passed to @Native
    // fmxNativeCallDouble(21) = fmxRuntimeDouble(21) = 42
    test {
        let cb: (Int) -> Int = { x in
            return fmxNativeCallDouble(x)
        }
        return fmxNativeInvokeOnce(move cb, 21)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(42) return e }
}

construct FmxCallbackLoop() extends Test {
    // Each iteration creates a fresh closure, moves to @Native, invokes once
    // sum of squares: 1^2+2^2+3^2+4^2+5^2 = 1+4+9+16+25 = 55
    test {
        var acc = 0
        var i = 0
        while i < 5 {
            let sq: (Int) -> Int = { x in
                return fmxNativeSquare(x)
            }
            acc = acc + fmxNativeInvokeOnce(move sq, i + 1)
            i = i + 1
        }
        return acc
    }
    expect { let e: Result<Any, TestFailure> = .Ok(55) return e }
}

// ════════════════════════════════════════════════════════════════════════════
// Tests: Loop churning
// ════════════════════════════════════════════════════════════════════════════

construct FmxLoopSum100() extends Test {
    // sum of fmxNativeAdd(i, 1) for i=0..99 = sum 1..100 = 5050
    test {
        var acc = 0
        var i = 0
        while i < 100 {
            acc = acc + fmxNativeAdd(i, 1)
            i = i + 1
        }
        return acc
    }
    expect { let e: Result<Any, TestFailure> = .Ok(5050) return e }
}

construct FmxLoopDouble10() extends Test {
    // acc *= 2 ten times: 2^10 = 1024
    test {
        var acc = 1
        var i = 0
        while i < 10 {
            acc = fmxNativeMul(acc, 2)
            i = i + 1
        }
        return acc
    }
    expect { let e: Result<Any, TestFailure> = .Ok(1024) return e }
}

construct FmxLoopNRDouble() extends Test {
    // acc = fmxNativeCallDouble(acc) five times: 1->2->4->8->16->32
    test {
        var acc = 1
        var i = 0
        while i < 5 {
            acc = fmxNativeCallDouble(acc)
            i = i + 1
        }
        return acc
    }
    expect { let e: Result<Any, TestFailure> = .Ok(32) return e }
}

construct FmxLoopSquareSum() extends Test {
    // 1^2+2^2+3^2+4^2+5^2 = 55
    test {
        var acc = 0
        var i = 1
        while i <= 5 {
            acc = acc + fmxNativeSquare(i)
            i = i + 1
        }
        return acc
    }
    expect { let e: Result<Any, TestFailure> = .Ok(55) return e }
}

construct FmxLoop1000() extends Test {
    // 1000 calls to fmxNativeAdd(acc, 1) -> 1000
    test {
        var acc = 0
        var i = 0
        while i < 1000 {
            acc = fmxNativeAdd(acc, 1)
            i = i + 1
        }
        return acc
    }
    expect { let e: Result<Any, TestFailure> = .Ok(1000) return e }
}

construct FmxLoopNRNAccum() extends Test {
    // i=0..4: fmxHopNRNAdd(i, i^2) = i+i^2
    // 0+0=0, 1+1=2, 2+4=6, 3+9=12, 4+16=20 -> sum=40
    test {
        var acc = 0
        var i = 0
        while i < 5 {
            acc = acc + fmxHopNRNAdd(i, fmxNativeSquare(i))
            i = i + 1
        }
        return acc
    }
    expect { let e: Result<Any, TestFailure> = .Ok(40) return e }
}

// ════════════════════════════════════════════════════════════════════════════
// Tests: String bridge (try; remove + record on crash)
// ════════════════════════════════════════════════════════════════════════════

construct FmxStringLenPure() extends Test {
    // Pure @Runtime — no bridge, baseline sanity
    test {
        let s = "hello"
        return s.count
    }
    expect { let e: Result<Any, TestFailure> = .Ok(5) return e }
}

construct FmxStringNativeBorrowCount() extends Test {
    // borrow String across the bridge into @Native
    test {
        let s = "hello world"
        return fmxNativeStringCount(s)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(11) return e }
}

construct FmxStringNativeBorrowEmpty() extends Test {
    // empty string borrow into @Native
    test {
        let s = ""
        return fmxNativeStringCount(s)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(0) return e }
}

construct FmxStringNativeBorrowMulti() extends Test {
    // multiple borrow-String calls to @Native
    test {
        let w1 = "one"
        let w2 = "two"
        let w3 = "three"
        let w4 = "four"
        let a = fmxNativeStringCount(w1)
        let b = fmxNativeStringCount(w2)
        let c = fmxNativeStringCount(w3)
        let d = fmxNativeStringCount(w4)
        return a + b + c + d
    }
    // 3 + 3 + 5 + 4 = 15
    expect { let e: Result<Any, TestFailure> = .Ok(15) return e }
}

// ════════════════════════════════════════════════════════════════════════════
// Tests: Combined / catch-all
// ════════════════════════════════════════════════════════════════════════════

construct FmxCombinedAddMulDiv() extends Test {
    // 10+5=15, 15*3=45, 45/5=9
    test {
        let a = fmxNativeAdd(10, 5)
        let b = fmxNativeMul(a, 3)
        return fmxNativeDiv(b, 5)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(9) return e }
}

construct FmxCombinedNRChain() extends Test {
    // N->R: double(10)=20, triple(20)=60, 60+2=62
    test {
        let x = fmxNativeCallDouble(10)
        let y = fmxNativeCallTriple(x)
        return fmxNativeAdd(y, 2)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(62) return e }
}

construct FmxCombinedNRNChain() extends Test {
    // NRN mul(3,4)=12, NRN add(12,12)=24, div(24,4)=6, square(6)=36
    test {
        let a = fmxHopNRNMul(3, 4)
        let b = fmxHopNRNAdd(a, a)
        let c = fmxNativeDiv(b, 4)
        return fmxNativeSquare(c)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(36) return e }
}

construct FmxCombinedBoolInt() extends Test {
    // boolTrue -> +15, boolFalse -> +0, boolId(true) -> +12 = 27
    test {
        var acc = 0
        if fmxNativeBoolTrue() { acc = acc + fmxNativeAdd(10, 5) }
        if fmxNativeBoolFalse() { acc = acc + 1000 }
        if fmxNativeBoolId(true) { acc = acc + fmxNativeMul(3, 4) }
        return acc
    }
    expect { let e: Result<Any, TestFailure> = .Ok(27) return e }
}

construct FmxCombinedLoopNRN() extends Test {
    // i=0..9: fmxHopNRNAdd(i, i^2) = i+i^2; sum=330
    // 0+2+6+12+20+30+42+56+72+90 = 330
    test {
        var acc = 0
        var i = 0
        while i < 10 {
            let step = fmxHopNRNAdd(i, fmxNativeSquare(i))
            acc = acc + step
            i = i + 1
        }
        return acc
    }
    expect { let e: Result<Any, TestFailure> = .Ok(330) return e }
}

construct FmxCombinedCallback() extends Test {
    // Two sequential closures: mul(7,3)=21; then 21+21=42
    test {
        let cb1: (Int) -> Int = { x in
            return fmxNativeMul(x, 3)
        }
        let a = fmxNativeInvokeOnce(move cb1, 7)
        let cb2: (Int) -> Int = { x in
            return fmxNativeAdd(x, 21)
        }
        return fmxNativeInvokeOnce(move cb2, a)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(42) return e }
}

construct FmxCombinedFloatBoolInt() extends Test {
    // Float checks -> Bool -> gated Int additions
    // floatEq(1+2, 3) -> +10; floatEq(3*4, 12) -> +20; boolTrue -> square(3)=+9 = 39
    test {
        var acc = 0
        if fmxNativeFloatEq(fmxNativeFloatAdd(1.0, 2.0), 3.0) { acc = acc + 10 }
        if fmxNativeFloatEq(fmxNativeFloatMul(3.0, 4.0), 12.0) { acc = acc + 20 }
        if fmxNativeBoolTrue() { acc = acc + fmxNativeSquare(3) }
        return acc
    }
    expect { let e: Result<Any, TestFailure> = .Ok(39) return e }
}

construct FmxUltimateStress() extends Test {
    // i=0..19: a=i+1, b=N->R:double(a)=2(i+1), c=NRN:add(a,b)=3(i+1), d=c%7
    // Cycle [3,6,2,5,1,4,0] repeats; 20 iters = 3 full cycles (21 each) = 63
    test {
        var acc = 0
        var i = 0
        while i < 20 {
            let a = fmxNativeAdd(i, 1)
            let b = fmxNativeCallDouble(a)
            let c = fmxHopNRNAdd(a, b)
            let d = fmxNativeMod(c, 7)
            acc = acc + d
            i = i + 1
        }
        return acc
    }
    expect { let e: Result<Any, TestFailure> = .Ok(63) return e }
}

construct FmxManyHopsStress() extends Test {
    // 4-hop sequence: R->N->R, R->N, N->R->N, N->R
    // x=5, a=N->R:double(5)=10, b=R->N:add(10,3)=13, c=N->R->N:square(13)=169, N->R:addFive(169)=174
    test {
        let x = 5
        let a = fmxNativeCallDouble(x)
        let b = fmxRuntimeCallNativeAdd(a, 3)
        let c = fmxHopNRNSquare(b)
        return fmxNativeCallAddFive(c)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(174) return e }
}

// ─── Trap test whose `expect` bridges into @Native ───────────────────────────
// Regression guard for the hybrid trap path evaluating `__expect()` THROUGH THE
// BRIDGE. The expect block calls @Native (`fmxNativeAdd`) to select the expected
// runtime-failure message; on the embedded VM with no @Native hook that call
// could not resolve, so the expected message would be lost. The runtime now runs
// `__expect()` through the bridge (runFunctionForValue), so the substring is
// computed and matched against the real divide-by-zero trap raised by `test()`.
construct FmxTrapExpectBridgesNative() extends Test {
    test { return 1 / 0 }
    expect {
        let probe = fmxNativeAdd(40, 2)
        if probe == 42 {
            let e: Result<Any, TestFailure> = .Error(.Runtime("division by zero"))
            return e
        }
        let other: Result<Any, TestFailure> = .Error(.Runtime("unreachable probe value"))
        return other
    }
}
