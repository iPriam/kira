construct FcbLoopSandwichDouble5() extends Test {
    test {
        var acc = 3
        var i = 0
        while i < 5 {
            let cb: (Int) -> Int = { x in return fsbAddScaled(x, 0, 2) }
            acc = fcbInvoke(move cb, acc)
            i = i + 1
        }
