import Foundation

// Function-value callback bridge tests.
// Prefix: fcb / Fcb.
// @Native helpers cover single, multiple, repeated, and re-entrant calls.
// Group K covers scalar `let` captures. Methods and aggregate captures are
// outside this fixture.

// ── Native bridge helpers ────────────────────────────────────────────────────

@Native
function fcbInvoke(callback: (Int) -> Int, seed: Int) -> Int {
    return callback(seed)
}

@Native
function fcbInvokeTwo(f1: (Int) -> Int, f2: (Int) -> Int, a: Int, b: Int) -> Int {
    return f1(a) + f2(b)
}

@Native
function fcbInvokeThree(f1: (Int) -> Int, f2: (Int) -> Int, f3: (Int) -> Int, a: Int, b: Int, c: Int) -> Int {
    return f1(a) + f2(b) + f3(c)
}

function fcbTopLevelAddFive(x: Int) -> Int {
    return x + 5
}

// ── Group A: fcbInvoke — arithmetic closures, no captures ────────────────────

construct FcbNamedFunction() extends Test {
    test {
        return fcbInvoke(fcbTopLevelAddFive, 3)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(8) return e }
}

construct FcbIdentity() extends Test {
    test {
        let cb: (Int) -> Int = { x in return x }
        return fcbInvoke(move cb, 42)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(42) return e }
}

construct FcbConstant() extends Test {
    test {
        let cb: (Int) -> Int = { x in return 77 }
        return fcbInvoke(move cb, 0)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(77) return e }
}

construct FcbDouble() extends Test {
    test {
        let cb: (Int) -> Int = { x in return x * 2 }
        return fcbInvoke(move cb, 6)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(12) return e }
}

construct FcbAddFive() extends Test {
    test {
        let cb: (Int) -> Int = { x in return x + 5 }
        return fcbInvoke(move cb, 3)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(8) return e }
}

construct FcbNegate() extends Test {
    test {
        let cb: (Int) -> Int = { x in return 0 - x }
        return fcbInvoke(move cb, 9)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(0 - 9) return e }
}

construct FcbSquare() extends Test {
    test {
        let cb: (Int) -> Int = { x in return x * x }
        return fcbInvoke(move cb, 7)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(49) return e }
}

construct FcbLinear() extends Test {
    test {
        let cb: (Int) -> Int = { x in return x * 3 + 6 }
        return fcbInvoke(move cb, 4)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(18) return e }
}

construct FcbSubFromConstant() extends Test {
    test {
        let cb: (Int) -> Int = { x in return 10 - x }
        return fcbInvoke(move cb, 3)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(7) return e }
}

// ── Group B: fcbInvoke — closure capturing scalar lets ────────────────────────

construct FcbCaptureAdd() extends Test {
    test {
        let bonus = 10
        let cb: (Int) -> Int = { x in return x + bonus }
        return fcbInvoke(move cb, 5)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(15) return e }
}

// ── Group C: fcbInvoke — callback calls @Native inside ───────────────────────

construct FcbSandwichAddScaled() extends Test {
    test {
        let cb: (Int) -> Int = { x in return fsbAddScaled(x, 1, 3) }
        return fcbInvoke(move cb, 5)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(18) return e }
}

construct FcbSandwichStructWidth() extends Test {
    test {
        let cb: (Int) -> Int = { x in
            let s = fsbRootSize()
            return s.width + x
        }
        return fcbInvoke(move cb, 0)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(320) return e }
}

construct FcbSandwichStructHeight() extends Test {
    test {
        let cb: (Int) -> Int = { x in
            let s = fsbRootSize()
            return s.height + x
        }
        return fcbInvoke(move cb, 0)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(240) return e }
}

construct FcbSandwichStructSum() extends Test {
    test {
        let cb: (Int) -> Int = { x in
            let s = fsbRootSize()
            return s.width + s.height + x
        }
        return fcbInvoke(move cb, 40)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(600) return e }
}

construct FcbSandwichNested() extends Test {
    test {
        let cb: (Int) -> Int = { x in
            return fsbAddScaled(fsbAddScaled(x, 0, 2), 0, 3)
        }
        return fcbInvoke(move cb, 2)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(12) return e }
}

// ── Group D: repeated callback crossings ─────────────────────────────────────

construct FcbLoopAddOne100() extends Test {
    test {
        var acc = 0
        var i = 0
        while i < 100 {
            let cb: (Int) -> Int = { x in return x + 1 }
            acc = fcbInvoke(move cb, acc)
            i = i + 1
        }
        return acc
    }
    expect { let e: Result<Any, TestFailure> = .Ok(100) return e }
}

construct FcbLoopAddOne500() extends Test {
    test {
        var acc = 0
        var i = 0
        while i < 500 {
            let cb: (Int) -> Int = { x in return x + 1 }
            acc = fcbInvoke(move cb, acc)
            i = i + 1
        }
        return acc
    }
    expect { let e: Result<Any, TestFailure> = .Ok(500) return e }
}

construct FcbLoopDouble5() extends Test {
    test {
        var acc = 1
        var i = 0
        while i < 5 {
            let cb: (Int) -> Int = { x in return x * 2 }
            acc = fcbInvoke(move cb, acc)
            i = i + 1
        }
        return acc
    }
    expect { let e: Result<Any, TestFailure> = .Ok(32) return e }
}

construct FcbLoopDouble8() extends Test {
    test {
