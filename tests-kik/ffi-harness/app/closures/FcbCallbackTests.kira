// ── Group E: fcbInvokeTwo — two distinct owned closures, each called once ─────

construct FcbTwoArithmetic() extends Test {
    test {
        let f1: (Int) -> Int = { x in return x + 1 }
        let f2: (Int) -> Int = { x in return x * 2 }
        return fcbInvokeTwo(move f1, move f2, 9, 5)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(20) return e }
}

construct FcbTwoSandwiches() extends Test {
    test {
        let f1: (Int) -> Int = { x in return fsbAddScaled(x, 0, 2) }
        let f2: (Int) -> Int = { x in return fsbAddScaled(x, 0, 3) }
        return fcbInvokeTwo(move f1, move f2, 3, 2)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(12) return e }
}

construct FcbTwoMixed() extends Test {
    test {
        let f1: (Int) -> Int = { x in return x + 1 }
        let f2: (Int) -> Int = { x in
            let s = fsbRootSize()
            return s.width + x
        }
        return fcbInvokeTwo(move f1, move f2, 9, 0)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(330) return e }
}

construct FcbTwoNegAndPos() extends Test {
    test {
        let f1: (Int) -> Int = { x in return x * 2 }
        let f2: (Int) -> Int = { x in return 0 - x * 2 }
        return fcbInvokeTwo(move f1, move f2, 5, 5)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(0) return e }
}

// ── Group F: fcbInvokeThree — three distinct owned closures, each called once ─

construct FcbThreeIdentities() extends Test {
    test {
        let f1: (Int) -> Int = { x in return x }
        let f2: (Int) -> Int = { x in return x }
        let f3: (Int) -> Int = { x in return x }
        return fcbInvokeThree(move f1, move f2, move f3, 1, 2, 3)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(6) return e }
}

construct FcbThreeDoubles() extends Test {
    test {
        let f1: (Int) -> Int = { x in return x * 2 }
        let f2: (Int) -> Int = { x in return x * 2 }
        let f3: (Int) -> Int = { x in return x * 2 }
        return fcbInvokeThree(move f1, move f2, move f3, 1, 2, 3)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(12) return e }
}

construct FcbThreeMixedArith() extends Test {
    test {
        let f1: (Int) -> Int = { x in return x + 1 }
        let f2: (Int) -> Int = { x in return x * 2 }
        let f3: (Int) -> Int = { x in return x * x }
        return fcbInvokeThree(move f1, move f2, move f3, 4, 3, 2)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(15) return e }
}

construct FcbThreeSandwiches() extends Test {
    test {
        let f1: (Int) -> Int = { x in return fsbAddScaled(x, 0, 2) }
        let f2: (Int) -> Int = { x in return fsbAddScaled(x, 0, 2) }
        let f3: (Int) -> Int = { x in return fsbAddScaled(x, 0, 2) }
        return fcbInvokeThree(move f1, move f2, move f3, 1, 2, 3)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(12) return e }
}

// ── Group G: sequential multi-call in test body ───────────────────────────────

construct FcbSequentialTwoRaw() extends Test {
    test {
        let cb1: (Int) -> Int = { x in return x + 1 }
        let cb2: (Int) -> Int = { x in return x * 2 }
        let r1 = fcbInvoke(move cb1, 5)
        let r2 = fcbInvoke(move cb2, 5)
        return r1 + r2
    }
    expect { let e: Result<Any, TestFailure> = .Ok(16) return e }
}

construct FcbSequentialSandwich() extends Test {
    test {
        let cb1: (Int) -> Int = { x in return fsbAddScaled(x, 1, 2) }
        let cb2: (Int) -> Int = { x in
            let s = fsbRootSize()
            return s.width + x
        }
        let r1 = fcbInvoke(move cb1, 2)
        let r2 = fcbInvoke(move cb2, 0)
        return r1 + r2
    }
    expect { let e: Result<Any, TestFailure> = .Ok(326) return e }
}

construct FcbSequentialThree() extends Test {
    test {
        let cb1: (Int) -> Int = { x in return x + 10 }
        let cb2: (Int) -> Int = { x in return x + 20 }
        let cb3: (Int) -> Int = { x in return x + 30 }
        let r1 = fcbInvoke(move cb1, 1)
        let r2 = fcbInvoke(move cb2, 2)
        let r3 = fcbInvoke(move cb3, 3)
        return r1 + r2 + r3
    }
    expect { let e: Result<Any, TestFailure> = .Ok(66) return e }
}

// ── Group H: additional no-capture patterns ───────────────────────────────────

construct FcbPolynomial() extends Test {
    test {
        // x*x + x + 1 at x=3 → 9+3+1 = 13
        let cb: (Int) -> Int = { x in return x * x + x + 1 }
        return fcbInvoke(move cb, 3)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(13) return e }
}

construct FcbHighFreqLoop() extends Test {
    test {
        // 1000 bridge crossings: acc += 1 each iteration → 1000
        var acc = 0
        var i = 0
        while i < 1000 {
            let cb: (Int) -> Int = { x in return x + 1 }
            acc = fcbInvoke(move cb, acc)
            i = i + 1
        }
        return acc
    }
    expect { let e: Result<Any, TestFailure> = .Ok(1000) return e }
}

construct FcbLoopGeometric() extends Test {
    test {
        // acc = acc*2+1 for 10 iterations from 0 → 2^10 - 1 = 1023
        var acc = 0
        var i = 0
        while i < 10 {
            let cb: (Int) -> Int = { x in return x * 2 + 1 }
            acc = fcbInvoke(move cb, acc)
            i = i + 1
        }
        return acc
    }
    expect { let e: Result<Any, TestFailure> = .Ok(1023) return e }
}

construct FcbSandwichDoubleWidth() extends Test {
    test {
        // fsbRootSize().width=320, 320*2+5 = 645
        let cb: (Int) -> Int = { x in
            let s = fsbRootSize()
            return s.width * 2 + x
        }
        return fcbInvoke(move cb, 5)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(645) return e }
}

construct FcbSandwichProductArgs() extends Test {
    test {
        // fsbAddScaled(7, 7, 1) = (7+7)*1 = 14
        let cb: (Int) -> Int = { x in return fsbAddScaled(x, x, 1) }
        return fcbInvoke(move cb, 7)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(14) return e }
}

construct FcbTwoSquareAndTriple() extends Test {
    test {
        // f1(4)=16, f2(5)=15 → 31
        let f1: (Int) -> Int = { x in return x * x }
        let f2: (Int) -> Int = { x in return x * 3 }
        return fcbInvokeTwo(move f1, move f2, 4, 5)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(31) return e }
}

construct FcbThreeDistinctArith() extends Test {
    test {
        // f1(1)=11, f2(4)=12, f3(5)=25 → 48
        let f1: (Int) -> Int = { x in return x + 10 }
        let f2: (Int) -> Int = { x in return x * 3 }
        let f3: (Int) -> Int = { x in return x * x }
        return fcbInvokeThree(move f1, move f2, move f3, 1, 4, 5)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(48) return e }
}

construct FcbSeqFourSteps() extends Test {
    test {
        // r1=cb1(2)=3, r2=cb2(3)=6, r3=cb3(4)=7, r4=cb4(5)=25 → 41
        let cb1: (Int) -> Int = { x in return x + 1 }
        let cb2: (Int) -> Int = { x in return x * 2 }
        let cb3: (Int) -> Int = { x in return x + 3 }
        let cb4: (Int) -> Int = { x in return x * x }
        let r1 = fcbInvoke(move cb1, 2)
        let r2 = fcbInvoke(move cb2, 3)
        let r3 = fcbInvoke(move cb3, 4)
        let r4 = fcbInvoke(move cb4, 5)
        return r1 + r2 + r3 + r4
    }
    expect { let e: Result<Any, TestFailure> = .Ok(41) return e }
}

construct FcbSandwichComposed() extends Test {
    test {
        // fsbAddScaled(5*2, 0, 3) = (10+0)*3 = 30
        let cb: (Int) -> Int = { x in return fsbAddScaled(x * 2, 0, 3) }
        return fcbInvoke(move cb, 5)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(30) return e }
}

// ── Group K: captured scalar lets ─────────────────────────────────────────────

construct FcbCaptureMul() extends Test {
    test {
        let m = 3
        let cb: (Int) -> Int = { x in return x * m }
        return fcbInvoke(move cb, 4)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(12) return e }
}

construct FcbCaptureTwoScalars() extends Test {
    test {
        let p = 10
        let q = 5
        let cb: (Int) -> Int = { x in return x + p + q }
        return fcbInvoke(move cb, 1)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(16) return e }
}

construct FcbCaptureNeg() extends Test {
    test {
        let n = 7
        let cb: (Int) -> Int = { x in return (0 - x) + n }
        return fcbInvoke(move cb, 3)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(4) return e }
}

construct FcbCaptureOffset() extends Test {
    test {
        let off = 100
        let cb: (Int) -> Int = { x in return x + off }
        return fcbInvoke(move cb, 1)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(101) return e }
}

construct FcbCaptureComposite() extends Test {
    test {
        let a = 2
        let b = 3
        let cb: (Int) -> Int = { x in return x * a + b }
        return fcbInvoke(move cb, 5)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(13) return e }
}

construct FcbCaptureSandwich() extends Test {
    test {
        let k = 2
        let cb: (Int) -> Int = { x in return fsbAddScaled(x, 0, k) }
        return fcbInvoke(move cb, 5)
    }
    // fsbAddScaled(5, 0, 2) = (5 + 0) * 2 = 10
    expect { let e: Result<Any, TestFailure> = .Ok(10) return e }
}

construct FcbCaptureStructSandwich() extends Test {
    test {
        let bonus = 5
        let cb: (Int) -> Int = { x in
            let s = fsbRootSize()
            return s.width + x + bonus
        }
        return fcbInvoke(move cb, 0)
    }
    // 320 + 0 + 5
    expect { let e: Result<Any, TestFailure> = .Ok(325) return e }
}

construct FcbLoopCapture50() extends Test {
    test {
        let base = 1
        var acc = 0
        var i = 0
        while i < 50 {
            let cb: (Int) -> Int = { x in return x + base }
            acc = acc + fcbInvoke(move cb, i)
            i = i + 1
        }
        // sum of (i + 1) for i in 0..49 = sum(1..50) = 1275
        return acc
    }
    expect { let e: Result<Any, TestFailure> = .Ok(1275) return e }
}

construct FcbLoopCaptureSandwich5() extends Test {
    test {
        let k = 2
        var acc = 0
        var i = 0
        while i < 5 {
            let cb: (Int) -> Int = { x in return fsbAddScaled(x, 0, k) }
            acc = acc + fcbInvoke(move cb, i)
            i = i + 1
        }
        // fsbAddScaled(i, 0, 2) = 2i; sum(2i, i in 0..4) = 20
        return acc
    }
    expect { let e: Result<Any, TestFailure> = .Ok(20) return e }
}

construct FcbTwoDistinctCaptures() extends Test {
    test {
        let p = 10
        let cbA: (Int) -> Int = { x in return x + p }
        let q = 100
        let cbB: (Int) -> Int = { x in return x + q }
        // Each callback keeps its own capture: (1 + 10) + (2 + 100) = 113.
        return fcbInvokeTwo(move cbA, move cbB, 1, 2)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(113) return e }
}

construct FcbThreeCaptures() extends Test {
    test {
        let p = 10
        let cbA: (Int) -> Int = { x in return x + p }
        let q = 100
        let cbB: (Int) -> Int = { x in return x + q }
        let r = 1000
        let cbC: (Int) -> Int = { x in return x + r }
        // (1+10) + (2+100) + (3+1000) = 1116
        return fcbInvokeThree(move cbA, move cbB, move cbC, 1, 2, 3)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(1116) return e }
}

construct FcbSequentialCaptures() extends Test {
    test {
        let p = 10
        let cbA: (Int) -> Int = { x in return x + p }
        let r1 = fcbInvoke(move cbA, 1)
        let q = 100
        let cbB: (Int) -> Int = { x in return x + q }
        let r2 = fcbInvoke(move cbB, 1)
        // Each sequential callback keeps its own capture: 11 + 101 = 112.
        return r1 + r2
    }
    expect { let e: Result<Any, TestFailure> = .Ok(112) return e }
}
