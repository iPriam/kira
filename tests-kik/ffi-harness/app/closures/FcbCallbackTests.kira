construct FcbLoopSandwichStruct3() extends Test {
    test {
        var acc = 0
        var i = 0
        while i < 3 {
            let cb: (Int) -> Int = { x in
                let s = fsbRootSize()
                return x + s.height
            }
            acc = fcbInvoke(move cb, acc)
