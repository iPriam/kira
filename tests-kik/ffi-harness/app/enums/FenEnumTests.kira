import Foundation

// Hybrid FFI / enum-bridge tests.
// Imports are file-scoped: this file imports Foundation explicitly above.
// All top-level names use prefix fen / Fen.

// ── Enums ────────────────────────────────────────────────────────────────────

enum FenDir { North South East West }
enum FenColor { Red Green Blue }
enum FenState { Idle Running Paused Done }
enum FenVal { Empty Loaded(Int) }

// ── @Native structs ──────────────────────────────────────────────────────────

struct FenPacket {
    let dir: FenDir = .North
    var n: Int
}

struct FenCell {
    let state: FenState = .Idle
    var count: Int
}

// ── @Runtime — enum production ────────────────────────────────────────────────

@Runtime
function fenPickDir(i: Int) -> FenDir {
    if i == 0 { return .North }
    if i == 1 { return .South }
    if i == 2 { return .East }
    return .West
}

@Runtime
function fenPickColor(i: Int) -> FenColor {
    if i == 0 { return .Red }
    if i == 1 { return .Green }
    return .Blue
}

@Runtime
function fenPickState(i: Int) -> FenState {
    if i == 0 { return .Idle }
    if i == 1 { return .Running }
    if i == 2 { return .Paused }
    return .Done
}

@Runtime
function fenPickVal(i: Int) -> FenVal {
    if i % 2 == 0 { return .Empty }
    return .Loaded(i * 7)
}

// ── @Runtime — enum dispatch ──────────────────────────────────────────────────

@Runtime
function fenDirScore(d: borrow FenDir) -> Int {
    match d {
        North -> { return 1 }
        South -> { return 2 }
        East ->  { return 3 }
        West ->  { return 4 }
    }
}

@Runtime
function fenColorScore(c: borrow FenColor) -> Int {
    match c {
        Red ->   { return 10 }
        Green -> { return 20 }
        Blue ->  { return 30 }
    }
}

@Runtime
function fenStateScore(s: borrow FenState) -> Int {
    match s {
        Idle ->    { return 0 }
        Running -> { return 1 }
        Paused ->  { return 2 }
        Done ->    { return 3 }
    }
}

@Runtime
function fenValScore(v: borrow FenVal) -> Int {
    match v {
        Empty ->     { return 0 }
        Loaded(n) -> { return n }
    }
}

@Runtime
function fenPacketScore(p: borrow FenPacket) -> Int {
    match p.dir {
        North -> { return p.n + 1 }
        South -> { return p.n + 2 }
        East ->  { return p.n + 3 }
        West ->  { return p.n + 4 }
    }
}

@Runtime
function fenCellScore(c: borrow FenCell) -> Int {
    match c.state {
        Idle ->    { return 0 }
        Running -> { return c.count * 10 }
        Paused ->  { return c.count * 5 }
        Done ->    { return c.count + 100 }
    }
}

// ── @Runtime — state machine transition ──────────────────────────────────────

@Runtime
function fenNextState(s: borrow FenState) -> FenState {
    match s {
        Idle ->    { return .Running }
        Running -> { return .Paused }
        Paused ->  { return .Done }
        Done ->    { return .Idle }
    }
}

// ── @Native — single-dispatch wrappers ───────────────────────────────────────

@Native
function fenNativeDirScore(i: Int) -> Int {
    let d = fenPickDir(i % 4)
    return fenDirScore(d)
}

@Native
function fenNativeColorScore(i: Int) -> Int {
    let c = fenPickColor(i % 3)
    return fenColorScore(c)
}

@Native
function fenNativeStateScore(i: Int) -> Int {
    let s = fenPickState(i % 4)
    return fenStateScore(s)
}

@Native
function fenNativeValScore(i: Int) -> Int {
    let v = fenPickVal(i)
    return fenValScore(v)
}

// ── @Native — struct factories ────────────────────────────────────────────────

// dir = i%4 mapped to one of four directions; n = i*5
@Native
function fenMakePacket(i: Int) -> FenPacket {
    return FenPacket { dir: fenPickDir(i % 4), n: i * 5 }
}

// state = i%4; count = i+1
@Native
function fenMakeCell(i: Int) -> FenCell {
    return FenCell { state: fenPickState(i % 4), count: i + 1 }
}

// ── @Native — loop-sum helpers ────────────────────────────────────────────────

@Native
function fenDirLoopSum(iters: Int) -> Int {
    var acc = 0
    var i = 0
    while i < iters {
        let d = fenPickDir(i % 4)
        acc = acc + fenDirScore(d)
        i = i + 1
    }
    return acc
}

@Native
function fenColorLoopSum(iters: Int) -> Int {
    var acc = 0
    var i = 0
    while i < iters {
        let c = fenPickColor(i % 3)
        acc = acc + fenColorScore(c)
        i = i + 1
    }
    return acc
}

@Native
function fenStateLoopSum(iters: Int) -> Int {
    var acc = 0
    var i = 0
    while i < iters {
        let s = fenPickState(i % 4)
        acc = acc + fenStateScore(s)
        i = i + 1
    }
    return acc
}

@Native
function fenValLoopSum(iters: Int) -> Int {
    var acc = 0
    var i = 0
    while i < iters {
        let v = fenPickVal(i)
        acc = acc + fenValScore(v)
        i = i + 1
    }
    return acc
}

@Native
function fenPacketLoopSum(iters: Int) -> Int {
    var acc = 0
    var i = 0
    while i < iters {
        let p = fenMakePacket(i % 4)
        acc = acc + fenPacketScore(p)
        i = i + 1
    }
    return acc
}

@Native
function fenCellLoopSum(iters: Int) -> Int {
    var acc = 0
    var i = 0
    while i < iters {
        let c = fenMakeCell(i % 4)
        acc = acc + fenCellScore(c)
        i = i + 1
    }
    return acc
}

// mixed-enum bridge: dir score + color score + state score per iteration
@Native
function fenMixedLoopSum(iters: Int) -> Int {
    var acc = 0
    var i = 0
    while i < iters {
        let d = fenPickDir(i % 4)
        let c = fenPickColor(i % 3)
        let s = fenPickState(i % 4)
        acc = acc + fenDirScore(d) + fenColorScore(c) + fenStateScore(s)
        i = i + 1
    }
    return acc
}

// ── @Runtime — state machine chain ───────────────────────────────────────────

// Starts from Idle; each step transitions and accumulates the score of the new state.
// Uses var s reassignment of a payload-less (Copy) enum — safe in VM context.
@Runtime
function fenStateChain(steps: Int) -> Int {
    var s: FenState = .Idle
    var acc = 0
    var i = 0
    while i < steps {
        s = fenNextState(s)
        acc = acc + fenStateScore(s)
        i = i + 1
    }
    return acc
}

// Bridge: @Native drives the @Runtime chain.
@Native
function fenNativeStateChain(steps: Int) -> Int {
    return fenStateChain(steps)
}

// ── Tests — Group A: single-enum round-trip through @Native ──────────────────
// Pattern: VM calls @Native; @Native calls @Runtime to produce enum, then
// calls @Runtime again to dispatch it; result returns to VM.

construct FenDirNorthScore() extends Test {
    test { return fenNativeDirScore(0) }
    expect { let e: Result<Any, TestFailure> = .Ok(1) return e }
}

construct FenDirSouthScore() extends Test {
    test { return fenNativeDirScore(1) }
    expect { let e: Result<Any, TestFailure> = .Ok(2) return e }
}

construct FenDirEastScore() extends Test {
    test { return fenNativeDirScore(2) }
    expect { let e: Result<Any, TestFailure> = .Ok(3) return e }
}

construct FenDirWestScore() extends Test {
    test { return fenNativeDirScore(3) }
    expect { let e: Result<Any, TestFailure> = .Ok(4) return e }
}

construct FenColorRedScore() extends Test {
    test { return fenNativeColorScore(0) }
    expect { let e: Result<Any, TestFailure> = .Ok(10) return e }
}

construct FenColorGreenScore() extends Test {
    test { return fenNativeColorScore(1) }
    expect { let e: Result<Any, TestFailure> = .Ok(20) return e }
}

construct FenColorBlueScore() extends Test {
    test { return fenNativeColorScore(2) }
    expect { let e: Result<Any, TestFailure> = .Ok(30) return e }
}

construct FenStateIdleScore() extends Test {
    test { return fenNativeStateScore(0) }
    expect { let e: Result<Any, TestFailure> = .Ok(0) return e }
}

construct FenStateRunningScore() extends Test {
    test { return fenNativeStateScore(1) }
    expect { let e: Result<Any, TestFailure> = .Ok(1) return e }
}

construct FenStatePausedScore() extends Test {
    test { return fenNativeStateScore(2) }
    expect { let e: Result<Any, TestFailure> = .Ok(2) return e }
}

construct FenStateDoneScore() extends Test {
    test { return fenNativeStateScore(3) }
    expect { let e: Result<Any, TestFailure> = .Ok(3) return e }
}

// ── Tests — Group B: @Native struct with enum field ─────────────────────────
// @Native makes the struct (calling @Runtime for the enum field), returns to VM,
// VM passes back into @Runtime for dispatch.

// fenMakePacket(0): dir=North, n=0 → fenPacketScore = 0+1 = 1
construct FenPacketNorth() extends Test {
    test {
        let p = fenMakePacket(0)
        return fenPacketScore(p)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(1) return e }
}

// fenMakePacket(1): dir=South, n=5 → 5+2 = 7
construct FenPacketSouth() extends Test {
    test {
        let p = fenMakePacket(1)
        return fenPacketScore(p)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(7) return e }
}

// fenMakePacket(2): dir=East, n=10 → 10+3 = 13
construct FenPacketEast() extends Test {
    test {
        let p = fenMakePacket(2)
        return fenPacketScore(p)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(13) return e }
}

// fenMakePacket(3): dir=West, n=15 → 15+4 = 19
construct FenPacketWest() extends Test {
    test {
        let p = fenMakePacket(3)
        return fenPacketScore(p)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(19) return e }
}

// fenMakeCell(0): state=Idle, count=1 → 0
construct FenCellIdle() extends Test {
    test {
        let c = fenMakeCell(0)
        return fenCellScore(c)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(0) return e }
}

// fenMakeCell(1): state=Running, count=2 → 2*10 = 20
construct FenCellRunning() extends Test {
    test {
        let c = fenMakeCell(1)
        return fenCellScore(c)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(20) return e }
}

// fenMakeCell(2): state=Paused, count=3 → 3*5 = 15
construct FenCellPaused() extends Test {
    test {
        let c = fenMakeCell(2)
        return fenCellScore(c)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(15) return e }
}

// fenMakeCell(3): state=Done, count=4 → 4+100 = 104
construct FenCellDone() extends Test {
    test {
        let c = fenMakeCell(3)
        return fenCellScore(c)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(104) return e }
}

// ── Tests — Group C: single-payload(Int) enum across the bridge ──────────────
// fenPickVal(i): even→Empty(0), odd→Loaded(i*7).
// fenNativeValScore calls @Runtime fenPickVal then @Runtime fenValScore.

// i=0 → Empty → 0
construct FenValEmpty() extends Test {
    test { return fenNativeValScore(0) }
    expect { let e: Result<Any, TestFailure> = .Ok(0) return e }
}

// i=1 → Loaded(7) → 7
construct FenValLoaded7() extends Test {
    test { return fenNativeValScore(1) }
    expect { let e: Result<Any, TestFailure> = .Ok(7) return e }
}

// i=3 → Loaded(21) → 21
construct FenValLoaded21() extends Test {
    test { return fenNativeValScore(3) }
    expect { let e: Result<Any, TestFailure> = .Ok(21) return e }
}

// i=5 → Loaded(35) → 35
construct FenValLoaded35() extends Test {
    test { return fenNativeValScore(5) }
    expect { let e: Result<Any, TestFailure> = .Ok(35) return e }
}

// ── Tests — Group D: loop churns ─────────────────────────────────────────────
// Many iterations forcing repeated @Native↔@Runtime bridge crossings.

// 12 iters, dir=i%4: 3 full cycles of (1+2+3+4) = 30
construct FenDirLoopSum12() extends Test {
    test { return fenDirLoopSum(12) }
    expect { let e: Result<Any, TestFailure> = .Ok(30) return e }
}

// 9 iters, color=i%3: 3 full cycles of (10+20+30) = 180
construct FenColorLoopSum9() extends Test {
    test { return fenColorLoopSum(9) }
    expect { let e: Result<Any, TestFailure> = .Ok(180) return e }
}

// 8 iters, state=i%4: 2 full cycles of (0+1+2+3) = 12
construct FenStateLoopSum8() extends Test {
    test { return fenStateLoopSum(8) }
    expect { let e: Result<Any, TestFailure> = .Ok(12) return e }
}

// 10 iters, val=fenPickVal(i): even→0, odd→i*7
// odd i in 0..9: 1(7)+3(21)+5(35)+7(49)+9(63) = 175
construct FenValLoopSum10() extends Test {
    test { return fenValLoopSum(10) }
    expect { let e: Result<Any, TestFailure> = .Ok(175) return e }
}

// 4 iters, packets 0..3: 1+7+13+19 = 40
construct FenPacketLoopSum4() extends Test {
    test { return fenPacketLoopSum(4) }
    expect { let e: Result<Any, TestFailure> = .Ok(40) return e }
}

// 8 iters (2 cycles of the same 4 packets): 80
construct FenPacketLoopSum8() extends Test {
    test { return fenPacketLoopSum(8) }
    expect { let e: Result<Any, TestFailure> = .Ok(80) return e }
}

// 4 iters, cells 0..3: 0+20+15+104 = 139
construct FenCellLoopSum4() extends Test {
    test { return fenCellLoopSum(4) }
    expect { let e: Result<Any, TestFailure> = .Ok(139) return e }
}

// 8 iters (2 cycles): 278
construct FenCellLoopSum8() extends Test {
    test { return fenCellLoopSum(8) }
    expect { let e: Result<Any, TestFailure> = .Ok(278) return e }
}

// High-volume: 100 iters of dir, 25 full cycles of (1+2+3+4)=250
construct FenDirHighVolume() extends Test {
    test { return fenDirLoopSum(100) }
    expect { let e: Result<Any, TestFailure> = .Ok(250) return e }
}

// High-volume: 60 iters of color, 20 full cycles of (10+20+30)=1200
construct FenColorHighVolume() extends Test {
    test { return fenColorLoopSum(60) }
    expect { let e: Result<Any, TestFailure> = .Ok(1200) return e }
}
