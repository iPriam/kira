// What `kira lint` checks the kik harness for. Foundation's `Lint.kira`
// declares the vocabulary; `LintRunner.kira` holds what each code looks for.
//
// The harness is linted like any other package, and for a sharper reason than
// most: it is the corpus the compiler is judged against, so it is read far more
// often than it is written. A 1700-line suite is one nobody finds a case in.

import Foundation

// 700 lines is the hard ceiling for every `.kira` and `.ksl` file. A suite that
// outgrows it splits at a section banner, which is where its cases already
// group.
Lint FileLength {
    let code: String = "KLINT003"
    let severity: String = "warning"
    let enabled: Bool = true
    let limit: Int = 700
}

// A variant written with the type it already belongs to. Kira resolves a
// leading dot against the expected type, and `x == .Red` compiles to a tag
// compare with no throwaway enum.
//
// Off here, unlike in the library packages: a test corpus deliberately writes
// the long spelling in places, because the qualified form is itself one of the
// things the compiler has to keep accepting.
Lint QualifiedVariant {
    let code: String = "KLINT001"
    let severity: String = "warning"
    let enabled: Bool = false
}

// A `while` counting an index by hand, where a `for` does it for you. Off for
// the same reason: the corpus tests both spellings on purpose.
Lint ManualIndexLoop {
    let code: String = "KLINT002"
    let severity: String = "warning"
    let enabled: Bool = false
}
