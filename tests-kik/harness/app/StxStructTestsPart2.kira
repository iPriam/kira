import Foundation

// StxStructTests: deep struct tests — construction, field access, methods,
// borrow-mut writeback, value-copy independence, arrays of structs, and traps.
//
// All top-level names use the Stx/stx prefix to avoid harness namespace collisions.
// This file imports Foundation explicitly because imports are file-scoped.

// ---------------------------------------------------------------------------
// Group 4: Value-copy independence
// ---------------------------------------------------------------------------

Test StxCopyXIndep {
    // copy struct, mutate copy.x, original.x unchanged
    test {
        let p = StxPoint { x: 5, y: 3 }
        var q = p
        q.x = 99
        return p.x
    }
    expect { let e: Result<Int, TestFailure> = .Ok(5); return e }
}

Test StxCopyYIndep {
    test {
        let p = StxPoint { x: 5, y: 3 }
        var q = p
        q.y = 77
        return p.y
    }
    expect { let e: Result<Int, TestFailure> = .Ok(3); return e }
}

Test StxCopyBothUnchanged {
    // copy, mutate both fields of copy, original sum unchanged
    test {
        let p = StxPoint { x: 5, y: 3 }
        var q = p
        q.x = 1
        q.y = 1
        return p.x + p.y
    }
    expect { let e: Result<Int, TestFailure> = .Ok(8); return e }
}

Test StxCopyNestedOriginX {
    test {
        let r = StxRect {
            origin: StxPoint { x: 10, y: 20 },
            size: StxPoint { x: 5, y: 5 },
            label: 0
        }
        var r2 = r
        r2.origin.x = 999
        return r.origin.x
    }
    expect { let e: Result<Int, TestFailure> = .Ok(10); return e }
}

Test StxCopyNestedSizeY {
    test {
        let r = StxRect {
            origin: StxPoint { x: 10, y: 20 },
            size: StxPoint { x: 5, y: 5 },
            label: 0
        }
        var r2 = r
        r2.size.y = 888
        return r.size.y
    }
    expect { let e: Result<Int, TestFailure> = .Ok(5); return e }
}

Test StxCopyMutateCopy {
    // original 5, copy gets 100; copy.x + original.x = 105
    test {
        let p = StxPoint { x: 5, y: 5 }
        var q = p
        q.x = 100
        return q.x + p.x
    }
    expect { let e: Result<Int, TestFailure> = .Ok(105); return e }
}

Test StxCopyBorrowMutNoEffect {
    // borrow mut on copy; original.x unchanged
    test {
        let p = StxPoint { x: 3, y: 4 }
        var q = p
        stxBumpX(q)
        return p.x
    }
    expect { let e: Result<Int, TestFailure> = .Ok(3); return e }
}

Test StxCopyLoopIndependence {
    // i=0..4: copy p={i,i}, zero copy.x, acc += p.x = i; sum=0+1+2+3+4=10
    test {
        var acc = 0
        var i = 0
        while i < 5 {
            let p = StxPoint { x: i, y: i }
            var q = p
            q.x = 0
            acc = acc + p.x
            i = i + 1
        }
        return acc
    }
    expect { let e: Result<Int, TestFailure> = .Ok(10); return e }
}

Test StxCopyScaleOriginalUnchanged {
    // scale returns new struct; original p.x unchanged
    test {
        let p = StxPoint { x: 3, y: 5 }
        let q = p.scale(10)
        return p.x
    }
    expect { let e: Result<Int, TestFailure> = .Ok(3); return e }
}

Test StxCopyCubeDepth {
    test {
        let c = StxCube {
            lo: StxPoint { x: 1, y: 2 },
            hi: StxPoint { x: 5, y: 6 },
            depth: 7
        }
        var c2 = c
        c2.depth = 999
        return c.depth
    }
    expect { let e: Result<Int, TestFailure> = .Ok(7); return e }
}

// ---------------------------------------------------------------------------
// Group 5: Arrays of structs
// ---------------------------------------------------------------------------

Test StxArrRead1X {
    // pts[1].x=3
    test {
        var pts: [StxPoint] = []
        pts.append(StxPoint { x: 1, y: 2 })
        pts.append(StxPoint { x: 3, y: 4 })
        pts.append(StxPoint { x: 5, y: 6 })
        return pts[1].x
    }
    expect { let e: Result<Int, TestFailure> = .Ok(3); return e }
}

Test StxArrRead2Y {
    // pts[2].y=6
    test {
        var pts: [StxPoint] = []
        pts.append(StxPoint { x: 1, y: 2 })
        pts.append(StxPoint { x: 3, y: 4 })
        pts.append(StxPoint { x: 5, y: 6 })
        return pts[2].y
    }
    expect { let e: Result<Int, TestFailure> = .Ok(6); return e }
}

Test StxArrSumX {
    // sum pts[i].x for i=0..2 = 1+3+5=9
    test {
        var pts: [StxPoint] = []
        pts.append(StxPoint { x: 1, y: 2 })
        pts.append(StxPoint { x: 3, y: 4 })
        pts.append(StxPoint { x: 5, y: 6 })
        var s = 0
        var i = 0
        while i < pts.count {
            s = s + pts[i].x
            i = i + 1
        }
        return s
    }
    expect { let e: Result<Int, TestFailure> = .Ok(9); return e }
}

Test StxArrForInSumY {
    // for-in: sum pts[i].y for i=0..2 = 2+4+6=12
    test {
        var pts: [StxPoint] = []
        pts.append(StxPoint { x: 1, y: 2 })
        pts.append(StxPoint { x: 3, y: 4 })
        pts.append(StxPoint { x: 5, y: 6 })
        var s = 0
        for p in pts {
            s = s + p.y
        }
        return s
    }
    expect { let e: Result<Int, TestFailure> = .Ok(12); return e }
}

Test StxArrWriteX {
    test {
        var pts: [StxPoint] = []
        pts.append(StxPoint { x: 10, y: 20 })
        pts[0].x = 77
        return pts[0].x
    }
    expect { let e: Result<Int, TestFailure> = .Ok(77); return e }
}

Test StxArrWriteY {
    test {
        var pts: [StxPoint] = []
        pts.append(StxPoint { x: 10, y: 20 })
        pts[0].y = 88
        return pts[0].y
    }
    expect { let e: Result<Int, TestFailure> = .Ok(88); return e }
}

Test StxArrDeepWriteRectOriginX {
    test {
        var rects: [StxRect] = []
        rects.append(StxRect {
            origin: StxPoint { x: 10, y: 20 },
            size: StxPoint { x: 5, y: 5 },
            label: 0
        })
        rects[0].origin.x = 77
        return rects[0].origin.x
    }
    expect { let e: Result<Int, TestFailure> = .Ok(77); return e }
}

Test StxArrDeepWriteRectSizeY {
    test {
        var rects: [StxRect] = []
        rects.append(StxRect {
            origin: StxPoint { x: 0, y: 0 },
            size: StxPoint { x: 5, y: 5 },
            label: 0
        })
        rects.append(StxRect {
            origin: StxPoint { x: 1, y: 1 },
            size: StxPoint { x: 3, y: 3 },
            label: 1
        })
        rects[1].size.y = 44
        return rects[1].size.y
    }
    expect { let e: Result<Int, TestFailure> = .Ok(44); return e }
}

Test StxArrMixedWrites {
    // 4 pts, write to specific fields, sum=10+20+30+40=100
    test {
        var pts: [StxPoint] = []
        pts.append(StxPoint { x: 0, y: 0 })
        pts.append(StxPoint { x: 0, y: 0 })
        pts.append(StxPoint { x: 0, y: 0 })
        pts.append(StxPoint { x: 0, y: 0 })
        pts[0].x = 10
        pts[1].y = 20
        pts[2].x = 30
        pts[3].y = 40
        return pts[0].x + pts[1].y + pts[2].x + pts[3].y
    }
    expect { let e: Result<Int, TestFailure> = .Ok(100); return e }
}

Test StxArrLoop100 {
    // 100 pts where x=i, y=100-i; sum of p.sum()=100 each; total=10000
    test {
        var pts: [StxPoint] = []
        var i = 0
        while i < 100 {
            pts.append(StxPoint { x: i, y: 100 - i })
            i = i + 1
        }
        var acc = 0
        var j = 0
        while j < pts.count {
            acc = acc + pts[j].sum()
            j = j + 1
        }
        return acc
    }
    expect { let e: Result<Int, TestFailure> = .Ok(10000); return e }
}

Test StxArrCount {
    // append 7 pts, count=7
    test {
        var pts: [StxPoint] = []
        var i = 0
        while i < 7 {
            pts.append(StxPoint { x: i, y: 0 })
            i = i + 1
        }
        return pts.count
    }
    expect { let e: Result<Int, TestFailure> = .Ok(7); return e }
}

Test StxArrForInMethodSum {
    // i=0..4: p={x:i, y:i*2}, p.sum()=3i; total=0+3+6+9+12=30
    test {
        var pts: [StxPoint] = []
        var i = 0
        while i < 5 {
            pts.append(StxPoint { x: i, y: i * 2 })
            i = i + 1
        }
        var acc = 0
        for p in pts {
            acc = acc + p.sum()
        }
        return acc
    }
    expect { let e: Result<Int, TestFailure> = .Ok(30); return e }
}

Test StxArrAfterDeepWrite {
    // pts=[{x:1},{x:2},{x:3}], set pts[1].x=50, sum x = 1+50+3=54
    test {
        var pts: [StxPoint] = []
        pts.append(StxPoint { x: 1, y: 0 })
        pts.append(StxPoint { x: 2, y: 0 })
        pts.append(StxPoint { x: 3, y: 0 })
        pts[1].x = 50
        var s = 0
        var i = 0
        while i < pts.count {
            s = s + pts[i].x
            i = i + 1
        }
        return s
    }
    expect { let e: Result<Int, TestFailure> = .Ok(54); return e }
}

Test StxArrTrapEmpty {
    test {
        var pts: [StxPoint] = []
        return pts[0].x
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Runtime("")); return e }
}

Test StxArrTrapOOB {
    test {
        var pts: [StxPoint] = []
        pts.append(StxPoint { x: 1, y: 2 })
        return pts[99].x
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Runtime("")); return e }
}

// ---------------------------------------------------------------------------
// Group 6: StxBag (struct with array field)
// ---------------------------------------------------------------------------

Test StxBagTotal5 {
    // stxMakeBag(5): tag=5, items=[1,2,3,4,5], total=5+15=20
    test {
        var b = stxMakeBag(5)
        return b.total()
    }
    expect { let e: Result<Int, TestFailure> = .Ok(20); return e }
}

Test StxBagTotal0 {
    // stxMakeBag(0): tag=0, items=[], total=0
    test {
        var b = stxMakeBag(0)
        return b.total()
    }
    expect { let e: Result<Int, TestFailure> = .Ok(0); return e }
}

Test StxBagCount10 {
    test {
        var b = stxMakeBag(10)
        return b.count()
    }
    expect { let e: Result<Int, TestFailure> = .Ok(10); return e }
}

Test StxBagItems2 {
    // stxMakeBag(5).items=[1,2,3,4,5], items[2]=3
    test {
        var b = stxMakeBag(5)
        return b.items[2]
    }
    expect { let e: Result<Int, TestFailure> = .Ok(3); return e }
}

Test StxBagTag {
    test {
        var b = stxMakeBag(5)
        return b.tag
    }
    expect { let e: Result<Int, TestFailure> = .Ok(5); return e }
}

Test StxBagTotal1 {
    // stxMakeBag(1): tag=1, items=[1], total=2
    test {
        var b = stxMakeBag(1)
        return b.total()
    }
    expect { let e: Result<Int, TestFailure> = .Ok(2); return e }
}

Test StxBagTotal3 {
    // stxMakeBag(3): tag=3, items=[1,2,3], total=9
    test {
        var b = stxMakeBag(3)
        return b.total()
    }
    expect { let e: Result<Int, TestFailure> = .Ok(9); return e }
}

Test StxBagLoopTotal {
    // n=1..5: total(n)=n+n*(n+1)/2 → 2+5+9+14+20=50
    test {
        var acc = 0
        var n = 1
        while n <= 5 {
            var b = stxMakeBag(n)
            acc = acc + b.total()
            n = n + 1
        }
        return acc
    }
    expect { let e: Result<Int, TestFailure> = .Ok(50); return e }
}

Test StxBagItems0 {
    // stxMakeBag(3).items[0]=1
    test {
        var b = stxMakeBag(3)
        return b.items[0]
    }
    expect { let e: Result<Int, TestFailure> = .Ok(1); return e }
}

Test StxBagItems1 {
    // stxMakeBag(3).items[1]=2
    test {
        var b = stxMakeBag(3)
        return b.items[1]
    }
    expect { let e: Result<Int, TestFailure> = .Ok(2); return e }
}

// ---------------------------------------------------------------------------
// Group 7: Trap tests
// ---------------------------------------------------------------------------

Test StxTrapDivZeroField {
    // p.x / p.y where p.y=0 → trap
    test {
        let p = StxPoint { x: 5, y: 0 }
        return p.x / p.y
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Runtime("")); return e }
}

Test StxTrapModZero {
    test { return 7 % 0 }
    expect { let e: Result<Int, TestFailure> = .Error(.Runtime("")); return e }
}

Test StxTrapDivZeroConst {
    test { return 1 / 0 }
    expect { let e: Result<Int, TestFailure> = .Error(.Runtime("")); return e }
}

Test StxTrapArrLargeIndex {
    test {
        var pts: [StxPoint] = []
        pts.append(StxPoint { x: 1, y: 2 })
        pts.append(StxPoint { x: 3, y: 4 })
        return pts[99].x
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Runtime("")); return e }
}

Test StxTrapDeepWriteOOB {
    test {
        var rects: [StxRect] = []
        rects.append(StxRect {
            origin: StxPoint { x: 0, y: 0 },
            size: StxPoint { x: 5, y: 5 },
            label: 1
        })
        return rects[5].label
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Runtime("")); return e }
}

Test StxTrapBagOOB {
    test {
        var b = stxMakeBag(3)
        return b.items[99]
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Runtime("")); return e }
}

Test StxTrapModZeroField {
    test {
        let p = StxPoint { x: 5, y: 0 }
        return p.x % p.y
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Runtime("")); return e }
}
