// Recursion tests
// ---------------------------------------------------------------------------

construct CfxRecursionFactorial5() extends Test {
    test { return cfxFactorial(5) }
    expect { let e: Result<Any, TestFailure> = .Ok(120) return e }
}

construct CfxRecursionFactorial10() extends Test {
    test { return cfxFactorial(10) }
    expect { let e: Result<Any, TestFailure> = .Ok(3628800) return e }
}

construct CfxRecursionFib10() extends Test {
    test { return cfxFib(10) }
    expect { let e: Result<Any, TestFailure> = .Ok(55) return e }
}

construct CfxRecursionFib15() extends Test {
    test { return cfxFib(15) }
    expect { let e: Result<Any, TestFailure> = .Ok(610) return e }
}

construct CfxRecursionFib20() extends Test {
    test { return cfxFib(20) }
    expect { let e: Result<Any, TestFailure> = .Ok(6765) return e }
}

construct CfxRecursionGcd() extends Test {
    test { return cfxGcd(48, 18) }
    expect { let e: Result<Any, TestFailure> = .Ok(6) return e }
}

construct CfxRecursionGcdCoprime() extends Test {
    test { return cfxGcd(17, 13) }
    expect { let e: Result<Any, TestFailure> = .Ok(1) return e }
}

construct CfxRecursionGcdLarge() extends Test {
    test { return cfxGcd(1071, 462) }
    expect { let e: Result<Any, TestFailure> = .Ok(21) return e }
}

construct CfxRecursionTriangle() extends Test {
    test { return cfxTriangle(10) }
    // 55
    expect { let e: Result<Any, TestFailure> = .Ok(55) return e }
}

construct CfxRecursionTriangle50() extends Test {
    test { return cfxTriangle(50) }
    // 1275
    expect { let e: Result<Any, TestFailure> = .Ok(1275) return e }
}

construct CfxMutualRecursionEven() extends Test {
    test { return cfxIsEven(20) }
    expect { let e: Result<Any, TestFailure> = .Ok(true) return e }
}

construct CfxMutualRecursionOdd() extends Test {
    test { return cfxIsOdd(15) }
    expect { let e: Result<Any, TestFailure> = .Ok(true) return e }
}

construct CfxMutualRecursionEvenFalse() extends Test {
    test { return cfxIsEven(7) }
    expect { let e: Result<Any, TestFailure> = .Ok(false) return e }
}

construct CfxRecursionPow() extends Test {
    test { return cfxPow(3, 10) }
    // 59049
    expect { let e: Result<Any, TestFailure> = .Ok(59049) return e }
}

construct CfxRecursionDigitSum() extends Test {
    test { return cfxDigitSum(123456789) }
    // 1+2+3+4+5+6+7+8+9 = 45
    expect { let e: Result<Any, TestFailure> = .Ok(45) return e }
}

construct CfxRecursionSumRange() extends Test {
    test { return cfxSumRange(1, 50) }
    // 1275
    expect { let e: Result<Any, TestFailure> = .Ok(1275) return e }
}

construct CfxRecursionCountDiv() extends Test {
    test { return cfxCountDiv(100, 7) }
    // floor(100/7) = 14
    expect { let e: Result<Any, TestFailure> = .Ok(14) return e }
}

// ---------------------------------------------------------------------------
// Early-return patterns
// ---------------------------------------------------------------------------

construct CfxEarlyReturnFromBranch() extends Test {
    test {
        var i = 0
        while i < 100 {
            if i * i >= 200 {
                return i
            }
            i = i + 1
        }
        return 0 - 1
    }
    // i=15: 225>=200 => 15
    expect { let e: Result<Any, TestFailure> = .Ok(15) return e }
}

construct CfxEarlyReturnSwitch() extends Test {
    test {
        var i = 0
        while i < 50 {
            var hit = false
            if (i % 7) == 0 {
                hit = true
            } else {
                hit = false
            }
            if hit && i > 0 {
                return i
            }
            i = i + 1
        }
        return 0 - 1
    }
    // first positive multiple of 7 = 7
    expect { let e: Result<Any, TestFailure> = .Ok(7) return e }
}

construct CfxEarlyReturnForIn() extends Test {
    test {
        let xs: [Int] = [3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5]
        for v in xs {
            if v > 7 {
                return v
            }
        }
        return 0 - 1
    }
    // 9 is first > 7
    expect { let e: Result<Any, TestFailure> = .Ok(9) return e }
}

