import Foundation

// Enums: payload-less and single-payload variants, exhaustive match with
// payload binding, generic Result<T, E>, and linear attempt/try/handle.

enum EnShade {
    Light
    Dark
    Mid
}

enum EnNode {
    Leaf(Int)
    Tagged(Int)
    Empty
}

enum EnMathError {
    DivByZero
    Negative
}

function enShadeWeight(s: borrow EnShade) -> Int {
    match s {
        Light -> { return 1 }
        Dark -> { return 2 }
        Mid -> { return 3 }
    }
}

function enNodeValue(n: borrow EnNode) -> Int {
    match n {
        Leaf(v) -> { return v }
        Tagged(v) -> { return v * 10 }
        Empty -> { return 0 }
    }
}

function enSafeDiv(a: Int, b: Int) -> Result<Int, EnMathError> {
    if b == 0 {
        return .Error(.DivByZero)
    }
    if a < 0 {
        return .Error(.Negative)
    }
    return .Ok(a / b)
}

function enErrCode(e: borrow EnMathError) -> Int {
    match e {
        DivByZero -> { return 0 - 1 }
        Negative -> { return 0 - 2 }
    }
}

function enChain(a: Int, b: Int, c: Int) -> Int {
    let r1 = enSafeDiv(a, b)
    match r1 {
        Ok(x) -> {
            let r2 = enSafeDiv(x, c)
            match r2 {
                Ok(y) -> { return x + y }
                Error(e) -> { return enErrCode(e) }
            }
        }
        Error(e) -> { return enErrCode(e) }
    }
}

function enumsPayloadlessSection() -> Int {
    var acc = 0
    var i = 0
    while i < 60 {
        let s = enShadeFor(i)
        acc = acc + enShadeWeight(s)
        i = i + 1
    }
    return acc
}

function enumsSinglePayloadSection() -> Int {
    var acc = 0
    var j = 0
    while j < 50 {
        let n = enNodeFor(j)
        acc = acc + enNodeValue(n)
        j = j + 1
    }
    return acc
}

function enumsResultSection() -> Int {
    var acc = 0
    acc = acc + enChain(100, 5, 2)
    acc = acc + enChain(100, 0, 2)
    acc = acc + enChain(0 - 4, 2, 1)
    return acc
}

// Native drop-elaboration leak-guard churn (types live in
// runparity/EmxTests.kira; app/ is one flat package). Each loop leaks
// per-iteration on the LLVM binary if typed enum teardown regresses, so the
// harness leak run catches it while these checksums pin exact parity phases.
function enumsStringPayloadChurnSection() -> Int {
    var acc = 0
    var k = 0
    while k < 40 {
        let tags: [EmxTag] = [.Named("a" + "b"), .Anon, .Named("c" + "d")]
        let bag = EmxBag { tags: move tags }
        acc = acc + emxCountNamed(bag)
        k = k + 1
    }
    return acc
}

function enumsStructPayloadChurnSection() -> Int {
    var acc = 0
    var m = 0
    while m < 40 {
        let card = EmxCard()
        acc = acc + emxPaintScore(card.paint)
        var e = 0
        while e < card.effects.count {
            acc = acc + emxPaintScore(card.effects[e])
            e = e + 1
        }
        m = m + 1
    }
    return acc
}

function enumsConstructAnyChurnSection() -> Int {
    var acc = 0
    var q = 0
    while q < 40 {
        let cells: [EmxCell] = [.Filled(EmxCircle(r: 3)), .Empty, .Filled(EmxSquare(s: 4))]
        let grid = EmxGrid { cells: move cells }
        acc = acc + grid.cells.count + emxTotalArea(grid)
        q = q + 1
    }
    return acc
}

// NOTE: these intentionally return the enum directly from each branch. The
// `var s = .X; s = .Y; return s` form (a mutable enum local
// reassigned, then returned) miscompiles on the LLVM backend — see
// FINDINGS.md (#1) and known-bugs/llvm_enum_var_local.
function enShadeFor(i: Int) -> EnShade {
    if (i % 3) == 0 {
        return .Light
    } else if (i % 3) == 1 {
        return .Dark
    } else if (i % 3) == 2 {
        return .Mid
    } else {
        return .Light
    }
}

function enNodeFor(j: Int) -> EnNode {
    if (j % 3) == 0 {
        return .Leaf(j)
    } else if (j % 3) == 1 {
        return .Tagged(j)
    } else if (j % 3) == 2 {
        return .Empty
    } else {
        return .Empty
    }
}
