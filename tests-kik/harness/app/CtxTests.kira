import Foundation

// CtxTests.kira
// Migrated from tests/pass/run/{if_basic_parity, if_condition_trailing_call,
// for_basic_parity, for_binding_parity, for_empty_parity, for_stateful_parity,
// switch_basic_parity, empty_control_flow_bodies}.
// All top-level names use prefix ctx / Ctx.

// ---------------------------------------------------------------------------
// Helpers (from if_condition_trailing_call)
// ---------------------------------------------------------------------------

function ctxSyllable(a: Int, b: Int) -> Int {
    return a * 27 + b
}

function ctxApply(cb: () -> Int) -> Int {
    return cb()
}

function ctxIsPositive(value: Int) -> Bool {
    return value > 0
}

// ---------------------------------------------------------------------------
// Struct (from empty_control_flow_bodies)
// ---------------------------------------------------------------------------

struct CtxEcfP { var ok: Bool }

// ---------------------------------------------------------------------------
// if_basic_parity
// ---------------------------------------------------------------------------

Test CtxIfBasic {
    test {
        let value = 2
        var out = ""
        if value == 2 {
            out = "if-then"
        } else {
            out = "if-else"
        }
        return out
    }

    expect { let e: Result<String, TestFailure> = .Ok("if-then"); return e }
}

// ---------------------------------------------------------------------------
// if_condition_trailing_call
// ---------------------------------------------------------------------------

Test CtxIfConditionTrailingCall {
    test {
        var out = ""
        let key = ctxSyllable(14, 9)

        if key == ctxSyllable(14, 9) {
            out = out + "1"
        }

        var n = 0
        while n == ctxSyllable(0, 0) {
            out = out + "2"
            n = 1
        }

        if ctxIsPositive(key) {
            out = out + "3"
        }

        if ctxApply({ in return 5 }) == 5 {
            out = out + "4"
        }

        return out
    }

    expect { let e: Result<String, TestFailure> = .Ok("1234"); return e }
}

// ---------------------------------------------------------------------------
// for_basic_parity
// ---------------------------------------------------------------------------

Test CtxForBasic {
    test {
        var out = 0
        for item in [10, 20, 30] {
            out = out + 1
        }
        return out
    }

    expect { let e: Result<Int, TestFailure> = .Ok(3); return e }
}

// ---------------------------------------------------------------------------
// for_binding_parity
// ---------------------------------------------------------------------------

Test CtxForBinding {
    test {
        var total = 0
        for item in [1, 2, 3] {
            total = total + item
        }
        return total
    }

    expect { let e: Result<Int, TestFailure> = .Ok(6); return e }
}

// ---------------------------------------------------------------------------
// for_empty_parity
// ---------------------------------------------------------------------------

Test CtxForEmpty {
    test {
        var out = 0
        for item in [] {
            out = out + 1
        }
        out = out + 100
        return out
    }

    expect { let e: Result<Int, TestFailure> = .Ok(100); return e }
}

// ---------------------------------------------------------------------------
// for_stateful_parity
// ---------------------------------------------------------------------------

Test CtxForStateful {
    test {
        var total = 0
        var out = ""
        for item in [1, 1, 1] {
            total = total + 1
            switch total {
                case 1 {
                    out = out + "one,"
                }
                case 2 {
                    out = out + "two,"
                }
                default {
                    out = out + "other,"
                }
            }
        }
        if total == 3 {
            out = out + "done"
        } else {
            out = out + "broken"
        }
        return out
    }

    expect { let e: Result<String, TestFailure> = .Ok("one,two,other,done"); return e }
}

// ---------------------------------------------------------------------------
// switch_basic_parity
// ---------------------------------------------------------------------------

Test CtxSwitchBasic {
    test {
        var out = ""
        switch 2 {
            case 1 {
                out = "one"
            }
            case 2 {
                out = "two"
            }
            default {
                out = "other"
            }
        }
        return out
    }

    expect { let e: Result<String, TestFailure> = .Ok("two"); return e }
}

// ---------------------------------------------------------------------------
// empty_control_flow_bodies
// ---------------------------------------------------------------------------

Test CtxEmptyControlFlowBodies {
    test {
        var n = 0
        if true {
        }
        while false {
        }
        for x in [1, 2, 3] {
        }
        switch n {
            case 0 { }
            default { }
        }
        for p in [CtxEcfP { ok: true }, CtxEcfP { ok: false }] {
            if p.ok {
                n = n + 1
            }
        }
        if (CtxEcfP { ok: true }).ok {
            n = n + 10
        }
        return n
    }

    expect { let e: Result<Int, TestFailure> = .Ok(11); return e }
}
