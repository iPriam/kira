// ---- partial_move_disjoint_fields ----

struct OwyPair18 {
    let a: [Int]
    let b: [Int]
}

function owySink18(values: [Int]) -> Int {
    var sum = 0
    for index in 0..values.count {
        sum = sum + values[index]
    }
    return sum
}

function owyConsume18(pair: OwyPair18) -> Int {
    let left = owySink18(move pair.a)
    let right = owySink18(move pair.b)
    return left + right
}

construct OwyPartialMoveDisjointFields() extends Test {
    test {
        let pair = OwyPair18 {
            a: [1, 2, 3],
            b: [10, 20]
        }
        return owyConsume18(move pair)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(36) return e }
}

// ---- mid_ir_disjoint_struct_field_borrows ----

struct OwyCell19 { var value: Int }
struct OwyPairCell19 { var left: OwyCell19 var right: OwyCell19 }

function owyUpdateBoth19(a: borrow mut OwyCell19, b: borrow mut OwyCell19) {
    a.value = a.value + 10
    b.value = b.value + 20
    return
}

construct OwyMidIrDisjointStructFieldBorrows() extends Test {
    test {
        var pair = OwyPairCell19 { left: OwyCell19 { value: 1 }, right: OwyCell19 { value: 2 } }
        owyUpdateBoth19(pair.left, pair.right)
        return pair.left.value * 100 + pair.right.value
    }
    expect { let e: Result<Any, TestFailure> = .Ok(1122) return e }
}

// ---- consuming_nested_field_receiver_parity ----

construct OwyWidget23 {
    @Required let body: Any OwyWidget23

    @Consuming
    function render() -> [String] {
        return body.render()
    }
}

construct OwyLeaf23(text: String) extends OwyWidget23 {
    function render() -> [String] {
        return [text]
    }
}

struct OwyInner23 {
    var child: some OwyWidget23
}

struct OwyOuter23 {
    var inner: OwyInner23
}

function owyBuild23(tag: Int) -> some OwyWidget23 {
    return OwyLeaf23(text: "n")
}

function owyConsume23(outer: OwyOuter23) -> Int {
    let lines = outer.inner.child.render()
    return lines.count
}

construct OwyConsumingNestedFieldReceiverParity() extends Test {
    test {
        var round = 0
        var total = 0
        while round < 10 {
            let outer = OwyOuter23 { inner: OwyInner23 { child: owyBuild23(round) } }
            total = total + owyConsume23(move outer)
            round = round + 1
        }
        return total
    }
    expect { let e: Result<Any, TestFailure> = .Ok(10) return e }
}

// ---- consuming_nested_indexed_receiver_parity ----

construct OwyWidget24 {
    @Required let body: Any OwyWidget24

    @Consuming
    function render() -> [String] {
        return body.render()
    }
}

construct OwyLeaf24(text: String) extends OwyWidget24 {
    function render() -> [String] {
        return [text]
    }
}

function owyBuild24(tag: Int) -> some OwyWidget24 {
    return OwyLeaf24(text: "n")
}

struct OwyInner24 {
    var children: [some OwyWidget24]
}

struct OwyOuter24 {
    var inner: OwyInner24
}

function owyRenderNested24(outer: OwyOuter24) -> Int {
    var total = 0
    for i in 0..outer.inner.children.count {
        let lines = outer.inner.children[i].render()
        total = total + lines.count
    }
    return total
}

construct OwyConsumingNestedIndexedReceiverParity() extends Test {
    test {
        var round = 0
        var total = 0
        while round < 10 {
            var kids: [some OwyWidget24] = []
            kids.append(owyBuild24(round))
            kids.append(owyBuild24(round + 1))
            let outer = OwyOuter24 { inner: OwyInner24 { children: move kids } }
            total = total + owyRenderNested24(move outer)
            round = round + 1
        }
        return total
    }
    expect { let e: Result<Any, TestFailure> = .Ok(20) return e }
}
