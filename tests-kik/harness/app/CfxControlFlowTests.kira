import Foundation

// CfxControlFlowTests.kira
// Deep control-flow test suite: nested if/else, while, for-in, match,
// early return, recursion, and trap tests.
// All top-level names use prefix cfx / Cfx.

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum CfxColor {
    Red
    Green
    Blue
}

enum CfxShape {
    Circle(Int)
    Rect(Int)
    Point
}

enum CfxSign {
    Pos(Int)
    Neg(Int)
    Zero
}

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

function cfxColorCode(c: borrow CfxColor) -> Int {
    match c {
        Red -> { return 1 }
        Green -> { return 2 }
        Blue -> { return 4 }
    }
}

function cfxShapeArea(s: borrow CfxShape) -> Int {
    match s {
        Circle(r) -> { return r * r }
        Rect(side) -> { return side * side * 2 }
        Point -> { return 0 }
    }
}

function cfxSignVal(s: borrow CfxSign) -> Int {
    match s {
        Pos(v) -> { return v }
        Neg(v) -> { return 0 - v }
        Zero -> { return 0 }
    }
}

function cfxFactorial(n: Int) -> Int {
    if n <= 1 {
        return 1 }
    return n * cfxFactorial(n - 1)
}

function cfxFib(n: Int) -> Int {
    if n < 2 {
        return n }
    return cfxFib(n - 1) + cfxFib(n - 2)
}

function cfxGcd(a: Int, b: Int) -> Int {
    var x = a
    var y = b
    while y != 0 {
        let t = x % y
        x = y
        y = t
    }
    return x
}

function cfxSumRange(lo: Int, hi: Int) -> Int {
    var s = 0
    var i = lo
    while i <= hi {
        s = s + i
        i = i + 1
    }
    return s
}

function cfxPow(base: Int, exp: Int) -> Int {
    var r = 1
    var i = 0
    while i < exp {
        r = r * base
        i = i + 1
    }
    return r
}

function cfxIsEven(n: Int) -> Bool {
    if n == 0 {
        return true }
    return cfxIsOdd(n - 1)
}

function cfxIsOdd(n: Int) -> Bool {
    if n == 0 {
        return false }
    return cfxIsEven(n - 1)
}

function cfxTriangle(n: Int) -> Int {
    if n <= 0 {
        return 0 }
    return n + cfxTriangle(n - 1)
}

function cfxDigitSum(n: Int) -> Int {
    var v = n
    var s = 0
    while v > 0 {
        s = s + (v % 10)
        v = v / 10
    }
    return s
}

function cfxCountDiv(n: Int, d: Int) -> Int {
    var count = 0
    var i = 1
    while i <= n {
        if i % d == 0 {
            count = count + 1 }
        i = i + 1
    }
    return count
}

function cfxSwitchBand(x: Int) -> Int {
    var out = 0
    if x == 0 {
        out = 10
    } else if x == 1 {
        out = 20
    } else if x == 2 {
        out = 30
    } else if x == 3 {
        out = 40
    } else if x == 4 {
        out = 50
    } else if x == 5 {
        out = 60
    } else if x == 6 {
        out = 70
    } else if x == 7 {
        out = 80
    } else if x == 8 {
        out = 90
    } else if x == 9 {
        out = 100
    } else {
        out = 0
    }
    return out
}

// ---------------------------------------------------------------------------
// Nested if/else tests
// ---------------------------------------------------------------------------

construct CfxIfElseSimple() extends Test {
    test {
        var x = 5
        var out = 0
        if x > 3 {
            out = 1 } else { out = 2 }
        return out
    }
    expect { let e: Result<Int, TestFailure> = .Ok(1); return e }
}

construct CfxIfElseFalse() extends Test {
    test {
        var x = 2
        var out = 0
        if x > 3 {
            out = 1 } else { out = 2 }
        return out
    }
    expect { let e: Result<Int, TestFailure> = .Ok(2); return e }
}

construct CfxIfElseIfChain() extends Test {
    test {
        var score = 75
        var grade = 0
        if score >= 90 {
            grade = 4
        } else if score >= 80 {
            grade = 3
        } else if score >= 70 {
            grade = 2
        } else if score >= 60 {
            grade = 1
        } else {
            grade = 0
        }
        return grade
    }
    expect { let e: Result<Int, TestFailure> = .Ok(2); return e }
}

construct CfxIfElseIfChainTop() extends Test {
    test {
        var score = 95
        var grade = 0
        if score >= 90 {
            grade = 4
        } else if score >= 80 {
            grade = 3
        } else if score >= 70 {
            grade = 2
        } else if score >= 60 {
            grade = 1
        } else {
            grade = 0
        }
        return grade
    }
    expect { let e: Result<Int, TestFailure> = .Ok(4); return e }
}

construct CfxIfElseIfChainBottom() extends Test {
    test {
        var score = 40
        var grade = 0
        if score >= 90 {
            grade = 4
        } else if score >= 80 {
            grade = 3
        } else if score >= 70 {
            grade = 2
        } else if score >= 60 {
            grade = 1
        } else {
            grade = 0
        }
        return grade
    }
    expect { let e: Result<Int, TestFailure> = .Ok(0); return e }
}

construct CfxDeeplyNestedIf() extends Test {
    test {
        var a = 3
        var b = 7
        var c = 2
        var out = 0
        if a < b {
            if b > c {
                if a != c {
                    if (a + c) < b {
                        out = 999
                    } else {
                        out = 888
                    }
                } else {
                    out = 777
                }
            } else {
                out = 666
            }
        } else {
            out = 555
        }
        return out
    }
    // a=3,b=7,c=2: a<b T; b>c T; a!=c T; a+c=5 < b=7 T => 999
    expect { let e: Result<Int, TestFailure> = .Ok(999); return e }
}

construct CfxIfCountEvenOdd() extends Test {
    test {
        var evens = 0
        var odds = 0
        var i = 0
        while i < 20 {
            if i % 2 == 0 {
                evens = evens + 1 } else { odds = odds + 1 }
            i = i + 1
        }
        return evens * 100 + odds
    }
    // 0..19: 10 evens, 10 odds
    expect { let e: Result<Int, TestFailure> = .Ok(1010); return e }
}

construct CfxIfNestedAccumulate() extends Test {
    test {
        var acc = 0
        var i = 0
        while i < 10 {
            if i > 3 {
                if i < 7 {
                    acc = acc + i
                }
            }
            i = i + 1
        }
        // i in 4,5,6 => 15
        return acc
    }
    expect { let e: Result<Int, TestFailure> = .Ok(15); return e }
}

construct CfxIfBoolExprComplex() extends Test {
    test {
        var count = 0
        var i = 0
        while i < 30 {
            let a = i % 2 == 0
            let b = i % 3 == 0
            if (a && b) || (!a && !b) {
                count = count + 1 }
            i = i + 1
        }
        // i%2==0 && i%3==0: multiples of 6 in 0..29: 0,6,12,18,24 = 5
        // !a && !b: odd and not mult of 3 in 0..29: 1,5,7,11,13,17,19,23,25,29 = 10
        // total = 15
        return count
    }
    expect { let e: Result<Int, TestFailure> = .Ok(15); return e }
}

construct CfxIfElseTernaryMix() extends Test {
    test {
        var acc = 0
        var i = 0
        while i < 10 {
            var v = 0
            if i % 2 == 0 {
                v = i * 3
            } else {
                v = 0 - i
            }
            acc = acc + v
            i = i + 1
        }
        // i=0: 0, i=1:-1, i=2:6, i=3:-3, i=4:12, i=5:-5, i=6:18, i=7:-7, i=8:24, i=9:-9
        // sum = 0-1+6-3+12-5+18-7+24-9 = 35
        return acc
    }
    expect { let e: Result<Int, TestFailure> = .Ok(35); return e }
}

// ---------------------------------------------------------------------------
// while loop tests
// ---------------------------------------------------------------------------

construct CfxWhileCountdown() extends Test {
    test {
        var n = 10
        var steps = 0
        while n > 0 {
            n = n - 1
            steps = steps + 1
        }
        return steps
    }
    expect { let e: Result<Int, TestFailure> = .Ok(10); return e }
}

construct CfxWhileAccumulate() extends Test {
    test {
        var sum = 0
        var i = 1
        while i <= 100 {
            sum = sum + i
            i = i + 1
        }
        return sum
    }
    expect { let e: Result<Int, TestFailure> = .Ok(5050); return e }
}

construct CfxWhileMultiply() extends Test {
    test {
        var prod = 1
        var i = 1
        while i <= 10 {
            prod = prod * i
            i = i + 1
        }
        return prod
    }
    // 10! = 3628800
    expect { let e: Result<Int, TestFailure> = .Ok(3628800); return e }
}

construct CfxWhileEarlyReturn() extends Test {
    test {
        var i = 0
        while i < 1000 {
            if i * i > 500 {
                return i
            }
            i = i + 1
        }
        return 0 - 1
    }
    // i=23: 23*23=529 > 500 => return 23
    expect { let e: Result<Int, TestFailure> = .Ok(23); return e }
}

construct CfxWhileNestedSum() extends Test {
    test {
        var total = 0
        var i = 1
        while i <= 5 {
            var j = 1
            while j <= 5 {
                total = total + i * j
                j = j + 1
            }
            i = i + 1
        }
        // (1+2+3+4+5)^2 = 15^2 = 225
        return total
    }
    expect { let e: Result<Int, TestFailure> = .Ok(225); return e }
}

construct CfxWhileNestedSkip() extends Test {
    test {
        var count = 0
        var i = 0
        while i < 8 {
            var j = 0
            while j < 8 {
                if i != j {
                    count = count + 1
                }
                j = j + 1
            }
            i = i + 1
        }
        // 8*8 - 8 = 56
        return count
    }
    expect { let e: Result<Int, TestFailure> = .Ok(56); return e }
}

construct CfxWhileNestedMatrix() extends Test {
    test {
        var acc = 0
        var r = 0
        while r < 4 {
            var c = 0
            while c < 4 {
                acc = acc + r * 4 + c
                c = c + 1
            }
            r = r + 1
        }
        // sum 0..15 = 120
        return acc
    }
    expect { let e: Result<Int, TestFailure> = .Ok(120); return e }
}

construct CfxWhileTripleNested() extends Test {
    test {
        var acc = 0
        var a = 0
        while a < 3 {
            var b = 0
            while b < 3 {
                var c = 0
                while c < 3 {
                    acc = acc + a + b + c
                    c = c + 1
                }
                b = b + 1
            }
            a = a + 1
        }
        // each of a,b,c contributes sum over 3*3=9 times: 9*(0+1+2)=27 each, total=81
        return acc
    }
    expect { let e: Result<Int, TestFailure> = .Ok(81); return e }
}

construct CfxWhileCountDivisibleBy7() extends Test {
    test {
        var count = 0
        var i = 1
        while i <= 100 {
            if i % 7 == 0 {
                count = count + 1 }
            i = i + 1
        }
        return count
    }
    // floor(100/7) = 14
    expect { let e: Result<Int, TestFailure> = .Ok(14); return e }
}

construct CfxWhileSumSquares() extends Test {
    test {
        var s = 0
        var i = 1
        while i <= 10 {
            s = s + i * i
            i = i + 1
        }
        // 1+4+9+16+25+36+49+64+81+100 = 385
        return s
    }
    expect { let e: Result<Int, TestFailure> = .Ok(385); return e }
}

construct CfxWhileCollatz() extends Test {
    test {
        var n = 27
        var steps = 0
        while n != 1 {
            if n % 2 == 0 {
                n = n / 2
            } else {
                n = n * 3 + 1
            }
            steps = steps + 1
        }
        return steps
    }
    // Collatz(27) = 111 steps
    expect { let e: Result<Int, TestFailure> = .Ok(111); return e }
}

construct CfxWhileCountUp() extends Test {
    test {
        var n = 0
        var steps = 0
        while n < 50 {
            n = n + 3
            steps = steps + 1
        }
        // n goes: 3,6,...,48,51 => 17 steps
        return steps
    }
    expect { let e: Result<Int, TestFailure> = .Ok(17); return e }
}

