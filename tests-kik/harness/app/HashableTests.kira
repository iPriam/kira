import Foundation

// Hashing folds a deterministic FNV-1a from every field. The native `hash(...)`
// walks a value's shape with no `@Derive`, and these tests keep the value-level
// contract in the Kira harness rather than proving it only through generated
// Rust or macro snapshots.

struct HxInner {
    var id: Int
}

struct HxRecord {
    var id: Int
    var name: String
    var enabled: Bool
    var inner: HxInner
}

construct HxEqualRecordsHashTheSame() extends Test {
    test {
        let left = HxRecord {
            id: 7,
            name: "same",
            enabled: true,
            inner: HxInner { id: 11 }
        }
        let right = HxRecord {
            id: 7,
            name: "same",
            enabled: true,
            inner: HxInner { id: 11 }
        }
        return hash(left) == hash(right)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(true) return e }
}

construct HxEveryFieldChangesTheFold() extends Test {
    test {
        let base = HxRecord {
            id: 7,
            name: "same",
            enabled: true,
            inner: HxInner { id: 11 }
        }
        let changed = HxRecord {
            id: 8,
            name: "same",
            enabled: true,
            inner: HxInner { id: 11 }
        }
        return hash(base) != hash(changed)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(true) return e }
}

construct HxNestedFieldsUseTheirOwnDerive() extends Test {
    test {
        let first = HxInner { id: 1 }
        let second = HxInner { id: 2 }
        return hash(first) != hash(second)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(true) return e }
}
