import Foundation

// SgxTests.kira — migrated corpus cases from tests/pass/run/{string_*,call_*}.
// PREFIX: sgx / Sgx (all top-level names use this prefix).
// This file imports Foundation (imports are file-scoped); Test/Result/TestFailure/print already available.

// ---------------------------------------------------------------------------
// Helpers (copied from source programs, prefixed)
// ---------------------------------------------------------------------------

function sgxGreet(name: String) -> String {
    return "hello, " + name
}

function sgxPick(i: Int) -> String {
    if i == 0 {
        return "alpha" }
    return "beta"
}

function sgxPickWord(i: Int) -> String {
    if i == 0 {
        return "hello"
    }
    return "worldwide"
}

function sgxEchoText(value: String): String {
    return value
}

function sgxAddPair(left: Int, right: Int): Int {
    return left + right
}

function sgxEchoFlag(value: Bool): Bool {
    return value
}

// ---------------------------------------------------------------------------
// string_array_overwrite_no_leak
// ---------------------------------------------------------------------------

construct SgxArrayOverwriteNoLeak() extends Test {
    test {
        let head = "item"
        let sep = "-"
        var names: [String] = []
        names.append("seed-a")
        names.append("seed-b")
        names.append("seed-c")
        var round = 0
        while round < 200 {
            // Each store is a freshly heap-allocated concatenation; the previous
            // cloned buffer in the slot must be released, not orphaned.
            names[0] = head + sep + "alpha"
            names[1] = head + sep + "beta"
            names[2] = head + sep + "gamma"
            round = round + 1
        }
        return names[0] + "|" + names[2]
    }
    expect { let e: Result<String, TestFailure> = .Ok("item-alpha|item-gamma"); return e }
}

// ---------------------------------------------------------------------------
// string_concat_parity
// ---------------------------------------------------------------------------

construct SgxConcatSimple() extends Test {
    test { return "a" + "b" }
    expect { let e: Result<String, TestFailure> = .Ok("ab"); return e }
}

construct SgxConcatEmptyLeft() extends Test {
    test { return "" + "x" }
    expect { let e: Result<String, TestFailure> = .Ok("x"); return e }
}

construct SgxConcatEmptyRight() extends Test {
    test { return "y" + "" }
    expect { let e: Result<String, TestFailure> = .Ok("y"); return e }
}

construct SgxConcatGreet() extends Test {
    test { return sgxGreet("kira") }
    expect { let e: Result<String, TestFailure> = .Ok("hello, kira"); return e }
}

construct SgxConcatLoopAccum() extends Test {
    test {
        var s = ""
        var i = 0
        while i < 4 {
            s = s + "ab"
            i = i + 1
        }
        return s
    }
    expect { let e: Result<String, TestFailure> = .Ok("abababab"); return e }
}

construct SgxConcatLoopEquality() extends Test {
    test {
        var s = ""
        var i = 0
        while i < 4 {
            s = s + "ab"
            i = i + 1
        }
        return s == "abababab"
    }
    expect { let e: Result<Bool, TestFailure> = .Ok(true); return e }
}

construct SgxConcatNested() extends Test {
    test { return ("p" + "q") + ("r" + "s") }
    expect { let e: Result<String, TestFailure> = .Ok("pqrs"); return e }
}

// ---------------------------------------------------------------------------
// string_count_parity
// ---------------------------------------------------------------------------

construct SgxCountTitle() extends Test {
    test {
        let title = "KIRA"
        return title.count
    }
    expect { let e: Result<Int, TestFailure> = .Ok(4); return e }
}

construct SgxCountSubtitle() extends Test {
    test {
        let subtitle = "UI FOUNDATION"
        return subtitle.count
    }
    expect { let e: Result<Int, TestFailure> = .Ok(13); return e }
}

// ---------------------------------------------------------------------------
// string_equality_parity
// ---------------------------------------------------------------------------

construct SgxEqAlphaAlpha() extends Test {
    test { return "alpha" == "alpha" }
    expect { let e: Result<Bool, TestFailure> = .Ok(true); return e }
}

construct SgxEqAlphaBeta() extends Test {
    test { return "alpha" == "beta" }
    expect { let e: Result<Bool, TestFailure> = .Ok(false); return e }
}

construct SgxNeqAlphaBeta() extends Test {
    test { return "alpha" != "beta" }
    expect { let e: Result<Bool, TestFailure> = .Ok(true); return e }
}

construct SgxEqEmptyEmpty() extends Test {
    test { return "" == "" }
    expect { let e: Result<Bool, TestFailure> = .Ok(true); return e }
}

construct SgxEqPrefixMismatch() extends Test {
    test { return "a" == "ab" }
    expect { let e: Result<Bool, TestFailure> = .Ok(false); return e }
}

construct SgxEqPickComputed() extends Test {
    test { return sgxPick(0) == "alpha" }
    expect { let e: Result<Bool, TestFailure> = .Ok(true); return e }
}

construct SgxEqPickPick() extends Test {
    test { return sgxPick(1) == sgxPick(1) }
    expect { let e: Result<Bool, TestFailure> = .Ok(true); return e }
}

// ---------------------------------------------------------------------------
// call_temp_string_count_parity
// ---------------------------------------------------------------------------

construct SgxCallTempCountHello() extends Test {
    test { return sgxPickWord(0).count }
    expect { let e: Result<Int, TestFailure> = .Ok(5); return e }
}

construct SgxCallTempCountWorldwide() extends Test {
    test { return sgxPickWord(1).count }
    expect { let e: Result<Int, TestFailure> = .Ok(9); return e }
}

// ---------------------------------------------------------------------------
// call_value_parity
// ---------------------------------------------------------------------------

construct SgxCallEchoText() extends Test {
    test { return sgxEchoText("hello parity") }
    expect { let e: Result<String, TestFailure> = .Ok("hello parity"); return e }
}

construct SgxCallAddPair() extends Test {
    test { return sgxAddPair(20, 22) }
    expect { let e: Result<Int, TestFailure> = .Ok(42); return e }
}

construct SgxCallEchoFlagTrue() extends Test {
    test { return sgxEchoFlag(true) }
    expect { let e: Result<Bool, TestFailure> = .Ok(true); return e }
}

construct SgxCallEchoFlagFalse() extends Test {
    test { return sgxEchoFlag(false) }
    expect { let e: Result<Bool, TestFailure> = .Ok(false); return e }
}
