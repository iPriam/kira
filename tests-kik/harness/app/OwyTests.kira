// ---- ownership_let_field_alias_partial_move ----

struct OwyBag9 {
    var items: [Int]
}

function owyLeak9(value: Int, bag: OwyBag9) -> Int {
    if value == 0 {
            let alias = bag.items
            return alias.count
    } else {
            return 0
    }
}

Test OwyLetFieldAliasSwitchPartialMove {
    test {
        let bag = OwyBag9 { items: [1, 2, 3] }
        return owyLeak9(0, move bag)
    }
    expect { let e: Result<Int, TestFailure> = .Ok(3); return e }
}

