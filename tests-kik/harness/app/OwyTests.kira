import Foundation

// Migrated from tests/pass/run/ownership_* and consuming_* corpus cases.
// See tests-kik/corpus/ownership-b/SKIPPED.md for cases that depend on
// @Widget body/children builder syntax and could not be reduced.

// ---- ownership_construct_any_tree_churn_parity ----

construct OwyTreeNode {
    @Required let label: String
}

OwyTreeNode OwyLeafNode {
    let text: String = ""
    let weight: Int = 0

    let label: String {
        text
    }
}

OwyTreeNode OwyPairNode {
    @Required let first: OwyTreeNode
    @Required let second: OwyTreeNode

    let label: String {
        "pair"
    }
}

function owyBuildRow(index: Int) -> some OwyTreeNode {
    if index - (index / 2) * 2 == 0 {
        return OwyLeafNode(text: "leaf", weight: index)
    }
    return OwyPairNode(first: OwyLeafNode(text: "a"), second: OwyLeafNode(text: "b"))
}

Test OwyConstructAnyTreeChurnParity {
    test {
        var total = 0
        var rebuild = 0
        while rebuild < 10 {
            var nodes: [some OwyTreeNode] = []
            var i = 0
            while i < 12 {
                nodes.append(owyBuildRow(i))
                i = i + 1
            }
            for node in nodes {
                let label = node.label
                if label == "leaf" {
                    total = total + 1
                }
                if label == "pair" {
                    total = total + 2
                }
            }
            rebuild = rebuild + 1
        }
        return total
    }
    expect { let e: Result<Int, TestFailure> = .Ok(180); return e }
}

// ---- ownership_enum_argument_into_field_parity ----

enum OwyMode1 {
    Hug
    Fixed(Int)
}

struct OwyView1 {
    let width: OwyMode1
    let height: OwyMode1
    let n: Int
}

function owyMakeView1(width: OwyMode1, height: OwyMode1, n: Int) -> OwyView1 {
    return OwyView1 { width: width, height: height, n: n }
}

function owySpan1(m: borrow OwyMode1) -> Int {
    match m {
        Hug -> { return 1 }
        Fixed(v) -> { return v }
    }
}

Test OwyEnumArgumentIntoFieldParity {
    test {
        var frame = 0
        var total = 0
        while frame < 4 {
            let view = owyMakeView1(.Fixed(frame + 2), .Hug, frame)
            total = total + owySpan1(view.width) + owySpan1(view.height) + view.n
            frame = frame + 1
        }
        return total
    }
    expect { let e: Result<Int, TestFailure> = .Ok(24); return e }
}

// ---- ownership_enum_string_payload_free_parity ----

enum OwyMessage3 {
    Note(String)
    Count(Int)
    Empty
}

struct OwyEnvelope3 {
    var label: String
    var message: OwyMessage3
}

function owyDescribe3(message: borrow OwyMessage3) -> String {
    match message {
        Note(text) -> { return "note:" + text }
        Count(value) -> {
            if value > 0 {
                return "count-positive"
            }
            return "count-other"
        }
        Empty -> { return "empty" }
    }
    return "unreachable"
}

function owyPickMessage3(envelope: borrow OwyEnvelope3) -> OwyMessage3 {
    return envelope.message
}

Test OwyEnumStringPayloadFreeParity {
    test {
        var hits = 0
        var i = 0
        var envelope = OwyEnvelope3 { label: "env-" + "x", message: .Empty }
        while i < 20 {
            envelope.message = .Note("payload-" + "text")
            envelope.message = .Count(i)
            envelope.message = .Note("second-" + "note")
            let copy = envelope
            let picked = owyPickMessage3(copy)
            if owyDescribe3(picked) == "note:second-note" {
                hits = hits + 1
            }
            i = i + 1
        }
        return hits
    }
    expect { let e: Result<Int, TestFailure> = .Ok(20); return e }
}

// ---- ownership_enum_struct_field_parity ----

enum OwyKind4 {
    None
    Tagged(Int)
}

struct OwyBox4 {
    let kind: OwyKind4
    let n: Int
}

function owyMake4(x: Int) -> OwyBox4 {
    return OwyBox4 { kind: .Tagged(x), n: x }
}

function owyClassify4(b: borrow OwyBox4) -> Int {
    match b.kind {
        None -> { return 0 }
        Tagged(v) -> { return v }
    }
}

function owyRebrand4(b: borrow OwyBox4) -> OwyBox4 {
    return OwyBox4 { kind: b.kind, n: b.n + 100 }
}

Test OwyEnumStructFieldParity {
    test {
        var frame = 0
        var total = 0
        while frame < 3 {
            let box = owyMake4(frame + 1)
            let copy = owyRebrand4(box)
            total = total + owyClassify4(box) + owyClassify4(copy)
            frame = frame + 1
        }
        return total
    }
    expect { let e: Result<Int, TestFailure> = .Ok(12); return e }
}

