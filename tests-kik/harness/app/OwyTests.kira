// ---- ownership_multi_closure_copy_capture ----

function owyCallTwice11(first: () -> Int, second: () -> Int) -> Int {
    let a = first()
    let b = second()
    return a * 100 + b
}

Test OwyMultiClosureCopyCapture {
    test {
        let seed = 4
        let adder: () -> Int = { in
            return seed + 1
        }
        let multiplier: () -> Int = { in
            return seed * 10
        }
        let direct = seed + 0
        let combined = owyCallTwice11(move adder, move multiplier)
        return combined * 10 + direct
    }
    expect { let e: Result<Int, TestFailure> = .Ok(5404); return e }
}

// ---- ownership_partial_move_scope_exit_parity ----

construct OwyPmNode12 {
    @Required let tag: Int
}

OwyPmNode12 OwyPmLeaf12(value: Int) {
    let tag: Int {
        value
    }
}

enum OwyStatus12 {
    Ready: String = "ready"
    Blocked: String = "blocked"
}

function owyBuildNode12(tag: Int) -> some OwyPmNode12 {
    return OwyPmLeaf12(value: tag)
}

struct OwyHolder12 {
    var ids: [Int] = []
    var status: OwyStatus12 = .Ready("ok")
    var node: some OwyPmNode12
    var kept: [Int] = []
}

function owyStatusText12(s: borrow OwyStatus12) -> String {
    match s {
        Ready(text) -> { return text }
        Blocked(text) -> { return text }
    }
    return ""
}

function owyConsume12(holder: OwyHolder12) -> Int {
    let ids = holder.ids
    let status = holder.status
    let node = holder.node
    var total = ids.count
    total = total + owyStatusText12(status).count
    total = total + node.tag
    return total
}

Test OwyPartialMoveScopeExitParity {
    test {
        var round = 0
        var total = 0
        while round < 10 {
            var holder = OwyHolder12 { node: owyBuildNode12(round) }
            holder.ids.append(round)
            holder.ids.append(round + 1)
            holder.status = .Blocked("waiting")
            holder.kept.append(round)
            total = total + owyConsume12(move holder)
            round = round + 1
        }
        return total
    }
    expect { let e: Result<Int, TestFailure> = .Ok(135); return e }
}

// ---- ownership_recursive_closure_tree_parity ----

struct OwyClosureNode13 {
    let id: Int
    let onPress: (Int) -> Int
    let children: [OwyClosureNode13]
}

function owyMakeAdder13(base: Int): (Int) -> Int {
    return { n in
        return base + n
    }
}

function owyMakeLeaf13(id: Int) -> OwyClosureNode13 {
    return OwyClosureNode13 {
        id: id
        onPress: owyMakeAdder13(id)
        children: []
    }
}

function owyMakeBranch13(id: Int) -> OwyClosureNode13 {
    var children: [OwyClosureNode13] = []
    children.append(owyMakeLeaf13(id + 10))
    children.append(owyMakeLeaf13(id + 20))
    return OwyClosureNode13 {
        id: id
        onPress: owyMakeAdder13(id)
        children: move children
    }
}

function owyMakeTree13(seed: Int) -> OwyClosureNode13 {
    var children: [OwyClosureNode13] = []
    children.append(owyMakeBranch13(seed + 100))
    children.append(owyMakeBranch13(seed + 200))
    return OwyClosureNode13 {
        id: seed
        onPress: owyMakeAdder13(seed)
        children: move children
    }
}

function owyVisit13(node: borrow OwyClosureNode13) -> Int {
    var total = node.onPress(1)
    var i = 0
    while i < node.children.count {
        total = total + owyVisit13(node.children[i])
        i = i + 1
    }
    return total
}

Test OwyRecursiveClosureTreeParity {
    test {
        var total = 0
        var rebuild = 0
        while rebuild < 20 {
            let tree = owyMakeTree13(rebuild)
            total = total + owyVisit13(tree)
            rebuild = rebuild + 1
        }
        return total
    }
    expect { let e: Result<Int, TestFailure> = .Ok(20670); return e }
}

// ---- ownership_string_deep_value_parity ----

struct OwyLabel14 {
    var text: String = ""
    var hits: Int = 0
}

struct OwyPanel14 {
    var title: String = ""
    var label: OwyLabel14 = OwyLabel14 {}
}

enum OwyMessage14 {
    Note(String)
    Empty
}

function owyDescribe14(name: String) -> String {
    return "name:" + name
}

function owyPickBranch14(flag: Bool) -> String {
    var s = "init"
    if flag {
        s = "left-" + "branch"
    } else {
        s = "right-" + "branch"
    }
    return s
}

function owyLabelText14(l: borrow OwyLabel14) -> String {
    return l.text
}

function owyUnwrap14(m: OwyMessage14) -> String {
    match m {
        Note(text) -> { return text }
        Empty -> { return "empty" }
    }
    return "unreachable"
}

Test OwyStringDeepValueParity {
    test {
        var okCount = 0
        var panel = OwyPanel14 {}
        var i = 0
        while i < 10 {
            panel.title = "frame-" + "title"
            panel.label.text = owyDescribe14("inner")
            panel.label.hits = panel.label.hits + 1
            i = i + 1
        }
        if panel.title == "frame-title" {
            okCount = okCount + 1
        }
        if panel.label.text == "name:inner" {
            okCount = okCount + 1
        }
        if owyLabelText14(panel.label) == "name:inner" {
            okCount = okCount + 1
        }

        let snapshot = panel.title
        panel.title = "replaced"
        if snapshot == "frame-title" {
            okCount = okCount + 1
        }
        if panel.title == "replaced" {
            okCount = okCount + 1
        }

        var names: [String] = []
        var j = 0
        while j < 10 {
            names.append("n" + "x")
            j = j + 1
        }
        names[0] = "first-" + "slot"
        if names[0] == "first-slot" {
            okCount = okCount + 1
        }
        names[0] = "overwritten"
        if names[0] == "overwritten" {
            okCount = okCount + 1
        }
        if names[1] == "nx" {
            okCount = okCount + 1
        }
        if names.count == 10 {
            okCount = okCount + 1
        }

        let m: OwyMessage14 = .Note("payload-" + "text")
        if owyUnwrap14(move m) == "payload-text" {
            okCount = okCount + 1
        }

        if owyPickBranch14(true) == "left-branch" {
            okCount = okCount + 1
        }
        if owyPickBranch14(false) == "right-branch" {
            okCount = okCount + 1
        }

        var acc = ""
        var k = 0
        while k < 5 {
            acc = acc + names[0] + "-" + panel.title
            k = k + 1
        }
        if acc != "" {
            okCount = okCount + 1
        }

        return okCount
    }
    expect { let e: Result<Int, TestFailure> = .Ok(13); return e }
}

// ---- ownership_struct_param_move_into_array_parity ----

struct OwyItem15 {
    let v: Int
}

function owyAppendItem15(items: borrow mut [OwyItem15], item: OwyItem15) {
    var out = items
    out.append(move item)
    return
}

function owyBuild15(n: Int) -> [OwyItem15] {
    var items: [OwyItem15] = []
    var i = 0
    while i < n {
        owyAppendItem15(items, OwyItem15 { v: i * 2 })
        i = i + 1
    }
    return items
}

Test OwyStructParamMoveIntoArrayParity {
    test {
        var frame = 0
        var total = 0
        while frame < 3 {
            let items = owyBuild15(3)
            var i = 0
            while i < items.count {
                total = total + items[i].v
                i = i + 1
            }
            frame = frame + 1
        }
        return total
    }
    expect { let e: Result<Int, TestFailure> = .Ok(18); return e }
}

