// ---- ownership_multi_closure_copy_capture ----

function owyCallTwice11(first: () -> Int, second: () -> Int) -> Int {
    let a = first()
    let b = second()
    return a * 100 + b
}

Test OwyMultiClosureCopyCapture {
    test {
        let seed = 4
        let adder: () -> Int = { in
            return seed + 1
        }
        let multiplier: () -> Int = { in
            return seed * 10
        }
        let direct = seed + 0
        let combined = owyCallTwice11(move adder, move multiplier)
        return combined * 10 + direct
    }
    expect { let e: Result<Int, TestFailure> = .Ok(5404); return e }
}

// ---- ownership_partial_move_scope_exit_parity ----

construct OwyPmNode12 {
    @Required let tag: Int
}

OwyPmNode12 OwyPmLeaf12(value: Int) {
    let tag: Int {
        value
    }
}

enum OwyStatus12 {
    Ready: String = "ready"
    Blocked: String = "blocked"
}

function owyBuildNode12(tag: Int) -> some OwyPmNode12 {
    return OwyPmLeaf12(value: tag)
}

struct OwyHolder12 {
    var ids: [Int] = []
    var status: OwyStatus12 = .Ready("ok")
    var node: some OwyPmNode12
    var kept: [Int] = []
}

function owyStatusText12(s: borrow OwyStatus12) -> String {
    match s {
        Ready(text) -> { return text }
        Blocked(text) -> { return text }
    }
    return ""
}

function owyConsume12(holder: OwyHolder12) -> Int {
    let ids = holder.ids
    let status = holder.status
    let node = holder.node
    var total = ids.count
    total = total + owyStatusText12(status).count
    total = total + node.tag
    return total
}

Test OwyPartialMoveScopeExitParity {
    test {
        var round = 0
        var total = 0
        while round < 10 {
            var holder = OwyHolder12 { node: owyBuildNode12(round) }
            holder.ids.append(round)
            holder.ids.append(round + 1)
            holder.status = .Blocked("waiting")
            holder.kept.append(round)
            total = total + owyConsume12(move holder)
            round = round + 1
        }
        return total
    }
    expect { let e: Result<Int, TestFailure> = .Ok(135); return e }
}

