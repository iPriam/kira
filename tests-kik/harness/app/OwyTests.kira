// ---- ownership_free_state_moveout_return_parity ----

struct OwyAcc6 {
    var ids: [Int] = []
    var total: Int = 0
}

struct OwyScratch6 {
    var acc: OwyAcc6 = OwyAcc6 {}
}

struct OwyTree6 {
    var nodes: [Int] = []
    var generation: Int = 0
}

function owyBorrowedSegments6(t: borrow OwyTree6) -> [Int] {
    return t.nodes
}

function owyRebuild6(tree: OwyTree6) -> OwyTree6 {
    var next = move tree
    let previous = next.nodes
    next.nodes = []
    var i = 0
    while i < previous.count {
        next.nodes.append(previous[i] + 1)
        i = i + 1
    }
    next.generation = next.generation + 1
    return next
}

Test OwyFreeStateMoveoutReturnParity {
    test {
        var okFlag = 1
        let state = nativeState(OwyScratch6 {})
        let handle = nativeUserData(state)
        var frame = 0
        while frame < 10 {
            var scratch = nativeRecover<OwyScratch6>(handle)
            var fresh = OwyAcc6 {}
            fresh.total = frame
            fresh.ids.append(frame)
            scratch.acc = move fresh
            let acc = scratch.acc
            if acc.total != frame {
                okFlag = 0
            }
            frame = frame + 1
        }

        var tree = OwyTree6 {}
        tree.nodes.append(1)
        tree.nodes.append(2)
        var r = 0
        while r < 10 {
            tree = owyRebuild6(move tree)
            r = r + 1
        }

        var sum = 0
        var k = 0
        while k < 10 {
            let segs = owyBorrowedSegments6(tree)
            sum = sum + segs.count
            k = k + 1
        }

        let combined = tree.nodes[0] * 100000 + tree.nodes[1] * 1000 + tree.generation * 100 + sum * 10 + tree.nodes.count
        return okFlag * combined
    }
    expect { let e: Result<Int, TestFailure> = .Ok(1113202); return e }
}

// ---- ownership_let_field_alias_if_partial_move ----

struct OwyBag7 {
    var items: [Int]
}

function owyLeak7(flag: Bool, bag: OwyBag7) -> Int {
    if flag {
        let alias = bag.items
        return alias.count
    }
    return 0
}

Test OwyLetFieldAliasIfPartialMove {
    test {
        let bag = OwyBag7 { items: [1, 2, 3] }
        return owyLeak7(true, move bag)
    }
    expect { let e: Result<Int, TestFailure> = .Ok(3); return e }
}

