construct CfxTrapOOBExactEnd() extends Test {
    test {
        let xs: [Int] = [10, 20, 30]
        let _ = xs[3]
        return 0
    }
    expect { let e: Result<Any, TestFailure> = .Error(.Runtime("")) return e }
