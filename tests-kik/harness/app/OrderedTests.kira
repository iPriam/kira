import Foundation

// Ordered turns an enum's declaration order into a total order and exposes the
// comparison, never the position it is built from.

@Derive(Ordered)
enum OdxSeverity {
    Note
    Warning
    Error
}

// A distinct power of two per answer, so one total pins every comparison
// instead of the sum hiding a swapped pair.
function odxScore(ordering: borrow Ordering) -> Int {
    match ordering {
        Less -> return 1
        Equal -> return 2
        Greater -> return 4
    }
}

construct OdxOrderedFollowsDeclarationOrder() extends Test {
    test {
        var total = 0
        total = total + odxScore(compare_OdxSeverity(.Note, .Error))
        total = total + odxScore(compare_OdxSeverity(.Warning, .Warning))
        total = total + odxScore(compare_OdxSeverity(.Error, .Note))
        if lt_OdxSeverity(.Note, .Warning) {
            total = total + 8
        }
        if !lt_OdxSeverity(.Error, .Warning) {
            total = total + 16
        }
        if !lt_OdxSeverity(.Warning, .Warning) {
            total = total + 32
        }
        return total
    }
    expect { let e: Result<Any, TestFailure> = .Ok(63) return e }
}

// The native `compare(a, b)` answers the same `Ordering` the derived
// `compare_OdxSeverity` does — `Less`/`Equal`/`Greater` — built from the
// structural three-way compare with no `@Derive`, and it agrees on every backend.
construct OdxNativeCompareMatchesDerived() extends Test {
    test {
        var total = 0
        total = total + odxScore(compare(OdxSeverity.Note, OdxSeverity.Error))
        total = total + odxScore(compare(OdxSeverity.Warning, OdxSeverity.Warning))
        total = total + odxScore(compare(OdxSeverity.Error, OdxSeverity.Note))
        return total
    }
    expect { let e: Result<Any, TestFailure> = .Ok(7) return e }
}
