import Foundation

// Ordered turns an enum's declaration order into a total order and exposes the
// comparison, never the position it is built from.

@Derive(Ordered)
enum OdxSeverity {
    Note
    Warning
    Error
}

// A distinct power of two per answer, so one total pins every comparison
// instead of the sum hiding a swapped pair.
function odxScore(ordering: borrow Ordering) -> Int {
    match ordering {
        Less -> return 1;
        Equal -> return 2;
        Greater -> return 4;
    }
}

construct OdxOrderedFollowsDeclarationOrder() extends Test {
    test {
        var total = 0
        total = total + odxScore(compare_OdxSeverity(.Note, .Error))
        total = total + odxScore(compare_OdxSeverity(.Warning, .Warning))
        total = total + odxScore(compare_OdxSeverity(.Error, .Note))
        if lt_OdxSeverity(.Note, .Warning) {
            total = total + 8
        }
        if !lt_OdxSeverity(.Error, .Warning) {
            total = total + 16
        }
        if !lt_OdxSeverity(.Warning, .Warning) {
            total = total + 32
        }
        return total
    }
    expect { let e: Result<Int, TestFailure> = .Ok(63); return e }
}
