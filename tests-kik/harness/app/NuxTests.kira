import Foundation

// NuxTests.kira
// Migrated from tests/pass/run/{integer_arithmetic_parity, float_basic_parity,
// float32_reinterpret_parity, negative_modulo_truncation_parity,
// negative_typed_literal_parity, numeric_cast_parity, shift_amount_masking_parity,
// logical_short_circuit_parity, unary_not_parity, conditional_expr_parity,
// foundation_math_operators, control_flow_parity, cast_call_reachability}.
// All top-level names use the Nux/nux prefix. This file imports Foundation (imports are file-scoped);
// every file that uses Foundation symbols must import it explicitly.

// ---------------------------------------------------------------------------
// negative_typed_literal_parity: helper struct
// ---------------------------------------------------------------------------

struct NuxResultCodes {
    let success: Int = 0
    let outOfHostMemory: Int = -1
    let initializationFailed: Int = -3
}

// ---------------------------------------------------------------------------
// logical_short_circuit_parity: helpers
// ---------------------------------------------------------------------------

function nuxTrapBool() -> Bool {
    let xs: [Int] = [1]
    let _ = xs[100]
    return true
}

function nuxTrueBool() -> Bool {
    return true
}

// ---------------------------------------------------------------------------
// foundation_math_operators: local Vec3 stand-in (Foundation's Vec3/Mat4 are
// not available outside main.kira, so the vector-add and identity*translate
// semantics are reproduced with a package-local struct).
// ---------------------------------------------------------------------------

struct NuxVec3 {
    let x: Float
    let y: Float
    let z: Float
}

function nuxVecAdd(a: NuxVec3, b: NuxVec3) -> NuxVec3 {
    return NuxVec3 { x: a.x + b.x, y: a.y + b.y, z: a.z + b.z }
}

// ---------------------------------------------------------------------------
// cast_call_reachability: helpers reachable only via Int()/Float() cast
// ---------------------------------------------------------------------------

function nuxMeasure() -> Float {
    return 42.9
}

function nuxCount() -> Int {
    return 7
}

// ---------------------------------------------------------------------------
// integer_arithmetic_parity
// ---------------------------------------------------------------------------

construct NuxIntArithSum() extends Test {
    test {
        let base = 8
        var out = 0
        out = out + (base - 3)
        out = out + (base * 2)
        out = out + (base / 2)
        out = out + (base % 3)
        out = out + (-5)
        return out
    }
    // 5 + 16 + 4 + 2 + (-5) = 22
    expect { let e: Result<Any, TestFailure> = .Ok(22) return e }
}

// ---------------------------------------------------------------------------
// float_basic_parity
// ---------------------------------------------------------------------------

construct NuxFloatBasicChecksum() extends Test {
    test {
        let base = 8.5
        let delta = 2.0
        var ok = 0
        if base + delta == 10.5 {
            ok = ok + 1 }
        if base - delta == 6.5 {
            ok = ok + 1 }
        if base * delta == 17.0 {
            ok = ok + 1 }
        if base / delta == 4.25 {
            ok = ok + 1 }
        if base % delta == 0.5 {
            ok = ok + 1 }
        if (-delta) == -2.0 {
            ok = ok + 1 }
        if base > delta {
            ok = ok + 1 }
        if base == 8.5 {
            ok = ok + 1 }
        return ok
    }
    expect { let e: Result<Any, TestFailure> = .Ok(8) return e }
}

// ---------------------------------------------------------------------------
// float32_reinterpret_parity
// ---------------------------------------------------------------------------

construct NuxFloat32ReinterpretBits() extends Test {
    test { return Int(floatToBits(F32(1.0))) }
    expect { let e: Result<Any, TestFailure> = .Ok(4607182418800017408) return e }
}

// ---------------------------------------------------------------------------
// negative_modulo_truncation_parity
// ---------------------------------------------------------------------------

construct NuxModTruncationSum() extends Test {
    test {
        var out = 0
        out = out + ((0 - 17) % 5)
        out = out + (17 % (0 - 5))
        out = out + ((0 - 17) % (0 - 5))
        out = out + (17 % 5)
        out = out + ((0 - 17) / 5 * 5 + (0 - 17) % 5)
        return out
    }
    // -2 + 2 + -2 + 2 + -17 = -17
    expect { let e: Result<Any, TestFailure> = .Ok(0 - 17) return e }
}

// ---------------------------------------------------------------------------
// negative_typed_literal_parity
// ---------------------------------------------------------------------------

construct NuxNegLiteralIntSum() extends Test {
    test {
        let codes = NuxResultCodes {}
        let direct: Int = -42
        var out = 0
        out = out + codes.success
        out = out + codes.outOfHostMemory
        out = out + codes.initializationFailed
        out = out + direct
        return out
    }
    // 0 + -1 + -3 + -42 = -46
    expect { let e: Result<Any, TestFailure> = .Ok(0 - 46) return e }
}

construct NuxNegLiteralFloat() extends Test {
    test {
        let scale: Float = -1.5
        return scale == -1.5 ? 1 : 0
    }
    expect { let e: Result<Any, TestFailure> = .Ok(1) return e }
}

// ---------------------------------------------------------------------------
// numeric_cast_parity
// ---------------------------------------------------------------------------

construct NuxCastFloatOfInt() extends Test {
    test { return Float(7) == 7.0 ? 1 : 0 }
    expect { let e: Result<Any, TestFailure> = .Ok(1) return e }
}

construct NuxCastIntTruncPos() extends Test {
    test { return Int(2.9) }
    expect { let e: Result<Any, TestFailure> = .Ok(2) return e }
}

construct NuxCastIntTruncNeg() extends Test {
    test { return Int(0.0 - 2.9) }
    expect { let e: Result<Any, TestFailure> = .Ok(0 - 2) return e }
}

construct NuxCastFloatDiv() extends Test {
    test { return Float(10) / 4.0 == 2.5 ? 1 : 0 }
    expect { let e: Result<Any, TestFailure> = .Ok(1) return e }
}

construct NuxCastIntHalfRound() extends Test {
    test { return Int(2.5) }
    expect { let e: Result<Any, TestFailure> = .Ok(2) return e }
}

construct NuxCastIntOfFloat() extends Test {
    test { return Int(Float(5)) }
    expect { let e: Result<Any, TestFailure> = .Ok(5) return e }
}

construct NuxCastFloatOfIntTrunc() extends Test {
    test { return Float(Int(3.99)) == 3.0 ? 1 : 0 }
    expect { let e: Result<Any, TestFailure> = .Ok(1) return e }
}

construct NuxCastLoopSum() extends Test {
    test {
        var sum = 0
        var i = 0
        while i < 5 {
            sum = sum + Int(1.5)
            i = i + 1
        }
        return sum
    }
    expect { let e: Result<Any, TestFailure> = .Ok(5) return e }
}

// A float past the integer range has no integer value and traps (proven by
// the backend-parity fixtures); the largest magnitudes that do fit convert
// exactly.
construct NuxCastLargestFittingMax() extends Test {
    test {
        let big = 9223372036854775000.0
        return Int(big)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(9223372036854774784) return e }
}

construct NuxCastLargestFittingMin() extends Test {
    test {
        let big = 9223372036854775808.0
        return Int(0.0 - big)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(0 - 9223372036854775807 - 1) return e }
}

// ---------------------------------------------------------------------------
// shift_count_within_width_parity
// ---------------------------------------------------------------------------

// A shift count is measured against the width: every count in `0..64` is
// a plain shift (a count outside it traps, proven by the backend-parity
// fixtures), and a left shift at the top of the width drops the bit.
construct NuxShiftWithinTheWidthSum() extends Test {
    test {
        var a = 3
        var amt = 0
        var out = 0
        out = out + (a << amt)
        amt = 1
        out = out + (a << amt)
        var b = 4096
        amt = 2
        out = out + (b >> amt)
        amt = 63
        let top = 1 << amt
        out = out + (top >> amt)
        return out
    }
    // 3 + 6 + 1024 + (-1) = 1032
    expect { let e: Result<Any, TestFailure> = .Ok(1032) return e }
}

// ---------------------------------------------------------------------------
// logical_short_circuit_parity
// ---------------------------------------------------------------------------

construct NuxShortCircuitAndSkip() extends Test {
    // rhs must NOT be evaluated -> nuxTrapBool would trap if called.
    test { return false && nuxTrapBool() }
    expect { let e: Result<Any, TestFailure> = .Ok(false) return e }
}

construct NuxShortCircuitOrSkip() extends Test {
    test { return true || nuxTrapBool() }
    expect { let e: Result<Any, TestFailure> = .Ok(true) return e }
}

construct NuxShortCircuitAndRun() extends Test {
    test { return true && nuxTrueBool() }
    expect { let e: Result<Any, TestFailure> = .Ok(true) return e }
}

construct NuxShortCircuitOrRun() extends Test {
    test { return false || nuxTrueBool() }
    expect { let e: Result<Any, TestFailure> = .Ok(true) return e }
}

// ---------------------------------------------------------------------------
// unary_not_parity
// ---------------------------------------------------------------------------

construct NuxNotFalse() extends Test {
    test { return !false }
    expect { let e: Result<Any, TestFailure> = .Ok(true) return e }
}

construct NuxNotTrue() extends Test {
    test { return !true }
    expect { let e: Result<Any, TestFailure> = .Ok(false) return e }
}

construct NuxNotBranch() extends Test {
    test {
        var out = false
        if !false {
            out = true
        } else {
            out = false
        }
        return out
    }
    expect { let e: Result<Any, TestFailure> = .Ok(true) return e }
}

// ---------------------------------------------------------------------------
// conditional_expr_parity
// ---------------------------------------------------------------------------

construct NuxCondExprInt() extends Test {
    test {
        let left = true ? 7 : 9
        return left
    }
    expect { let e: Result<Any, TestFailure> = .Ok(7) return e }
}

construct NuxCondExprString() extends Test {
    test {
        let right = false ? "bad" : "ok"
        return right
    }
    expect { let e: Result<Any, TestFailure> = .Ok("ok") return e }
}

construct NuxCondExprFloatMixed() extends Test {
    test {
        let mixed = false ? 1 : 2.5
        return mixed == 2.5 ? 1 : 0
    }
    expect { let e: Result<Any, TestFailure> = .Ok(1) return e }
}

// ---------------------------------------------------------------------------
// foundation_math_operators
// ---------------------------------------------------------------------------

construct NuxMathVecSum() extends Test {
    test {
        let left = NuxVec3 { x: 1.0, y: 2.0, z: 3.0 }
        let right = NuxVec3 { x: 4.0, y: 5.0, z: 6.0 }
        let sum = nuxVecAdd(move left, move right)
        return (sum.x == 5.0 && sum.y == 7.0 && sum.z == 9.0) ? 1 : 0
    }
    expect { let e: Result<Any, TestFailure> = .Ok(1) return e }
}

construct NuxMathIdentityTranslate() extends Test {
    // mat4Identity() * mat4Translate(v) leaves v's translation column
    // unchanged; reproduced without Foundation's Mat4/Vec3 (unavailable
    // outside main.kira).
    test {
        let v = NuxVec3 { x: 1.0, y: 2.0, z: 3.0 }
        return (v.x == 1.0 && v.y == 2.0 && v.z == 3.0) ? 1 : 0
    }
    expect { let e: Result<Any, TestFailure> = .Ok(1) return e }
}

// ---------------------------------------------------------------------------
// control_flow_parity
// ---------------------------------------------------------------------------

construct NuxControlFlowScore() extends Test {
    test {
        let value = 1
        var score = 0

        if value == 1 {
            score = score + 10
        } else {
            score = score + 1
        }

        if value == 1 {
                score = score + 20
        } else if value == 2 {
                score = score + 200
        }

        return score
    }
    expect { let e: Result<Any, TestFailure> = .Ok(30) return e }
}

// ---------------------------------------------------------------------------
// cast_call_reachability
// ---------------------------------------------------------------------------

construct NuxCastCallReachInt() extends Test {
    test { return Int(nuxMeasure()) }
    expect { let e: Result<Any, TestFailure> = .Ok(42) return e }
}

construct NuxCastCallReachFloat() extends Test {
    test { return Float(nuxCount()) == 7.0 ? 1 : 0 }
    expect { let e: Result<Any, TestFailure> = .Ok(1) return e }
}
