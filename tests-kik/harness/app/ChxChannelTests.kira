import Foundation

// Kira Test coverage for channels: `Channel<T>()`, its two ends, and the
// ordering a receive turns into a data dependency.
//
// The point of a channel is that a program can order its own work against work
// already running somewhere else. Before it, an outsider could only enqueue.
// These pin that: a receive comes back with the value the other side sent, and
// it comes back *after* that side ran.

construct ChxSendsAndReceivesInOrder() extends Test {
    test {
        let tx = Channel<Int>()
        let rx = tx.receiver
        tx.send(1)
        tx.send(2)
        tx.send(3)
        attempt {
            let a = try rx.receive()
            let b = try rx.receive()
            let c = try rx.receive()
            return a * 100 + b * 10 + c
        } handle {
            Closed { return 0 - 1 }
        }
    }
    expect { let e: Result<Any, TestFailure> = .Ok(123) return e }
}

// A drained closed channel is an ordinary end to a conversation, not a trap:
// the handler covers it the way it covers every other failure.
construct ChxClosedIsAFailureNotATrap() extends Test {
    test {
        let tx = Channel<Int>()
        let rx = tx.receiver
        tx.send(7)
        tx.close()
        attempt {
            let first = try rx.receive()
            let second = try rx.receive()
            return first + second
        } handle {
            Closed { return 99 }
        }
    }
    expect { let e: Result<Any, TestFailure> = .Ok(99) return e }
}

// A channel closed before anything crossed is closed at once.
construct ChxAnEmptyClosedChannelIsClosed() extends Test {
    test {
        let tx = Channel<Int>()
        let rx = tx.receiver
        tx.close()
        attempt {
            let value = try rx.receive()
            return value
        } handle {
            Closed { return 5 }
        }
    }
    expect { let e: Result<Any, TestFailure> = .Ok(5) return e }
}

// The whole reason the feature exists: the receive comes back *after* the task
// that fills it has run. A receive on an empty live channel hands the next
// runnable task a turn, so this orders two contexts against each other rather
// than hoping.
async function chxFill(tx: Sender<Int>) -> Int {
    tx.send(41)
    return 1
}

construct ChxReceiveWaitsForTheTaskThatFillsIt() extends Test {
    test {
        let tx = Channel<Int>()
        let rx = tx.receiver
        var pending = Task { chxFill(tx) }
        attempt {
            let value = try rx.receive()
            let ran = pending.await
            return value + ran
        } handle {
            Closed { return 0 - 1 }
        }
    }
    expect { let e: Result<Any, TestFailure> = .Ok(42) return e }
}

// Two channels are two channels: ends minted for one payload do not name the
// other's storage.
construct ChxTwoChannelsDoNotShareStorage() extends Test {
    test {
        let first = Channel<Int>()
        let second = Channel<Int>()
        first.send(10)
        second.send(20)
        attempt {
            let a = try first.receiver.receive()
            let b = try second.receiver.receive()
            return a * 10 + b
        } handle {
            Closed { return 0 - 1 }
        }
    }
    expect { let e: Result<Any, TestFailure> = .Ok(120) return e }
}

// A float payload crosses as itself, not as a rounding of itself.
construct ChxCarriesAFloatPayload() extends Test {
    test {
        let tx = Channel<Float>()
        let rx = tx.receiver
        tx.send(0.5)
        attempt {
            let value = try rx.receive()
            if value == 0.5 { return 1 }
            return 0
        } handle {
            Closed { return 0 - 1 }
        }
    }
    expect { let e: Result<Any, TestFailure> = .Ok(1) return e }
}

// A `distinct` payload keeps its identity across the wire: what comes out is
// the named type that went in, not the number underneath.
distinct ChxTicket = U32

construct ChxCarriesADistinctPayload() extends Test {
    test {
        let tx = Channel<ChxTicket>()
        let rx = tx.receiver
        tx.send(ChxTicket(7))
        attempt {
            let value = try rx.receive()
            if value == ChxTicket(7) { return 1 }
            return 0
        } handle {
            Closed { return 0 - 1 }
        }
    }
    expect { let e: Result<Any, TestFailure> = .Ok(1) return e }
}

// A receive nothing can answer is a trap, not a wait and not a closure. The
// queue is empty, the sender is live, and nothing else is runnable, so no
// later turn can change the answer. Reporting `Closed` would say the sender
// went away when it did not, which is why the handler below is unreachable:
// a passing run here is a trapping run.
construct ChxAReceiveNothingCanAnswerTraps() extends Test {
    test {
        let tx = Channel<Int>()
        let rx = tx.receiver
        attempt {
            let value = try rx.receive()
            return value
        } handle {
            Closed { return 0 - 1 }
        }
    }
    expect { let e: Result<Any, TestFailure> = .Error(.Runtime("")) return e }
}

// Cancellation while blocked. The only work that could fill the channel is
// called off before it ever runs, so the wait has no turn to hand out and the
// receive learns its value is not coming instead of blocking on work that was
// called off.
construct ChxACancelledFillerLeavesTheReceiveUnanswerable() extends Test {
    test {
        let tx = Channel<Int>()
        let rx = tx.receiver
        var filler = Task { chxFill(tx) }
        filler.requestCancel()
        attempt {
            let value = try rx.receive()
            return value
        } handle {
            Closed { return 0 - 1 }
        }
    }
    expect { let e: Result<Any, TestFailure> = .Error(.Runtime("")) return e }
}

// Cancelling one filler is not cancelling the channel. The wait hands its turn
// to whatever is still runnable, so the live filler answers and the receive
// comes back with its value rather than trapping.
construct ChxACancelledFillerDoesNotStopALiveOne() extends Test {
    test {
        let tx = Channel<Int>()
        let rx = tx.receiver
        var cancelled = Task { chxFill(tx) }
        cancelled.requestCancel()
        var live = Task { chxFill(tx) }
        attempt {
            let value = try rx.receive()
            let ran = live.await
            return value + ran
        } handle {
            Closed { return 0 - 1 }
        }
    }
    expect { let e: Result<Any, TestFailure> = .Ok(42) return e }
}

// --- Payloads that own storage ----------------------------------------------
// A queue slot is one machine word, and a value that owns storage has no word
// of its own — so it crosses as a token naming it in the store, and the
// receiver takes the value out and gives the token up. What arrives is the
// value itself, not a share of the sender's.

struct ChxNote {
    var title: String
    var rank: Int
}

async function chxFillText(tx: Sender<String>) -> Int {
    tx.send("carried whole")
    return 1
}

async function chxFillNote(tx: Sender<ChxNote>) -> Int {
    tx.send(ChxNote(title: "boxed", rank: 41))
    return 1
}

async function chxFillThree(tx: Sender<String>) -> Int {
    tx.send("one")
    tx.send("two")
    tx.send("three")
    return 1
}

construct ChxCarriesAStringPayload() extends Test {
    test {
        let tx = Channel<String>()
        let rx = tx.receiver
        var pending = Task { chxFillText(tx) }
        attempt {
            let got = try rx.receive()
            return got.count + pending.await
        } handle {
            Closed { return 0 - 1 }
        }
    }
    expect { let e: Result<Any, TestFailure> = .Ok(14) return e }
}

construct ChxCarriesAStringPayloadAsItself() extends Test {
    test {
        let tx = Channel<String>()
        let rx = tx.receiver
        var pending = Task { chxFillText(tx) }
        attempt {
            let got = try rx.receive()
            let same = got == "carried whole"
            return same ? pending.await : 0
        } handle {
            Closed { return 0 - 1 }
        }
    }
    expect { let e: Result<Any, TestFailure> = .Ok(1) return e }
}

construct ChxCarriesAStructPayload() extends Test {
    test {
        let tx = Channel<ChxNote>()
        let rx = tx.receiver
        var pending = Task { chxFillNote(tx) }
        attempt {
            let got = try rx.receive()
            return got.rank + got.title.count + pending.await
        } handle {
            Closed { return 0 - 1 }
        }
    }
    expect { let e: Result<Any, TestFailure> = .Ok(47) return e }
}

// Order is order, whatever the payload is: three strings arrive in the order
// they were sent, each one whole.
construct ChxCarriesOwnedPayloadsInOrder() extends Test {
    test {
        let tx = Channel<String>()
        let rx = tx.receiver
        var pending = Task { chxFillThree(tx) }
        attempt {
            let first = try rx.receive()
            let second = try rx.receive()
            let third = try rx.receive()
            let ordered = first == "one" && second == "two" && third == "three"
            return ordered ? pending.await : 0
        } handle {
            Closed { return 0 - 1 }
        }
    }
    expect { let e: Result<Any, TestFailure> = .Ok(1) return e }
}

// A receiver closing discards whatever is still queued, and each of those
// slots owns the storage its token names. Three values are sent and none is
// received, so the close is what has to release all three: without the drain
// this leaks every one of them, silently, and the program still prints the
// right answer. The heap-balance half of this is the parity case.
construct ChxClosingAReceiverDropsWhatItNeverDelivered() extends Test {
    test {
        let tx = Channel<String>()
        let rx = tx.receiver
        var pending = Task { chxFillThree(tx) }
        let ran = pending.await
        rx.close()
        return ran
    }
    expect { let e: Result<Any, TestFailure> = .Ok(1) return e }
}
