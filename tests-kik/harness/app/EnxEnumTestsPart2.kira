import Foundation

// EnxEnumTests.kira — Deep enum test suite.
// Covers: payload-less enums (4-variant, 3-variant, 4-variant), single-payload
// Int enums, mixed payload/payload-less enums, enums as struct fields, arrays
// of enums matched via borrow-param helpers, state-machine transitions, and
// trap tests.  All top-level names use prefix enx / Enx.

// ---------------------------------------------------------------------------
// Single-payload + payload-less enum tests — EnxEvent
// ---------------------------------------------------------------------------

construct EnxEventClickDirect() extends Test {
    test { return enxEventScore(.Click(7)) }
    expect { let e: Result<Int, TestFailure> = .Ok(7); return e }
}

construct EnxEventKeyDirect() extends Test {
    test { return enxEventScore(.Key(3)) }
    expect { let e: Result<Int, TestFailure> = .Ok(30); return e }
}

construct EnxEventScrollDirect() extends Test {
    test { return enxEventScore(.Scroll(2)) }
    expect { let e: Result<Int, TestFailure> = .Ok(200); return e }
}

construct EnxEventIdleDirect() extends Test {
    test { return enxEventScore(.Idle) }
    expect { let e: Result<Int, TestFailure> = .Ok(0); return e }
}

// [Click(3),Key(2),Scroll(1),Idle,Click(5),Key(1)] -> 3+20+100+0+5+10=138
construct EnxEventArrayFold() extends Test {
    test {
        let es: [EnxEvent] = [.Click(3), .Key(2), .Scroll(1), .Idle, .Click(5), .Key(1)]
        var s = 0
        for ev in es {
            s = s + enxEventScore(ev)
        }
        return s
    }
    expect { let e: Result<Int, TestFailure> = .Ok(138); return e }
}

// Indexed access via borrow helper
// events[j] via enxEventScore(events[j])
// [Click(10), Idle, Key(3), Scroll(1)] -> 10+0+30+100=140
construct EnxEventIndexedFold() extends Test {
    test {
        var events: [EnxEvent] = []
        events.append(.Click(10))
        events.append(.Idle)
        events.append(.Key(3))
        events.append(.Scroll(1))
        var acc = 0
        var j = 0
        while j < events.count {
            acc = acc + enxEventScore(events[j])
            j = j + 1
        }
        return acc
    }
    expect { let e: Result<Int, TestFailure> = .Ok(140); return e }
}

// Count non-Idle events in [Click(1),Idle,Key(2),Scroll(3),Idle,Click(4)] -> 4
construct EnxEventCountNonIdle() extends Test {
    test {
        let es: [EnxEvent] = [.Click(1), .Idle, .Key(2), .Scroll(3), .Idle, .Click(4)]
        var count = 0
        for ev in es {
            if enxIsIdleEvent(ev) == 0 {
                count = count + 1 }
        }
        return count
    }
    expect { let e: Result<Int, TestFailure> = .Ok(4); return e }
}

// Sum only Click payloads in [Click(5),Key(2),Click(8),Idle,Click(1)]: 5+8+1=14
construct EnxEventSumClicksOnly() extends Test {
    test {
        let es: [EnxEvent] = [.Click(5), .Key(2), .Click(8), .Idle, .Click(1)]
        var acc = 0
        for ev in es {
            acc = acc + enxClickPayload(ev)
        }
        return acc
    }
    expect { let e: Result<Int, TestFailure> = .Ok(14); return e }
}

// ---------------------------------------------------------------------------
// Mixed payload/payload-less enum tests — EnxStatus
// ---------------------------------------------------------------------------

construct EnxStatusDormantDirect() extends Test {
    test { return enxStatusCode(.Dormant) }
    expect { let e: Result<Int, TestFailure> = .Ok(0); return e }
}

construct EnxStatusRunningDirect() extends Test {
    test { return enxStatusCode(.Running(42)) }
    expect { let e: Result<Int, TestFailure> = .Ok(42); return e }
}

// Done(15) -> 15+100=115
construct EnxStatusDoneDirect() extends Test {
    test { return enxStatusCode(.Done(15)) }
    expect { let e: Result<Int, TestFailure> = .Ok(115); return e }
}

// Failed(8) -> 0-8 = -8
construct EnxStatusFailedDirect() extends Test {
    test { return enxStatusCode(.Failed(8)) }
    expect { let e: Result<Int, TestFailure> = .Ok(0 - 8); return e }
}

// i=0..11: enxStatusFor(i) then code:
// Dormant: i=0,4,8 -> codes 0,0,0 = 0
// Running: i=1,5,9 -> codes 1,5,9 = 15
// Done: i=2,6,10 -> codes 102,106,110 = 318
// Failed: i=3,7,11 -> codes -3,-7,-11 = -21
// total = 0+15+318-21 = 312
construct EnxStatusFold12() extends Test {
    test {
        var acc = 0
        var i = 0
        while i < 12 {
            let s = enxStatusFor(i)
            acc = acc + enxStatusCode(s)
            i = i + 1
        }
        return acc
    }
    expect { let e: Result<Int, TestFailure> = .Ok(312); return e }
}

// Count Running+Done (active) in i=0..11: Running=3, Done=3 -> 6
construct EnxStatusCountActive() extends Test {
    test {
        var count = 0
        var i = 0
        while i < 12 {
            let s = enxStatusFor(i)
            var active = 0
            match s {
                Dormant    -> { active = 0 }
                Running(n) -> { active = 1 }
                Done(n)    -> { active = 1 }
                Failed(n)  -> { active = 0 }
            }
            count = count + active
            i = i + 1
        }
        return count
    }
    expect { let e: Result<Int, TestFailure> = .Ok(6); return e }
}

// Sum Running payload values in i=0..11: Running at i=1,5,9 -> 1+5+9=15
construct EnxStatusRunningSum() extends Test {
    test {
        var acc = 0
        var i = 0
        while i < 12 {
            let s = enxStatusFor(i)
            var v = 0
            match s {
                Running(n) -> { v = n }
                Dormant    -> { v = 0 }
                Done(n)    -> { v = 0 }
                Failed(n)  -> { v = 0 }
            }
            acc = acc + v
            i = i + 1
        }
        return acc
    }
    expect { let e: Result<Int, TestFailure> = .Ok(15); return e }
}

// Indexed access via borrow helper: statusFor is called, result passed to enxStatusCode(statuses[j])
// Build [Dormant, Running(10), Done(5), Failed(3), Running(20)]
// codes: 0+10+105-3+20=132
construct EnxStatusIndexedFold() extends Test {
    test {
        var statuses: [EnxStatus] = []
        statuses.append(.Dormant)
        statuses.append(.Running(10))
        statuses.append(.Done(5))
        statuses.append(.Failed(3))
        statuses.append(.Running(20))
        var acc = 0
        var j = 0
        while j < statuses.count {
            acc = acc + enxStatusCode(statuses[j])
            j = j + 1
        }
        return acc
    }
    expect { let e: Result<Int, TestFailure> = .Ok(132); return e }
}

// ---------------------------------------------------------------------------
// EnxNode — mixed payload/payload-less (Leaf, Tagged, Empty)
// ---------------------------------------------------------------------------

construct EnxNodeLeafDirect() extends Test {
    test { return enxNodeVal(.Leaf(7)) }
    expect { let e: Result<Int, TestFailure> = .Ok(7); return e }
}

construct EnxNodeTaggedDirect() extends Test {
    test { return enxNodeVal(.Tagged(4)) }
    expect { let e: Result<Int, TestFailure> = .Ok(40); return e }
}

construct EnxNodeEmptyDirect() extends Test {
    test { return enxNodeVal(.Empty) }
    expect { let e: Result<Int, TestFailure> = .Ok(0); return e }
}

// [Leaf(5),Tagged(3),Empty,Leaf(7),Tagged(1),Empty,Leaf(2)] -> 5+30+0+7+10+0+2=54
construct EnxNodeArrayFold() extends Test {
    test {
        let ns: [EnxNode] = [.Leaf(5), .Tagged(3), .Empty, .Leaf(7), .Tagged(1), .Empty, .Leaf(2)]
        var s = 0
        for n in ns {
            s = s + enxNodeVal(n)
        }
        return s
    }
    expect { let e: Result<Int, TestFailure> = .Ok(54); return e }
}

// Indexed access via borrow helper
// [Leaf(3), Tagged(2), Empty, Leaf(10)] via enxNodeVal(nodes[j])
// 3+20+0+10=33
construct EnxNodeIndexedFold() extends Test {
    test {
        var nodes: [EnxNode] = []
        nodes.append(.Leaf(3))
        nodes.append(.Tagged(2))
        nodes.append(.Empty)
        nodes.append(.Leaf(10))
        var acc = 0
        var j = 0
        while j < nodes.count {
            acc = acc + enxNodeVal(nodes[j])
            j = j + 1
        }
        return acc
    }
    expect { let e: Result<Int, TestFailure> = .Ok(33); return e }
}

// Count Leaf nodes in [Leaf(1),Empty,Leaf(2),Tagged(3),Leaf(4),Empty] -> 3
construct EnxNodeCountLeaves() extends Test {
    test {
        let ns: [EnxNode] = [.Leaf(1), .Empty, .Leaf(2), .Tagged(3), .Leaf(4), .Empty]
        var count = 0
        for n in ns {
            count = count + enxIsLeaf(n)
        }
        return count
    }
    expect { let e: Result<Int, TestFailure> = .Ok(3); return e }
}

// ---------------------------------------------------------------------------
// Enum as struct field — EnxItem
// ---------------------------------------------------------------------------

// EnxItem{Low, 4} -> 4
construct EnxItemScoreLow() extends Test {
    test {
        let item = EnxItem { priority: .Low, value: 4 }
        return enxItemScore(item)
    }
    expect { let e: Result<Int, TestFailure> = .Ok(4); return e }
}

// EnxItem{Medium, 3} -> 15
construct EnxItemScoreMedium() extends Test {
    test {
        let item = EnxItem { priority: .Medium, value: 3 }
        return enxItemScore(item)
    }
    expect { let e: Result<Int, TestFailure> = .Ok(15); return e }
}

// EnxItem{High, 2} -> 20
construct EnxItemScoreHigh() extends Test {
    test {
        let item = EnxItem { priority: .High, value: 2 }
        return enxItemScore(item)
    }
    expect { let e: Result<Int, TestFailure> = .Ok(20); return e }
}

// [L(2),M(3),H(1),L(4),H(2),M(1)] -> 2+15+10+4+20+5=56
construct EnxItemLiteralArrayFold() extends Test {
    test {
        let items: [EnxItem] = [
            EnxItem { priority: .Low,    value: 2 },
            EnxItem { priority: .Medium, value: 3 },
            EnxItem { priority: .High,   value: 1 },
            EnxItem { priority: .Low,    value: 4 },
            EnxItem { priority: .High,   value: 2 },
            EnxItem { priority: .Medium, value: 1 }
        ]
        var s = 0
        for item in items {
            s = s + enxItemScore(item)
        }
        return s
    }
    expect { let e: Result<Int, TestFailure> = .Ok(56); return e }
}

// Dynamic build: i=0..5, item{priorityFor(i%3), value: i+1}
// i=0:L,v=1->1; i=1:M,v=2->10; i=2:H,v=3->30; i=3:L,v=4->4; i=4:M,v=5->25; i=5:H,v=6->60
// sum=130
construct EnxItemDynFold() extends Test {
    test {
        var acc = 0
        var i = 0
        while i < 6 {
            let item = EnxItem { priority: enxPriorityFor(i), value: i + 1 }
            acc = acc + enxItemScore(item)
            i = i + 1
        }
        return acc
    }
    expect { let e: Result<Int, TestFailure> = .Ok(130); return e }
}

// ---------------------------------------------------------------------------
// Combined / cross-enum tests
// ---------------------------------------------------------------------------

// sum (enxDirWeight(enxDirFor(i)) + enxSeasonCode(enxSeasonFor(i))) for i=0..7:
// i=0: N(1)+Spr(10)=11, i=1: S(2)+Sum(20)=22, i=2: E(3)+Aut(30)=33, i=3: W(4)+Win(40)=44
// i=4: N(1)+Spr(10)=11, i=5: S(2)+Sum(20)=22, i=6: E(3)+Aut(30)=33, i=7: W(4)+Win(40)=44
// sum=220
construct EnxDirSeasonCombinedFold() extends Test {
    test {
        var acc = 0
        var i = 0
        while i < 8 {
            let dw = enxDirWeight(enxDirFor(i))
            let sc = enxSeasonCode(enxSeasonFor(i))
            acc = acc + dw + sc
            i = i + 1
        }
        return acc
    }
    expect { let e: Result<Int, TestFailure> = .Ok(220); return e }
}

// sum (enxTokenVal(enxTokenFor(i)) + enxPriorityScore(enxPriorityFor(i))) for i=0..5:
// i=0:Num(0)->0+Low->1=1
// i=1:Paren(1)->2+Med->5=7
// i=2:Op(2)->6+High->10=16
// i=3:Num(3)->3+Low->1=4
// i=4:Paren(4)->8+Med->5=13
// i=5:Op(5)->15+High->10=25
// sum=66
construct EnxTokenPriorityPairFold() extends Test {
    test {
        var acc = 0
        var i = 0
        while i < 6 {
            let tv = enxTokenVal(enxTokenFor(i))
            let pv = enxPriorityScore(enxPriorityFor(i))
            acc = acc + tv + pv
            i = i + 1
        }
        return acc
    }
    expect { let e: Result<Int, TestFailure> = .Ok(66); return e }
}

// Dirs 0..11 + Seasons 0..11:
// dirs: 3*(1+2+3+4)=30, seasons: 3*(10+20+30+40)=300 -> 330
construct EnxDirPlusSeasonFolds() extends Test {
    test {
        var dirAcc = 0
        var seaAcc = 0
        var i = 0
        while i < 12 {
            dirAcc = dirAcc + enxDirWeight(enxDirFor(i))
            seaAcc = seaAcc + enxSeasonCode(enxSeasonFor(i))
            i = i + 1
        }
        return dirAcc + seaAcc
    }
    expect { let e: Result<Int, TestFailure> = .Ok(330); return e }
}

// Nested: for each priority band, sum token values with that priority weight as multiplier.
// i=0..8: token(i) value * priorityScore(priorityFor(i))
// i=0:Num(0)*L(1)=0, i=1:Paren(1)*M(5)=10, i=2:Op(2)*H(10)=60
// i=3:Num(3)*L(1)=3, i=4:Paren(4)*M(5)=40, i=5:Op(5)*H(10)=150
// i=6:Num(6)*L(1)=6, i=7:Paren(7)*M(5)=70, i=8:Op(8)*H(10)=240
// sum=0+10+60+3+40+150+6+70+240=579
construct EnxTokenPriorityMultiplyFold() extends Test {
    test {
        var acc = 0
        var i = 0
        while i < 9 {
            let tv = enxTokenVal(enxTokenFor(i))
            let ps = enxPriorityScore(enxPriorityFor(i))
            acc = acc + tv * ps
            i = i + 1
        }
        return acc
    }
    expect { let e: Result<Int, TestFailure> = .Ok(579); return e }
}

// Event scores + dir weights for same index i=0..5:
// i=0: Click(0)=0+North=1=1... wait, EnxEvent doesn't have a For function.
// Let me just do [Click(1),Key(1),Scroll(1),Idle,Click(2),Key(2)] scores=1+10+100+0+2+20=133
// plus Dir 0..5 weights: 1+2+3+4+1+2=13
// total=146
construct EnxEventPlusDirFold() extends Test {
    test {
        let es: [EnxEvent] = [.Click(1), .Key(1), .Scroll(1), .Idle, .Click(2), .Key(2)]
        var eAcc = 0
        for ev in es {
            eAcc = eAcc + enxEventScore(ev)
        }
        var dAcc = 0
        var i = 0
        while i < 6 {
            dAcc = dAcc + enxDirWeight(enxDirFor(i))
            i = i + 1
        }
        return eAcc + dAcc
    }
    expect { let e: Result<Int, TestFailure> = .Ok(146); return e }
}

// ---------------------------------------------------------------------------
// State-machine-style tests (Status transitions as scalar sequence)
// ---------------------------------------------------------------------------

// Simulate: 3 steps of Running(n) advancing n by 5 each step, check final code
// n0=7, n1=12, n2=17: code of Running(17)=17
construct EnxStatusRunningProgress() extends Test {
    test {
        var n = 7
        var steps = 0
        while steps < 3 {
            n = n + 5
            steps = steps + 1
        }
        return enxStatusCode(.Running(n))
    }
    expect { let e: Result<Int, TestFailure> = .Ok(22); return e }
}

// Status code sum for a specific sequence:
// [Dormant, Running(3), Running(6), Done(3), Failed(1), Done(10)]
// codes: 0+3+6+103+(-1)+110=221
construct EnxStatusSequenceFold() extends Test {
    test {
        let ss: [EnxStatus] = [
            .Dormant,
            .Running(3),
            .Running(6),
            .Done(3),
            .Failed(1),
            .Done(10)
        ]
        var acc = 0
        for s in ss {
            acc = acc + enxStatusCode(s)
        }
        return acc
    }
    expect { let e: Result<Int, TestFailure> = .Ok(221); return e }
}

// Max status code in [Running(5), Done(2), Running(8), Failed(3)]:
// codes: 5, 102, 8, -3 -> max=102
construct EnxStatusMaxCode() extends Test {
    test {
        let ss: [EnxStatus] = [.Running(5), .Done(2), .Running(8), .Failed(3)]
        var mx = 0 - 99999
        for s in ss {
            let c = enxStatusCode(s)
            if c > mx {
                mx = c }
        }
        return mx
    }
    expect { let e: Result<Int, TestFailure> = .Ok(102); return e }
}

// ---------------------------------------------------------------------------
// TRAP tests
// ---------------------------------------------------------------------------

// OOB on array of EnxDir
construct EnxTrapDirArrayOOB() extends Test {
    test {
        let ds: [EnxDir] = [.North, .South, .East]
        let _ = enxDirWeight(ds[10])
        return 0
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Runtime("")); return e }
}

// OOB on array of EnxToken
construct EnxTrapTokenArrayOOB() extends Test {
    test {
        let ts: [EnxToken] = [.Num(1), .Paren(2)]
        let _ = enxTokenVal(ts[5])
        return 0
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Runtime("")); return e }
}

// OOB on array of EnxStatus
construct EnxTrapStatusArrayOOB() extends Test {
    test {
        var ss: [EnxStatus] = []
        ss.append(.Dormant)
        ss.append(.Running(1))
        let _ = enxStatusCode(ss[100])
        return 0
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Runtime("")); return e }
}

// Div by zero derived from enum payload: Token.Num(0) -> val=0, then 10/val
construct EnxTrapDivByTokenPayload() extends Test {
    test {
        let t: EnxToken = .Num(0)
        let val = enxTokenVal(t)
        return 10 / val
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Runtime("")); return e }
}

// Mod by zero derived from enum payload
construct EnxTrapModByTokenPayload() extends Test {
    test {
        let t: EnxToken = .Op(0)
        let val = enxTokenVal(t)
        return 42 % val
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Runtime("")); return e }
}

// OOB on empty EnxNode array
construct EnxTrapNodeEmptyArrayOOB() extends Test {
    test {
        let ns: [EnxNode] = []
        let _ = enxNodeVal(ns[0])
        return 0
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Runtime("")); return e }
}

// Div zero via status payload: Failed(0) -> code = 0-0 = 0, then 5/0
construct EnxTrapDivByStatusCode() extends Test {
    test {
        let s: EnxStatus = .Failed(0)
        let code = enxStatusCode(s)
        return 5 / code
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Runtime("")); return e }
}

// OOB via computed index from enum: Leaf(100) -> val=100, index into 3-elem array
construct EnxTrapOOBFromLeafPayload() extends Test {
    test {
        let n: EnxNode = .Leaf(100)
        let idx = enxNodeVal(n)
        let xs: [Int] = [1, 2, 3]
        let _ = xs[idx]
        return 0
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Runtime("")); return e }
}

// OOB in loop that scans an array of EnxEvent with wrong count
construct EnxTrapEventOOBInLoop() extends Test {
    test {
        let events: [EnxEvent] = [.Click(1), .Idle]
        var acc = 0
        var i = 0
        while i < 10 {
            acc = acc + enxEventScore(events[i])
            i = i + 1
        }
        return acc
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Runtime("")); return e }
}

// Div zero from direction weight difference: North(1)-North(1)=0, then 7/(w1-w2)
construct EnxTrapDivByDirDiff() extends Test {
    test {
        let d1: EnxDir = .North
        let d2: EnxDir = .North
        let diff = enxDirWeight(d1) - enxDirWeight(d2)
        return 7 / diff
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Runtime("")); return e }
}
