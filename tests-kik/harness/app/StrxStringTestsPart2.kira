construct StrxLblNamed() extends Test {
    test {
        let l: StrxLbl = .Named("hello")
        return strxLblLen(l)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(5) return e }
}

construct StrxLblEmpty() extends Test {
    test {
        let l: StrxLbl = .Empty
        return strxLblLen(l)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(0) return e }
}

construct StrxLblNamedZero() extends Test {
    test {
        let l: StrxLbl = .Named("")
