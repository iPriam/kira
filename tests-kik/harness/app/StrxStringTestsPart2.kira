import Foundation

// StrxStringTests.kira — deep string coverage for `kira test`.
// PREFIX: strx / Strx  (all top-level names use this prefix).
// This file imports Foundation (imports are file-scoped); harness flat namespace already has it.

// ---------------------------------------------------------------------------
// Array of structs with String fields
// ---------------------------------------------------------------------------

construct StrxBoxArrCount() extends Test {
    test {
        var boxes: [StrxBox] = []
        var i = 0
        while i < 8 {
            let nm = strxPk(i)
            boxes.append(StrxBox { name: move nm, code: i })
            i = i + 1
        }
        return boxes.count
    }
    expect { let e: Result<Any, TestFailure> = .Ok(8) return e }
}

construct StrxBoxArrSum() extends Test {
    test {
        var boxes: [StrxBox] = []
        var i = 0
        while i < 10 {
            let nm = strxPk(i)
            boxes.append(StrxBox { name: move nm, code: 0 })
            i = i + 1
        }
        var total = 0
        var j = 0
        while j < boxes.count {
            total = total + boxes[j].nameLen()
            j = j + 1
        }
        return total
    }
    // 2 periods of 15 = 30
    expect { let e: Result<Any, TestFailure> = .Ok(30) return e }
}

construct StrxBoxArrIdx3() extends Test {
    test {
        var boxes: [StrxBox] = []
        var i = 0
        while i < 10 {
            let nm = strxPk(i)
            boxes.append(StrxBox { name: move nm, code: i })
            i = i + 1
        }
        return boxes[3].name.count
    }
    // i=3 -> strxPk(3) = "by" = 2
    expect { let e: Result<Any, TestFailure> = .Ok(2) return e }
}

construct StrxBoxArrIdxCode() extends Test {
    test {
        var boxes: [StrxBox] = []
        var i = 0
        while i < 6 {
            let nm = strxPk(i)
            boxes.append(StrxBox { name: move nm, code: i * 10 })
            i = i + 1
        }
        return boxes[4].code
    }
    // i=4 -> code = 40
    expect { let e: Result<Any, TestFailure> = .Ok(40) return e }
}

// ---------------------------------------------------------------------------
// Nested struct with String field
// ---------------------------------------------------------------------------

construct StrxOutLen1() extends Test {
    test {
        let o = StrxBoxOuter {
            inner: StrxBoxInner { word: "hello" },
            tag: "ab",
            n: 10
        }
        return strxOutLen(o)
    }
    // 5 + 2 + 10 = 17
    expect { let e: Result<Any, TestFailure> = .Ok(17) return e }
}

construct StrxOutLen2() extends Test {
    test {
        let o = StrxBoxOuter {
            inner: StrxBoxInner { word: "" },
            tag: "xyz",
            n: 0
        }
        return strxOutLen(o)
    }
    // 0 + 3 + 0 = 3
    expect { let e: Result<Any, TestFailure> = .Ok(3) return e }
}

construct StrxOutDirect() extends Test {
    test {
        let o = StrxBoxOuter {
            inner: StrxBoxInner { word: "abcd" },
            tag: "xy",
            n: 5
        }
        return o.inner.word.count
    }
    // "abcd" = 4
    expect { let e: Result<Any, TestFailure> = .Ok(4) return e }
}

construct StrxOutTagCount() extends Test {
    test {
        let o = StrxBoxOuter {
            inner: StrxBoxInner { word: "test" },
            tag: "kira",
            n: 0
        }
        return o.tag.count
    }
    // "kira" = 4
    expect { let e: Result<Any, TestFailure> = .Ok(4) return e }
}

construct StrxOutTwoFields() extends Test {
    test {
        let o = StrxBoxOuter {
            inner: StrxBoxInner { word: "abcde" },
            tag: "xy",
            n: 3
        }
        return o.inner.word.count + o.tag.count
    }
    // 5 + 2 = 7
    expect { let e: Result<Any, TestFailure> = .Ok(7) return e }
}

construct StrxInnerWordLen() extends Test {
    test {
        let inn = StrxBoxInner { word: "hello" }
        return inn.word.count
    }
    // 5
    expect { let e: Result<Any, TestFailure> = .Ok(5) return e }
}

