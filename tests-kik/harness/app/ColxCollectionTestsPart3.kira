import Foundation

// ColxCollectionTests.kira
// Deep array test suite. All top-level names use colx / Colx prefix.
// ~85 tests (including ~20 trap tests).

// ---------------------------------------------------------------------------
// GROUP I - ColxGrid
// ---------------------------------------------------------------------------

construct ColxGridSum5() extends Test {
    test {
        var cells: [Int] = []
        cells.append(1)
        cells.append(2)
        cells.append(3)
        cells.append(4)
        cells.append(5)
        let grid = ColxGrid { cells: move cells }
        return grid.sum()
    }
    expect { let e: Result<Int, TestFailure> = .Ok(15); return e }
}

construct ColxGridCellCount7() extends Test {
    test {
        var cells: [Int] = []
        var i = 0
        while i < 7 {
            cells.append(i)
            i = i + 1
        }
        let grid = ColxGrid { cells: move cells }
        return grid.cellCount()
    }
    expect { let e: Result<Int, TestFailure> = .Ok(7); return e }
}

construct ColxGridLarge100() extends Test {
    test {
        var cells: [Int] = []
        var i = 0
        while i < 100 {
            cells.append(i)
            i = i + 1
        }
        let grid = ColxGrid { cells: move cells }
        return grid.sum()
    }
    // 0+1+...+99 = 4950
    expect { let e: Result<Int, TestFailure> = .Ok(4950); return e }
}

construct ColxGridMultiRowSum() extends Test {
    test {
        // 3 grids with 4 cells each: grid r has cells r*4, r*4+1, r*4+2, r*4+3
        var total = 0
        var r = 0
        while r < 3 {
            var cells: [Int] = []
            var c = 0
            while c < 4 {
                cells.append(r * 4 + c)
                c = c + 1
            }
            let grid = ColxGrid { cells: move cells }
            total = total + grid.sum()
            r = r + 1
        }
        return total
    }
    // r=0: 0+1+2+3=6, r=1: 4+5+6+7=22, r=2: 8+9+10+11=38 -> 66
    expect { let e: Result<Int, TestFailure> = .Ok(66); return e }
}

