// GROUP K - Arithmetic and write traps
// ---------------------------------------------------------------------------

construct ColxTrapDivByZero() extends Test {
    test {
        let x = 10 / 0
        return x
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Runtime("")); return e }
}

construct ColxTrapModByZero() extends Test {
    test {
        let x = 10 % 0
        return x
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Runtime("")); return e }
}

