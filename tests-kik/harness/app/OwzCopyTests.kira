import Foundation

// OwzCopyTests.kira — the `copy` operator: a second, independent holder of a
// Copyable value, leaving the original usable.
// PREFIX: owz / Owz  (all top-level names use this prefix).

struct OwzPoint {
    var x: Int = 0
    var y: Int = 0
}

function owzTakePoint(p: OwzPoint) -> Int {
    return p.x * 10 + p.y
}

function owzTakeText(t: String) -> Int {
    return t.count
}

function owzTwice(n: copy Int) -> Int {
    return n * 2
}

construct OwzCopyOfAStructLeavesTheOriginal() extends Test {
    test {
        var p = OwzPoint()
        p.x = 3
        p.y = 4
        let first = owzTakePoint(copy p)
        p.y = 5
        return first * 100 + owzTakePoint(move p)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(3435) return e }
}

construct OwzCopyOfAStringLeavesTheOriginal() extends Test {
    test {
        let s = "hello"
        let first = owzTakeText(copy s)
        return first * 10 + s.count
    }
    expect { let e: Result<Any, TestFailure> = .Ok(55) return e }
}

construct OwzCopyParameterTakesAScalar() extends Test {
    test {
        let n = 21
        return owzTwice(copy n) + n
    }
    expect { let e: Result<Any, TestFailure> = .Ok(63) return e }
}

construct OwzCopyIsIndependentOfLaterWrites() extends Test {
    test {
        var p = OwzPoint()
        p.x = 1
        let snapshot = copy p
        p.x = 9
        return snapshot.x * 10 + p.x
    }
    expect { let e: Result<Any, TestFailure> = .Ok(19) return e }
}
