import Foundation

// EnxEnumTests.kira — Deep enum test suite.
// Covers: payload-less enums (4-variant, 3-variant, 4-variant), single-payload
// Int enums, mixed payload/payload-less enums, enums as struct fields, arrays
// of enums matched via borrow-param helpers, state-machine transitions, and
// trap tests.  All top-level names use prefix enx / Enx.

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum EnxDir {
    North
    South
    East
    West
}

enum EnxPriority {
    Low
    Medium
    High
}

enum EnxSeason {
    Spring
    Summer
    Autumn
    Winter
}

enum EnxToken {
    Num(Int)
    Paren(Int)
    Op(Int)
}

enum EnxEvent {
    Click(Int)
    Key(Int)
    Scroll(Int)
    Idle
}

// Mixed: one payload-less variant + three single-Int variants.
enum EnxStatus {
    Dormant
    Running(Int)
    Done(Int)
    Failed(Int)
}

// Three variants: two payload, one payload-less.
enum EnxNode {
    Leaf(Int)
    Tagged(Int)
    Empty
}

// ---------------------------------------------------------------------------
// Structs
// ---------------------------------------------------------------------------

struct EnxItem {
    var priority: EnxPriority
    var value: Int
}

// ---------------------------------------------------------------------------
// Helper functions — enums returned DIRECTLY from each branch (never via
// a mutable local that is reassigned, which miscompiles on LLVM).
// ---------------------------------------------------------------------------

function enxDirWeight(d: borrow EnxDir) -> Int {
    match d {
        North -> { return 1 }
        South -> { return 2 }
        East  -> { return 3 }
        West  -> { return 4 }
    }
}

// Returns an EnxDir for index i, so the variant comes from each arm.
function enxDirFor(i: Int) -> EnxDir {
    if (i % 4) == 0 {
        return .North
    } else if (i % 4) == 1 {
        return .South
    } else if (i % 4) == 2 {
        return .East
    } else if (i % 4) == 3 {
        return .West
    } else {
        return .North
    }
}

function enxPriorityScore(p: borrow EnxPriority) -> Int {
    match p {
        Low    -> { return 1 }
        Medium -> { return 5 }
        High   -> { return 10 }
    }
}

function enxPriorityFor(i: Int) -> EnxPriority {
    if (i % 3) == 0 {
        return .Low
    } else if (i % 3) == 1 {
        return .Medium
    } else if (i % 3) == 2 {
        return .High
    } else {
        return .Low
    }
}

function enxSeasonCode(s: borrow EnxSeason) -> Int {
    match s {
        Spring -> { return 10 }
        Summer -> { return 20 }
        Autumn -> { return 30 }
        Winter -> { return 40 }
    }
}

function enxSeasonFor(i: Int) -> EnxSeason {
    if (i % 4) == 0 {
        return .Spring
    } else if (i % 4) == 1 {
        return .Summer
    } else if (i % 4) == 2 {
        return .Autumn
    } else if (i % 4) == 3 {
        return .Winter
    } else {
        return .Spring
    }
}

function enxTokenVal(t: borrow EnxToken) -> Int {
    match t {
        Num(v)   -> { return v }
        Paren(v) -> { return v * 2 }
        Op(v)    -> { return v * 3 }
    }
}

function enxTokenFor(i: Int) -> EnxToken {
    if (i % 3) == 0 {
        return .Num(i)
    } else if (i % 3) == 1 {
        return .Paren(i)
    } else if (i % 3) == 2 {
        return .Op(i)
    } else {
        return .Num(0)
    }
}

function enxEventScore(e: borrow EnxEvent) -> Int {
    match e {
        Click(v)  -> { return v }
        Key(v)    -> { return v * 10 }
        Scroll(v) -> { return v * 100 }
        Idle      -> { return 0 }
    }
}

// Returns status code: Dormant=0, Running(n)=n, Done(n)=n+100, Failed(n)=-(n)
function enxStatusCode(s: borrow EnxStatus) -> Int {
    match s {
        Dormant    -> { return 0 }
        Running(n) -> { return n }
        Done(n)    -> { return n + 100 }
        Failed(n)  -> { return 0 - n }
    }
}

function enxStatusFor(i: Int) -> EnxStatus {
    if (i % 4) == 0 {
        return .Dormant
    } else if (i % 4) == 1 {
        return .Running(i)
    } else if (i % 4) == 2 {
        return .Done(i)
    } else if (i % 4) == 3 {
        return .Failed(i)
    } else {
        return .Dormant
    }
}

function enxNodeVal(n: borrow EnxNode) -> Int {
    match n {
        Leaf(v)   -> { return v }
        Tagged(v) -> { return v * 10 }
        Empty     -> { return 0 }
    }
}

// Scoring an EnxItem: Low uses raw value, Medium*5, High*10.
function enxItemScore(item: borrow EnxItem) -> Int {
    match item.priority {
        Low    -> { return item.value }
        Medium -> { return item.value * 5 }
        High   -> { return item.value * 10 }
    }
}

// Helpers for for-in / indexed matching (KSEM104: cannot match arr[i] or
// for-in bindings directly — must pass through a borrow-param function).

function enxIsIdleEvent(e: borrow EnxEvent) -> Int {
    match e {
        Idle      -> { return 1 }
        Click(v)  -> { return 0 }
        Key(v)    -> { return 0 }
        Scroll(v) -> { return 0 }
    }
}

function enxClickPayload(e: borrow EnxEvent) -> Int {
    match e {
        Click(v)  -> { return v }
        Key(v)    -> { return 0 }
        Scroll(v) -> { return 0 }
        Idle      -> { return 0 }
    }
}

function enxIsLeaf(n: borrow EnxNode) -> Int {
    match n {
        Leaf(v)   -> { return 1 }
        Tagged(v) -> { return 0 }
        Empty     -> { return 0 }
    }
}

// ---------------------------------------------------------------------------
// Payload-less enum tests — EnxDir
// ---------------------------------------------------------------------------

construct EnxDirWeightNorth() extends Test {
    test { return enxDirWeight(.North) }
    expect { let e: Result<Any, TestFailure> = .Ok(1) return e }
}

construct EnxDirWeightSouth() extends Test {
    test { return enxDirWeight(.South) }
    expect { let e: Result<Any, TestFailure> = .Ok(2) return e }
}

construct EnxDirWeightEast() extends Test {
    test { return enxDirWeight(.East) }
    expect { let e: Result<Any, TestFailure> = .Ok(3) return e }
}

construct EnxDirWeightWest() extends Test {
    test { return enxDirWeight(.West) }
    expect { let e: Result<Any, TestFailure> = .Ok(4) return e }
}

// Sum weights for i=0..59: 15 each of N,S,E,W -> 15*(1+2+3+4)=150
construct EnxDirFold60() extends Test {
    test {
        var acc = 0
        var i = 0
        while i < 60 {
            let d = enxDirFor(i)
            acc = acc + enxDirWeight(d)
            i = i + 1
        }
        return acc
    }
    expect { let e: Result<Any, TestFailure> = .Ok(150) return e }
}

// Specific array: N,E,S,W,N -> weights 1+3+2+4+1=11
construct EnxDirSpecificArray() extends Test {
    test {
        let ds: [EnxDir] = [.North, .East, .South, .West, .North]
        var s = 0
        for d in ds {
            s = s + enxDirWeight(d)
        }
        return s
    }
    expect { let e: Result<Any, TestFailure> = .Ok(11) return e }
}

// enxDirFor(0)=North, weight=1
construct EnxDirSwitchIndex0() extends Test {
    test {
        let d = enxDirFor(0)
        return enxDirWeight(d)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(1) return e }
}

// enxDirFor(7): 7%4=3=West, weight=4
construct EnxDirSwitchIndex7() extends Test {
    test {
        let d = enxDirFor(7)
        return enxDirWeight(d)
    }
    expect { let e: Result<Any, TestFailure> = .Ok(4) return e }
}

// Count Wests in i=0..11: i%4=3 at i=3,7,11 -> 3
construct EnxDirCountWest() extends Test {
    test {
        var count = 0
        var i = 0
        while i < 12 {
            let d = enxDirFor(i)
            var isWest = 0
            match d {
                West  -> { isWest = 1 }
                North -> { isWest = 0 }
                South -> { isWest = 0 }
                East  -> { isWest = 0 }
            }
            count = count + isWest
            i = i + 1
        }
        return count
    }
    expect { let e: Result<Any, TestFailure> = .Ok(3) return e }
}

// sum i * enxDirWeight(enxDirFor(i)) for i=0..7:
// i=0:0*1=0, i=1:1*2=2, i=2:2*3=6, i=3:3*4=12,
// i=4:4*1=4, i=5:5*2=10, i=6:6*3=18, i=7:7*4=28 -> sum=80
construct EnxDirWeightedFold() extends Test {
    test {
        var acc = 0
        var i = 0
        while i < 8 {
            let d = enxDirFor(i)
            acc = acc + i * enxDirWeight(d)
            i = i + 1
        }
        return acc
    }
    expect { let e: Result<Any, TestFailure> = .Ok(80) return e }
}

// Count North+South (weight<=2) in i=0..11: N at 0,4,8 + S at 1,5,9 = 6
construct EnxDirCountNorthSouth() extends Test {
    test {
        var count = 0
        var i = 0
        while i < 12 {
            let d = enxDirFor(i)
            let w = enxDirWeight(d)
            if w <= 2 {
                count = count + 1 }
            i = i + 1
        }
        return count
    }
    expect { let e: Result<Any, TestFailure> = .Ok(6) return e }
}

// Two complete cycles of N,S,E,W (8 items): 2*(1+2+3+4)=20
construct EnxDirFold8() extends Test {
    test {
        var acc = 0
        var i = 0
        while i < 8 {
            acc = acc + enxDirWeight(enxDirFor(i))
            i = i + 1
        }
        return acc
    }
    expect { let e: Result<Any, TestFailure> = .Ok(20) return e }
}

// Inline match in test block (var out pattern): East matches -> 3
construct EnxDirInlineMatchEast() extends Test {
    test {
        let d: EnxDir = .East
        var out = 0
        match d {
            North -> { out = 1 }
            South -> { out = 2 }
            East  -> { out = 3 }
            West  -> { out = 4 }
        }
        return out
    }
    expect { let e: Result<Any, TestFailure> = .Ok(3) return e }
}

// ---------------------------------------------------------------------------
// Payload-less enum tests — EnxPriority
// ---------------------------------------------------------------------------

construct EnxPriorityScoreLow() extends Test {
    test { return enxPriorityScore(.Low) }
    expect { let e: Result<Any, TestFailure> = .Ok(1) return e }
}

construct EnxPriorityScoreMedium() extends Test {
    test { return enxPriorityScore(.Medium) }
    expect { let e: Result<Any, TestFailure> = .Ok(5) return e }
}

construct EnxPriorityScoreHigh() extends Test {
    test { return enxPriorityScore(.High) }
    expect { let e: Result<Any, TestFailure> = .Ok(10) return e }
}

// 30 iters, 10 each of L,M,H: 10*(1+5+10)=160
construct EnxPriorityFold30() extends Test {
    test {
        var acc = 0
        var i = 0
        while i < 30 {
            let p = enxPriorityFor(i)
            acc = acc + enxPriorityScore(p)
            i = i + 1
        }
        return acc
    }
    expect { let e: Result<Any, TestFailure> = .Ok(160) return e }
}

// Count High in i=0..8: i%3=2 at i=2,5,8 -> 3
construct EnxPriorityCountHigh() extends Test {
    test {
        var count = 0
        var i = 0
        while i < 9 {
            let p = enxPriorityFor(i)
            var isH = 0
            match p {
                High   -> { isH = 1 }
                Medium -> { isH = 0 }
                Low    -> { isH = 0 }
            }
            count = count + isH
            i = i + 1
        }
        return count
    }
    expect { let e: Result<Any, TestFailure> = .Ok(3) return e }
}

// sum i * enxPriorityScore(enxPriorityFor(i)) for i=0..8:
// i=0:0*1=0, i=1:1*5=5, i=2:2*10=20, i=3:3*1=3, i=4:4*5=20,
// i=5:5*10=50, i=6:6*1=6, i=7:7*5=35, i=8:8*10=80 -> sum=219
construct EnxPriorityWeightedFold() extends Test {
    test {
        var acc = 0
        var i = 0
        while i < 9 {
            let p = enxPriorityFor(i)
            acc = acc + i * enxPriorityScore(p)
            i = i + 1
        }
        return acc
    }
    expect { let e: Result<Any, TestFailure> = .Ok(219) return e }
}

// Array of priorities, fold scores: [L,M,H,L,M] = 1+5+10+1+5=22
construct EnxPriorityArrayFold() extends Test {
    test {
        let ps: [EnxPriority] = [.Low, .Medium, .High, .Low, .Medium]
        var s = 0
        for p in ps {
            s = s + enxPriorityScore(p)
        }
        return s
    }
    expect { let e: Result<Any, TestFailure> = .Ok(22) return e }
}

// ---------------------------------------------------------------------------
// Payload-less enum tests — EnxSeason
// ---------------------------------------------------------------------------

construct EnxSeasonCodeSpring() extends Test {
    test { return enxSeasonCode(.Spring) }
    expect { let e: Result<Any, TestFailure> = .Ok(10) return e }
}

construct EnxSeasonCodeSummer() extends Test {
    test { return enxSeasonCode(.Summer) }
    expect { let e: Result<Any, TestFailure> = .Ok(20) return e }
}

construct EnxSeasonCodeAutumn() extends Test {
    test { return enxSeasonCode(.Autumn) }
    expect { let e: Result<Any, TestFailure> = .Ok(30) return e }
}

construct EnxSeasonCodeWinter() extends Test {
    test { return enxSeasonCode(.Winter) }
    expect { let e: Result<Any, TestFailure> = .Ok(40) return e }
}

// 40 iters, 10 each: 10*(10+20+30+40)=1000
construct EnxSeasonFold40() extends Test {
    test {
        var acc = 0
        var i = 0
        while i < 40 {
            let s = enxSeasonFor(i)
            acc = acc + enxSeasonCode(s)
            i = i + 1
        }
        return acc
    }
    expect { let e: Result<Any, TestFailure> = .Ok(1000) return e }
}

// Literal array: [Spr,Sum,Aut,Win,Spr] = 10+20+30+40+10=110
construct EnxSeasonSpecificArray() extends Test {
    test {
        let ss: [EnxSeason] = [.Spring, .Summer, .Autumn, .Winter, .Spring]
        var acc = 0
        for s in ss {
            acc = acc + enxSeasonCode(s)
        }
        return acc
    }
    expect { let e: Result<Any, TestFailure> = .Ok(110) return e }
}

// Count warm seasons (code <= 20, i.e. Spring+Summer) in i=0..11: 3+3=6
construct EnxSeasonCountWarm() extends Test {
    test {
        var count = 0
        var i = 0
        while i < 12 {
            let s = enxSeasonFor(i)
            let c = enxSeasonCode(s)
            if c <= 20 {
                count = count + 1 }
            i = i + 1
        }
        return count
    }
    expect { let e: Result<Any, TestFailure> = .Ok(6) return e }
}

// ---------------------------------------------------------------------------
// Single-payload enum tests — EnxToken
// ---------------------------------------------------------------------------

// Num(42) -> 42
construct EnxTokenNumDirect() extends Test {
    test { return enxTokenVal(.Num(42)) }
    expect { let e: Result<Any, TestFailure> = .Ok(42) return e }
}

// Paren(7) -> 7*2=14
construct EnxTokenParenDirect() extends Test {
    test { return enxTokenVal(.Paren(7)) }
    expect { let e: Result<Any, TestFailure> = .Ok(14) return e }
}

// Op(3) -> 3*3=9
construct EnxTokenOpDirect() extends Test {
    test { return enxTokenVal(.Op(3)) }
    expect { let e: Result<Any, TestFailure> = .Ok(9) return e }
}

// Fold for i=0..29:
// Nums(i=0,3,6,9,12,15,18,21,24,27): vals = 0+3+6+9+12+15+18+21+24+27=135
// Parens(i=1,4,7,10,13,16,19,22,25,28): sum=145, *2=290
// Ops(i=2,5,8,11,14,17,20,23,26,29): sum=155, *3=465
// total=135+290+465=890
construct EnxTokenFold30() extends Test {
    test {
        var acc = 0
        var i = 0
        while i < 30 {
            let t = enxTokenFor(i)
            acc = acc + enxTokenVal(t)
            i = i + 1
        }
        return acc
    }
    expect { let e: Result<Any, TestFailure> = .Ok(890) return e }
}

// Literal array: [Num(7),Paren(3),Op(2),Num(1),Paren(5)] -> 7+6+6+1+10=30
construct EnxTokenLiteralArrayFold() extends Test {
    test {
        let ts: [EnxToken] = [.Num(7), .Paren(3), .Op(2), .Num(1), .Paren(5)]
        var s = 0
        for t in ts {
            s = s + enxTokenVal(t)
        }
        return s
    }
    expect { let e: Result<Any, TestFailure> = .Ok(30) return e }
}

// Indexed access via borrow helper: tokens[j] passed to enxTokenVal(borrow EnxToken)
// Array: [Num(10), Op(4), Paren(3)] -> 10+12+6=28
construct EnxTokenIndexedAccessFold() extends Test {
    test {
        var ts: [EnxToken] = []
        ts.append(.Num(10))
        ts.append(.Op(4))
        ts.append(.Paren(3))
        var acc = 0
        var j = 0
        while j < ts.count {
            acc = acc + enxTokenVal(ts[j])
            j = j + 1
        }
        return acc
    }
    expect { let e: Result<Any, TestFailure> = .Ok(28) return e }
}

// sum (i+1)*enxTokenVal(enxTokenFor(i)) for i=0..5:
// i=0:Num(0)->0, 1*0=0
// i=1:Paren(1)->2, 2*2=4
// i=2:Op(2)->6, 3*6=18
// i=3:Num(3)->3, 4*3=12
// i=4:Paren(4)->8, 5*8=40
// i=5:Op(5)->15, 6*15=90
// total=0+4+18+12+40+90=164
construct EnxTokenWeightedFold() extends Test {
    test {
        var acc = 0
        var i = 0
        while i < 6 {
            let t = enxTokenFor(i)
            acc = acc + (i + 1) * enxTokenVal(t)
            i = i + 1
        }
        return acc
    }
    expect { let e: Result<Any, TestFailure> = .Ok(164) return e }
}

// Inline match in test block (var out pattern)
// Num(5) -> out=5
construct EnxTokenInlineMatchNum() extends Test {
    test {
        let t: EnxToken = .Num(5)
        var out = 0
        match t {
            Num(v)   -> { out = v }
            Paren(v) -> { out = v * 2 }
            Op(v)    -> { out = v * 3 }
        }
        return out
    }
    expect { let e: Result<Any, TestFailure> = .Ok(5) return e }
}

// Inline match in test block: Op(4) -> 12
construct EnxTokenInlineMatchOp() extends Test {
    test {
        let t: EnxToken = .Op(4)
        var out = 0
        match t {
            Num(v)   -> { out = v }
            Paren(v) -> { out = v * 2 }
            Op(v)    -> { out = v * 3 }
        }
        return out
    }
    expect { let e: Result<Any, TestFailure> = .Ok(12) return e }
}

// Sum only Num values in i=0..8 (ignore Paren/Op):
// Nums at i%3=0: i=0,3,6 -> Num(0)->0, Num(3)->3, Num(6)->6 -> sum=9
construct EnxTokenSumNumsOnly() extends Test {
    test {
        var acc = 0
        var i = 0
        while i < 9 {
            let t = enxTokenFor(i)
            var v = 0
            match t {
                Num(x)   -> { v = x }
                Paren(x) -> { v = 0 }
                Op(x)    -> { v = 0 }
            }
            acc = acc + v
            i = i + 1
        }
        return acc
    }
    expect { let e: Result<Any, TestFailure> = .Ok(9) return e }
}

