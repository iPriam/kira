// sum buildRange(m) for m=1..6:
// 0 + 3 + 9 + 18 + 30 + 45 = 105
construct EnxGRangeSumFold() extends Test {
    test {
        var total = 0
        var m = 1
        while m <= 6 {
            let r = enxGBuildRange(m)
            match r {
                Ok(xs) -> {
                    var i = 0
                    while i < xs.count {
                        total = total + xs[i]
                        i = i + 1
                    }
                }
                Error(e) -> { total = total + enxGErrCode(e) }
            }
            m = m + 1
        }
        return total
    }
    expect { let e: Result<Any, TestFailure> = .Ok(105) return e }
}

