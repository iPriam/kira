            Error(e) -> { out = enxGErrCode(e) }
        }
        return out
    }
    expect { let e: Result<Any, TestFailure> = .Ok(3) return e }
}

// buildRange(1) -> Ok([0]) -> sum=0
construct EnxGRangeSingleElem() extends Test {
    test {
        let r = enxGBuildRange(1)
        var out = 0
