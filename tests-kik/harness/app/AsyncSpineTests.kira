import Foundation

// Kira Test coverage for the deferred async task spine: `async function`
// entry points (started only as tasks), `Task { call }` deferred spawn, `handle.await` join, cooperative
// `requestCancel()` (cancel-before-drive prevents the call; awaiting a
// cancelled task traps), `detach()` (drives and discards; a later await is a
// double-join trap).

construct AsxAsyncFunctionRunsAsATask() extends Test {
    test {
        let handle = Task { asyncSum(19, 23) }
        return handle.await
    }
    expect { let e: Result<Any, TestFailure> = .Ok(42) return e }
}

construct AsxAsyncCallsOrdinaryFunctions() extends Test {
    test {
        let handle = Task { asyncDouble(21) }
        return handle.await
    }
    expect { let e: Result<Any, TestFailure> = .Ok(42) return e }
}

construct AsxAsyncWrapsRecursion() extends Test {
    test {
        let handle = Task { asyncFactorial(5) }
        return handle.await
    }
    expect { let e: Result<Any, TestFailure> = .Ok(120) return e }
}

construct AsxTaskSpawnAwait() extends Test {
    test {
        let handle = Task { asyncFactorial(5) }
        return handle.await
    }
    expect { let e: Result<Any, TestFailure> = .Ok(120) return e }
}

construct AsxAwaitYieldsDeferredResult() extends Test {
    test {
        let handle = Task { asyncSum(40, 2) }
        return handle.await
    }
    expect { let e: Result<Any, TestFailure> = .Ok(42) return e }
}

construct AsxAwaitCancelledTaskTraps() extends Test {
    test {
        let handle = Task { asyncSum(40, 2) }
        handle.requestCancel()
        return handle.await
    }
    expect { let e: Result<Any, TestFailure> = .Error(.Runtime("")) return e }
}

construct AsxDoubleAwaitTraps() extends Test {
    test {
        let handle = Task { asyncSum(40, 2) }
        let first = handle.await
        return first + handle.await
    }
    expect { let e: Result<Any, TestFailure> = .Error(.Runtime("")) return e }
}

construct AsxAwaitAfterDetachTraps() extends Test {
    test {
        let handle = Task { asyncSum(40, 2) }
        handle.detach()
        return handle.await
    }
    expect { let e: Result<Any, TestFailure> = .Error(.Runtime("")) return e }
}

construct AsxCancelledSiblingLeavesJoinIntact() extends Test {
    test {
        return asyncCancelDetachSiblings()
    }
    expect { let e: Result<Any, TestFailure> = .Ok(142) return e }
}

construct AsxReadySpawnAwait() extends Test {
    test {
        let handle = Task { 41 }
        return handle.await + 1
    }
    expect { let e: Result<Any, TestFailure> = .Ok(42) return e }
}

construct AsxVoidTaskJoinsAsZero() extends Test {
    test {
        let handle = Task { asyncNoop(5) }
        return handle.await
    }
    expect { let e: Result<Any, TestFailure> = .Ok(0) return e }
}

construct AsxVoidTaskDetach() extends Test {
    test {
        let handle = Task { asyncNoop(5) }
        handle.detach()
        return 1
    }
    expect { let e: Result<Any, TestFailure> = .Ok(1) return e }
}

construct AsxYieldWithEmptyQueueIsNoop() extends Test {
    test {
        taskYield()
        return 1
    }
    expect { let e: Result<Any, TestFailure> = .Ok(1) return e }
}

construct AsxYieldInsideTaskBody() extends Test {
    test {
        let sibling = Task { asyncSum(1, 2) }
        let phased = Task { asyncPhased(4, 2) }
        let joined = phased.await
        return joined + sibling.await
    }
    expect { let e: Result<Any, TestFailure> = .Ok(243) return e }
}

construct AsxSuspendableFrameSurvivesYields() extends Test {
    test {
        let handle = Task { asyncStepper(100, 1) }
        return handle.await
    }
    expect { let e: Result<Any, TestFailure> = .Ok(102) return e }
}

construct AsxSuspendableTasksInterleave() extends Test {
    test {
        let a = Task { asyncStepper(100, 1) }
        let b = Task { asyncStepper(200, 2) }
        let c = Task { asyncStepper(300, 3) }
        return a.await + b.await + c.await
    }
    expect { let e: Result<Any, TestFailure> = .Ok(612) return e }
}

construct AsxCancelledSuspendableNeverRuns() extends Test {
    test {
        let handle = Task { asyncStepper(100, 1) }
        handle.requestCancel()
        return handle.await
    }
    expect { let e: Result<Any, TestFailure> = .Error(.Runtime("")) return e }
}

construct AsxJoinSuspensionParksUntilComplete() extends Test {
    test {
        let c = Task { asyncCoordinator(100) }
        let bystander = Task { asyncSum(1, 2) }
        return c.await + bystander.await
    }
    expect { let e: Result<Any, TestFailure> = .Ok(114) return e }
}

construct AsxSleepParksAndResumes() extends Test {
    test {
        let a = Task { asyncNapper(3, 40) }
        let b = Task { asyncNapper(1, 2) }
        return a.await * 10 + b.await
    }
    expect { let e: Result<Any, TestFailure> = .Ok(424) return e }
}

construct AsxSpineSectionChecksum() extends Test {
    test {
        return asyncSpineSection()
    }
    expect { let e: Result<Any, TestFailure> = .Ok(304) return e }
}
