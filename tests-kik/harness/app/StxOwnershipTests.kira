import Foundation

// StxOwnershipTests: deep ownership tests — move into consuming functions,
// owned aggregates, borrow (shared and mut) writeback, pipeline of moves,
// copy vs. move semantics, and runtime traps.
//
// All top-level names use the Stxo/stxo prefix to avoid harness namespace
// collisions. This file imports Foundation explicitly (imports are file-scoped).

// ---------------------------------------------------------------------------
// Struct definitions
// ---------------------------------------------------------------------------

struct StxoVec {
    var x: Int
    var y: Int
    var z: Int
}

struct StxoBox {
    var min: StxoVec
    var max: StxoVec
    var id: Int
}

struct StxoBag {
    var items: [Int]
    var label: Int
}

struct StxoWrap {
    var inner: StxoVec
    var weight: Int
}

// ---------------------------------------------------------------------------
// Helper functions
// ---------------------------------------------------------------------------

function stxoVecSum(v: borrow StxoVec) -> Int { return v.x + v.y + v.z }

function stxoConsumeVec(v: StxoVec) -> Int { return v.x + v.y + v.z }

function stxoConsumeBox(b: StxoBox) -> Int { return b.min.x + b.max.x + b.id }

function stxoConsumeBag(b: StxoBag) -> Int {
    var s = b.label
    for i in 0..b.items.count {
        s = s + b.items[i]
    }
    return s
}

function stxoConsumeArr(xs: [Int]) -> Int {
    var s = 0
    for i in 0..xs.count {
        s = s + xs[i]
    }
    return s
}

function stxoBumpVec(v: borrow mut StxoVec) {
    v.x = v.x + 1
    v.y = v.y + 1
    v.z = v.z + 1
    return
}

function stxoDoubleVec(v: borrow mut StxoVec) {
    v.x = v.x * 2
    v.y = v.y * 2
    v.z = v.z * 2
    return
}

function stxoScaleVec(v: borrow mut StxoVec, k: Int) {
    v.x = v.x * k
    v.y = v.y * k
    v.z = v.z * k
    return
}

function stxoPipeAdd(v: StxoVec, n: Int) -> StxoVec {
    return StxoVec { x: v.x + n, y: v.y + n, z: v.z + n }
}

function stxoPipeMul(v: StxoVec, k: Int) -> StxoVec {
    return StxoVec { x: v.x * k, y: v.y * k, z: v.z * k }
}

function stxoPipeNeg(v: StxoVec) -> StxoVec {
    return StxoVec { x: 0 - v.x, y: 0 - v.y, z: 0 - v.z }
}

function stxoWrap(v: StxoVec, w: Int) -> StxoWrap {
    return StxoWrap { inner: move v, weight: w }
}

function stxoUnwrap(c: StxoWrap) -> Int {
    return c.inner.x + c.inner.y + c.inner.z + c.weight
}

function stxoBuildBag(n: Int) -> StxoBag {
    var xs: [Int] = []
    var i = 1
    while i <= n {
        xs.append(i)
        i = i + 1
    }
    return StxoBag { items: move xs, label: n }
}

// ---------------------------------------------------------------------------
// Group 1: Move into consuming functions
// ---------------------------------------------------------------------------

construct StxoMoveVec() extends Test {
    // consume {1,2,3} → 6
    test { let v = StxoVec { x: 1, y: 2, z: 3 }; return stxoConsumeVec(move v) }
    expect { let e: Result<Int, TestFailure> = .Ok(6); return e }
}

construct StxoMoveVecVar() extends Test {
    // consume from var binding
    test { var v = StxoVec { x: 10, y: 20, z: 30 }; return stxoConsumeVec(move v) }
    expect { let e: Result<Int, TestFailure> = .Ok(60); return e }
}

construct StxoMoveBox() extends Test {
    // consume box: min.x + max.x + id = 1 + 2 + 3 = 6
    test {
        let b = StxoBox {
            min: StxoVec { x: 1, y: 0, z: 0 },
            max: StxoVec { x: 2, y: 0, z: 0 },
            id: 3
        }
        return stxoConsumeBox(move b)
    }
    expect { let e: Result<Int, TestFailure> = .Ok(6); return e }
}

construct StxoMoveBoxLarge() extends Test {
    // min.x=10, max.x=100, id=5 → 115
    test {
        let b = StxoBox {
            min: StxoVec { x: 10, y: 20, z: 30 },
            max: StxoVec { x: 100, y: 200, z: 300 },
            id: 5
        }
        return stxoConsumeBox(move b)
    }
    expect { let e: Result<Int, TestFailure> = .Ok(115); return e }
}

construct StxoMoveBag0() extends Test {
    // stxoBuildBag(0): label=0, items=[], consume→0
    test { let b = stxoBuildBag(0); return stxoConsumeBag(move b) }
    expect { let e: Result<Int, TestFailure> = .Ok(0); return e }
}

construct StxoMoveBag5() extends Test {
    // stxoBuildBag(5): label=5, items=[1..5], consume=5+15=20
    test { let b = stxoBuildBag(5); return stxoConsumeBag(move b) }
    expect { let e: Result<Int, TestFailure> = .Ok(20); return e }
}

construct StxoMoveArr3() extends Test {
    // xs=[10,20,30], consume→60
    test {
        var xs: [Int] = []
        xs.append(10)
        xs.append(20)
        xs.append(30)
        return stxoConsumeArr(move xs)
    }
    expect { let e: Result<Int, TestFailure> = .Ok(60); return e }
}

construct StxoMovePipeAdd() extends Test {
    // v={1,2,3}, pipeAdd(5)={6,7,8}, consume→21
    test {
        let v = StxoVec { x: 1, y: 2, z: 3 }
        let w = stxoPipeAdd(move v, 5)
        return stxoConsumeVec(move w)
    }
    expect { let e: Result<Int, TestFailure> = .Ok(21); return e }
}

construct StxoMovePipeMul() extends Test {
    // v={2,3,4}, pipeMul(10)={20,30,40}, consume→90
    test {
        let v = StxoVec { x: 2, y: 3, z: 4 }
        let w = stxoPipeMul(move v, 10)
        return stxoConsumeVec(move w)
    }
    expect { let e: Result<Int, TestFailure> = .Ok(90); return e }
}

construct StxoMoveVecLoop() extends Test {
    // i=0..9: v={i,i,i}, consume→3i; total=3*(0+1+..+9)=3*45=135
    test {
        var acc = 0
        var i = 0
        while i < 10 {
            let v = StxoVec { x: i, y: i, z: i }
            acc = acc + stxoConsumeVec(move v)
            i = i + 1
        }
        return acc
    }
    expect { let e: Result<Int, TestFailure> = .Ok(135); return e }
}

construct StxoMoveBagLoop() extends Test {
    // n=1..5: consumeBag(n)=n+n*(n+1)/2 → 2+5+9+14+20=50
    test {
        var acc = 0
        var n = 1
        while n <= 5 {
            let b = stxoBuildBag(n)
            acc = acc + stxoConsumeBag(move b)
            n = n + 1
        }
        return acc
    }
    expect { let e: Result<Int, TestFailure> = .Ok(50); return e }
}

construct StxoMoveArrLoop() extends Test {
    // i=0..9: xs=[i], consume→i; total=0+1+..+9=45
    test {
        var acc = 0
        var i = 0
        while i < 10 {
            var xs: [Int] = []
            xs.append(i)
            acc = acc + stxoConsumeArr(move xs)
            i = i + 1
        }
        return acc
    }
    expect { let e: Result<Int, TestFailure> = .Ok(45); return e }
}

construct StxoMoveBoxLoop() extends Test {
    // i=1..3: box={min.x:i, max.x:i*2, id:i*3}, consume=i+i*2+i*3=6i; total=6+12+18=36
    test {
        var acc = 0
        var i = 1
        while i <= 3 {
            let b = StxoBox {
                min: StxoVec { x: i, y: 0, z: 0 },
                max: StxoVec { x: i * 2, y: 0, z: 0 },
                id: i * 3
            }
            acc = acc + stxoConsumeBox(move b)
            i = i + 1
        }
        return acc
    }
    expect { let e: Result<Int, TestFailure> = .Ok(36); return e }
}

construct StxoMovePipeline() extends Test {
    // v={2,3,4}, pipeAdd(10)={12,13,14}, pipeMul(2)={24,26,28}, consume→78
    test {
        let v = StxoVec { x: 2, y: 3, z: 4 }
        let w = stxoPipeAdd(move v, 10)
        let x = stxoPipeMul(move w, 2)
        return stxoConsumeVec(move x)
    }
    expect { let e: Result<Int, TestFailure> = .Ok(78); return e }
}

construct StxoMoveWrapUnwrap() extends Test {
    // v={3,4,5}, wrap weight=10, unwrap=3+4+5+10=22
    test {
        let v = StxoVec { x: 3, y: 4, z: 5 }
        let c = stxoWrap(move v, 10)
        return stxoUnwrap(move c)
    }
    expect { let e: Result<Int, TestFailure> = .Ok(22); return e }
}

construct StxoMoveBag10() extends Test {
    // stxoBuildBag(10): label=10, items=[1..10], consume=10+55=65
    test { let b = stxoBuildBag(10); return stxoConsumeBag(move b) }
    expect { let e: Result<Int, TestFailure> = .Ok(65); return e }
}

// ---------------------------------------------------------------------------
// Group 2: Borrow (non-consuming) then keep using
// ---------------------------------------------------------------------------

construct StxoBorrowSum() extends Test {
    // borrow v, get sum=18
    test { let v = StxoVec { x: 5, y: 6, z: 7 }; return stxoVecSum(v) }
    expect { let e: Result<Int, TestFailure> = .Ok(18); return e }
}

construct StxoBorrowOrigX() extends Test {
    // borrow to get sum, then access original field
    test {
        let v = StxoVec { x: 5, y: 6, z: 7 }
        let s = stxoVecSum(v)
        return v.x
    }
    expect { let e: Result<Int, TestFailure> = .Ok(5); return e }
}

construct StxoBorrowTwice() extends Test {
    // borrow twice, both return same value; sum=2*12=24
    test {
        let v = StxoVec { x: 3, y: 4, z: 5 }
        let s1 = stxoVecSum(v)
        let s2 = stxoVecSum(v)
        return s1 + s2
    }
    expect { let e: Result<Int, TestFailure> = .Ok(24); return e }
}

construct StxoBorrowInLoop() extends Test {
    // borrow same v 5x in loop; acc=5*6=30
    test {
        let v = StxoVec { x: 1, y: 2, z: 3 }
        var acc = 0
        var i = 0
        while i < 5 {
            acc = acc + stxoVecSum(v)
            i = i + 1
        }
        return acc
    }
    expect { let e: Result<Int, TestFailure> = .Ok(30); return e }
}

construct StxoBorrowThenField() extends Test {
    // borrow, get sum=60, then access original v.z=30; total=90
    test {
        let v = StxoVec { x: 10, y: 20, z: 30 }
        let s = stxoVecSum(v)
        return s + v.z
    }
    expect { let e: Result<Int, TestFailure> = .Ok(90); return e }
}

construct StxoBorrowThenModify() extends Test {
    // borrow v to get s=6, then mutate v.x=10; v.x + s = 16
    test {
        var v = StxoVec { x: 1, y: 2, z: 3 }
        let s = stxoVecSum(v)
        v.x = 10
        return v.x + s
    }
    expect { let e: Result<Int, TestFailure> = .Ok(16); return e }
}

construct StxoBorrowBoxField() extends Test {
    // b.min.x + b.max.z + b.id = 1 + 6 + 7 = 14
    test {
        let b = StxoBox {
            min: StxoVec { x: 1, y: 2, z: 3 },
            max: StxoVec { x: 4, y: 5, z: 6 },
            id: 7
        }
        return b.min.x + b.max.z + b.id
    }
    expect { let e: Result<Int, TestFailure> = .Ok(14); return e }
}

construct StxoBorrowBeforeAfterMut() extends Test {
    // v={5,5,5}, borrow→s1=15; bumpVec→{6,6,6}; borrow→s2=18; s2-s1=3
    test {
        var v = StxoVec { x: 5, y: 5, z: 5 }
        let s1 = stxoVecSum(v)
        stxoBumpVec(v)
        let s2 = stxoVecSum(v)
        return s2 - s1
    }
    expect { let e: Result<Int, TestFailure> = .Ok(3); return e }
}

construct StxoBorrowLoopSum() extends Test {
    // v starts {0,0,0}; each iteration: bump (v→{i,i,i}), add stxoVecSum=3i
    // acc = sum 3i for i=1..10 = 3*55=165
    test {
        var v = StxoVec { x: 0, y: 0, z: 0 }
        var acc = 0
        var i = 0
        while i < 10 {
            stxoBumpVec(v)
            acc = acc + stxoVecSum(v)
            i = i + 1
        }
        return acc
    }
    expect { let e: Result<Int, TestFailure> = .Ok(165); return e }
}

construct StxoBorrowConsistency() extends Test {
    // stxoVecSum(v) == v.x + v.y + v.z
    test {
        let v = StxoVec { x: 7, y: 8, z: 9 }
        return stxoVecSum(v) == v.x + v.y + v.z
    }
    expect { let e: Result<Bool, TestFailure> = .Ok(true); return e }
}

construct StxoBorrowSumField() extends Test {
    // v={4,6,8}, sum=18; sum + v.y = 24
    test {
        let v = StxoVec { x: 4, y: 6, z: 8 }
        let s = stxoVecSum(v)
        return s + v.y
    }
    expect { let e: Result<Int, TestFailure> = .Ok(24); return e }
}

construct StxoBorrowBagItems() extends Test {
    // stxoBuildBag(5): items=[1,2,3,4,5]; items[0]+items[4]=1+5=6
    test {
        var b = stxoBuildBag(5)
        return b.items[0] + b.items[4]
    }
    expect { let e: Result<Int, TestFailure> = .Ok(6); return e }
}

// ---------------------------------------------------------------------------
// Group 3: Borrow mut writeback
// ---------------------------------------------------------------------------

construct StxoBumpOnce() extends Test {
    // v={5,5,5}, bump→{6,6,6}, v.x=6
    test {
        var v = StxoVec { x: 5, y: 5, z: 5 }
        stxoBumpVec(v)
        return v.x
    }
    expect { let e: Result<Int, TestFailure> = .Ok(6); return e }
}

construct StxoBumpSum() extends Test {
    // v={1,2,3}, bump→{2,3,4}, sum=9
    test {
        var v = StxoVec { x: 1, y: 2, z: 3 }
        stxoBumpVec(v)
        return v.x + v.y + v.z
    }
    expect { let e: Result<Int, TestFailure> = .Ok(9); return e }
}

construct StxoBumpLoop10() extends Test {
    // v={0,0,0}, 10x bump → v.x=10
    test {
        var v = StxoVec { x: 0, y: 0, z: 0 }
        var i = 0
        while i < 10 {
            stxoBumpVec(v)
            i = i + 1
        }
        return v.x
    }
    expect { let e: Result<Int, TestFailure> = .Ok(10); return e }
}

construct StxoDoubleOnce() extends Test {
    // v={3,4,5}, double→{6,8,10}, v.x=6
    test {
        var v = StxoVec { x: 3, y: 4, z: 5 }
        stxoDoubleVec(v)
        return v.x
    }
    expect { let e: Result<Int, TestFailure> = .Ok(6); return e }
}

construct StxoDoubleLoop5() extends Test {
    // v={1,1,1}, 5x double → v.x=2^5=32
    test {
        var v = StxoVec { x: 1, y: 1, z: 1 }
        var i = 0
        while i < 5 {
            stxoDoubleVec(v)
            i = i + 1
        }
        return v.x
    }
    expect { let e: Result<Int, TestFailure> = .Ok(32); return e }
}

construct StxoScaleK() extends Test {
    // v={3,4,5}, scale(7): {21,28,35}, sum=84
    test {
        var v = StxoVec { x: 3, y: 4, z: 5 }
        stxoScaleVec(v, 7)
        return v.x + v.y + v.z
    }
    expect { let e: Result<Int, TestFailure> = .Ok(84); return e }
}

construct StxoBumpThenDouble() extends Test {
    // v={2,3,4}, bump→{3,4,5}, bump→{4,5,6}, double→{8,10,12}, v.x=8
    test {
        var v = StxoVec { x: 2, y: 3, z: 4 }
        stxoBumpVec(v)
        stxoBumpVec(v)
        stxoDoubleVec(v)
        return v.x
    }
    expect { let e: Result<Int, TestFailure> = .Ok(8); return e }
}

construct StxoBumpThenBorrow() extends Test {
    // v={5,5,5}, bump→{6,6,6}, stxoVecSum=18
    test {
        var v = StxoVec { x: 5, y: 5, z: 5 }
        stxoBumpVec(v)
        return stxoVecSum(v)
    }
    expect { let e: Result<Int, TestFailure> = .Ok(18); return e }
}

construct StxoScaleLoop3() extends Test {
    // v={1,2,3}, 3x scale(2): v.x = 1*2*2*2=8
    test {
        var v = StxoVec { x: 1, y: 2, z: 3 }
        var i = 0
        while i < 3 {
            stxoScaleVec(v, 2)
            i = i + 1
        }
        return v.x
    }
    expect { let e: Result<Int, TestFailure> = .Ok(8); return e }
}

construct StxoBumpSum20() extends Test {
    // v={0,0,0}, 20x bump → v.x=v.y=v.z=20, sum=60
    test {
        var v = StxoVec { x: 0, y: 0, z: 0 }
        var i = 0
        while i < 20 {
            stxoBumpVec(v)
            i = i + 1
        }
        return v.x + v.y + v.z
    }
    expect { let e: Result<Int, TestFailure> = .Ok(60); return e }
}

construct StxoScaleThenBump() extends Test {
    // v={2,2,2}, scale(5)→{10,10,10}, bump→{11,11,11}, v.x=11
    test {
        var v = StxoVec { x: 2, y: 2, z: 2 }
        stxoScaleVec(v, 5)
        stxoBumpVec(v)
        return v.x
    }
    expect { let e: Result<Int, TestFailure> = .Ok(11); return e }
}

construct StxoBumpZ20() extends Test {
    // v={0,0,0}, 20x bump → v.z=20
    test {
        var v = StxoVec { x: 0, y: 0, z: 0 }
        var i = 0
        while i < 20 {
            stxoBumpVec(v)
            i = i + 1
        }
        return v.z
    }
    expect { let e: Result<Int, TestFailure> = .Ok(20); return e }
}

