import Foundation

// MxxMacroTests.kira
// Declarative macro tests (mx / Mxx prefix). Macros expand in the frontend, so these run
// identically on vm / llvm / hybrid.

macro mxSquare(value: expr) {
    expand {
        value * value
    }
}

macro mxAdd3(a: expr, b: expr, c: expr) {
    expand {
        a + b + c
    }
}

macro mxSwap(a: place, b: place) {
    expand {
        let temporary = a
        a = b
        b = temporary
    }
}

construct MxxSquare() extends Test {
    test { return mxSquare!(6) }
    expect { let e: Result<Int, TestFailure> = .Ok(36); return e }
}

construct MxxAdd3() extends Test {
    test { return mxAdd3!(1, 2, 3) }
    expect { let e: Result<Int, TestFailure> = .Ok(6); return e }
}

construct MxxSwapAndHygiene() extends Test {
    test {
        var x = 10
        var y = 20
        mxSwap!(x, y)
        // Hygiene: the macro's internal `temporary` must not collide with this one.
        let temporary = 100
        return x + y + temporary
    }
    expect { let e: Result<Int, TestFailure> = .Ok(130); return e }
}

construct MxxNestedExprSingleEval() extends Test {
    test {
        // square used in a larger expression -> hoisted single-eval, then used.
        let r = mxSquare!(3) + mxSquare!(4)
        return r
    }
    expect { let e: Result<Int, TestFailure> = .Ok(25); return e }
}

// --- Procedural derive macros (comptime macro) ------------------------------
// These run a compile-time evaluator: target.fields reflection, for-loops, quote/splice,
// Syntax.join, then re-parse + splice of the generated functions. Validated across backends.

comptime macro MxFieldCount {
    kind { derive }
    appliesTo { struct }
    expand(target: Declaration) -> Syntax {
        var count: Int = 0
        for field in target.fields {
            count = count + 1
        }
        return quote {
            function mxVecFieldCount() -> Int {
                return #{count}
            }
        }
    }
}

comptime macro MxSum {
    kind { derive }
    appliesTo { struct }
    expand(target: Declaration) -> Syntax {
        var parts: [Syntax] = []
        for field in target.fields {
            parts.append(quote { p.#{field.name} })
        }
        let joined: Syntax = Syntax.join(parts, separator: " + ")
        return quote {
            function mxSumVec(p: borrow MxVec3) -> Int {
                return #{joined}
            }
        }
    }
}

@Derive(MxFieldCount, MxSum)
struct MxVec3 {
    var x: Int
    var y: Int
    var z: Int
}

construct MxxDeriveFieldCount() extends Test {
    test { return mxVecFieldCount() }
    expect { let e: Result<Int, TestFailure> = .Ok(3); return e }
}

construct MxxDeriveSum() extends Test {
    test {
        let v = MxVec3 { x: 4, y: 5, z: 6 }
        return mxSumVec(v)
    }
    expect { let e: Result<Int, TestFailure> = .Ok(15); return e }
}

// --- Procedural attribute macro (@Name) -------------------------------------

comptime macro MxTagged {
    kind { attribute }
    appliesTo { struct }
    expand(target: Declaration) -> Syntax {
        var count: Int = 0
        for field in target.fields {
            count = count + 1
        }
        return quote {
            function mxTaggedFieldCount() -> Int {
                return #{count}
            }
        }
    }
}

@MxTagged
struct MxTagHolder {
    var a: Int
    var b: Int
}

construct MxxAttributeMacro() extends Test {
    test { return mxTaggedFieldCount() }
    expect { let e: Result<Int, TestFailure> = .Ok(2); return e }
}

// --- Procedural function-position macro (name!(args) -> declarations) --------

comptime macro mxBits {
    kind { function }
    expand(input: Syntax) -> Syntax {
        let names: [Identifier] = input.identifiers()
        var fns: [Syntax] = []
        var value: Int = 1
        for name in names {
            fns.append(quote {
                function #{name}() -> Int {
                    return #{value}
                }
            })
            value = value * 2
        }
        return quote {
            #{fns}
        }
    }
}

mxBits!(MxRead, MxWrite, MxExec)

construct MxxFunctionMacro() extends Test {
    test { return MxRead() + MxWrite() + MxExec() }
    expect { let e: Result<Int, TestFailure> = .Ok(7); return e }
}

// --- Function-position procedural macro in EXPRESSION position --------------
// The macro's expansion must re-parse as a single expression that becomes the value.

comptime macro mxConst {
    kind { function }
    expand(input: Syntax) -> Syntax {
        return quote { 42 }
    }
}

construct MxxFuncMacroExpr() extends Test {
    test { return mxConst!() }
    expect { let e: Result<Int, TestFailure> = .Ok(42); return e }
}

// --- Function-position procedural macro in STATEMENT position ---------------
// Procedural macros generate raw source (no hygiene gensym), so `r` binds the caller's `r`.

comptime macro mxAssignTen {
    kind { function }
    expand(input: Syntax) -> Syntax {
        return quote {
            r = 10
        }
    }
}

construct MxxFuncMacroStmt() extends Test {
    test {
        var r = 0
        mxAssignTen!()
        return r
    }
    expect { let e: Result<Int, TestFailure> = .Ok(10); return e }
}

// --- Mid-identifier splice gluing (`mxp_#{name}` -> `mxp_Foo`) ---------------

comptime macro mxPrefixed {
    kind { function }
    expand(input: Syntax) -> Syntax {
        let names: [Identifier] = input.identifiers()
        var fns: [Syntax] = []
        for name in names {
            fns.append(quote {
                function mxp_#{name}() -> Int {
                    return 1
                }
            })
        }
        return quote {
            #{fns}
        }
    }
}

mxPrefixed!(Foo, Bar)

construct MxxSpliceGlue() extends Test {
    test { return mxp_Foo() + mxp_Bar() }
    expect { let e: Result<Int, TestFailure> = .Ok(2); return e }
}

// --- Enum annotations: derive macro over an enum ----------------------------
// Enum variants surface through `target.fields` reflection (name = variant name).

comptime macro mxVariantCount {
    kind { derive }
    appliesTo { enum }
    expand(target: Declaration) -> Syntax {
        var count: Int = 0
        for field in target.fields {
            count = count + 1
        }
        return quote {
            function mxEnumVariantCount() -> Int {
                return #{count}
            }
        }
    }
}

@Derive(mxVariantCount)
enum MxColor {
    Red
    Green
    Blue
}

construct MxxEnumDerive() extends Test {
    test { return mxEnumVariantCount() }
    expect { let e: Result<Int, TestFailure> = .Ok(3); return e }
}

// --- Property-wrapper attribute macro (@PropertyWrapper) ---------------------
// Validates the annotated struct exposes a `wrappedValue` field, records whether it also has
// `projectedValue`, and generates free query functions (name-glued to the type via mid-identifier
// splice) reporting that conformance. Kira `extend` applies only to *constructs* and there is no
// `static`, so conformance is surfaced as generated free functions rather than the
// `extend T: Conformance { static let ... }` sketch in the property-wrapper docs. The missing-`wrappedValue`
// diagnostic path (KMAC021) is covered by tests/fail/semantics/macro_property_wrapper_missing.

comptime macro MxPropertyWrapper {
    kind { attribute }
    appliesTo { struct }
    expand(target: Declaration) -> Syntax {
        var hasWrapped: Bool = false
        var hasProjected: Bool = false
        for field in target.fields {
            if field.name.asString() == "wrappedValue" {
                hasWrapped = true
            }
            if field.name.asString() == "projectedValue" {
                hasProjected = true
            }
        }
        if hasWrapped == false {
            Diagnostics.error("PropertyWrapper requires a wrappedValue field", at: target.syntax)
            return quote { }
        }
        return quote {
            function is_#{target.name}_propertyWrapper() -> Bool {
                return true
            }
            function has_#{target.name}_projectedValue() -> Bool {
                return #{hasProjected}
            }
        }
    }
}

@MxPropertyWrapper
struct MxStateWrapper {
    var wrappedValue: Int
    var projectedValue: Bool
}

@MxPropertyWrapper
struct MxPlainWrapper {
    var wrappedValue: Int
}

construct MxxPropertyWrapperConformance() extends Test {
    test { return is_MxStateWrapper_propertyWrapper() }
    expect { let e: Result<Bool, TestFailure> = .Ok(true); return e }
}

construct MxxPropertyWrapperHasProjected() extends Test {
    test { return has_MxStateWrapper_projectedValue() }
    expect { let e: Result<Bool, TestFailure> = .Ok(true); return e }
}

construct MxxPropertyWrapperNoProjected() extends Test {
    test { return has_MxPlainWrapper_projectedValue() }
    expect { let e: Result<Bool, TestFailure> = .Ok(false); return e }
}

// --- Wrapper rewrite: a wrapped property as a named argument ------------------
// `f(count = count)` is a call with a LABEL, not an assignment. The rewrite
// leaves the label where it is and routes only the value beside it through the
// wrapper's reader; treating the label as a write produced `f(set_count(...))`,
// which is neither the call the author wrote nor a legal one.

comptime macro MxWrap {
    kind { wrapper }
    appliesTo { form }

    expand(target: Declaration, wrapper: Declaration) -> Syntax {
        if target.name.asString() == wrapper.name.asString() {
            return quote { }
        }
        var monos: [Syntax] = []
        var accessors: [Syntax] = []
        var rewritten: Syntax = target.syntax
        for field in target.fields {
            if field.hasAnnotation(wrapper.name.asString()) {
                let monoName = "__mx_" + target.name.asString() + "_" + field.name.asString()
                var mono: Syntax = wrapper.syntax.replaceIdentifier(wrapper.name.asString(), monoName)
                mono = mono.replaceIdentifier("Wrapped", field.type.asSyntax())
                monos.append(mono)
                accessors.append(quote {
                    function __mx_#{target.name}_get_#{field.name}() -> #{field.type.asSyntax()} {
                        let backing = __mx_#{target.name}_#{field.name} {
                            wrappedValue: #{field.initializer}
                        }
                        return backing.get()
                    }
                    function __mx_#{target.name}_set_#{field.name}(value: #{field.type.asSyntax()}) {
                        let backing = __mx_#{target.name}_#{field.name} {
                            wrappedValue: #{field.initializer}
                        }
                        backing.set(move value)
                        return
                    }
                })
                rewritten = rewritten.dropField(field.name)
                rewritten = rewritten.rewriteProperty(
                    field.name,
                    quote { __mx_#{target.name}_get_#{field.name}() },
                    quote { __mx_#{target.name}_set_#{field.name} }
                )
            }
        }
        return quote {
            #{monos}
            #{accessors}
            #{rewritten}
        }
    }
}

@MxWrap
struct MxSeed {
    var wrappedValue: Wrapped

    function get() -> Wrapped {
        return self.wrappedValue
    }

    function set(value: Wrapped) {
        let ignored = value
        return
    }
}

construct MxCounter {
    @Required function total() -> Int
}

function mxAddOne(count: Int) -> Int {
    return count + 1
}

construct MxLabelledCall() extends MxCounter {
    @MxSeed var count: Int = 7

    function total() -> Int {
        return mxAddOne(count = count)
    }
}

construct MxxWrappedPropertyIsANamedArgumentLabel() extends Test {
    test { return MxLabelledCall().total() }
    expect { let e: Result<Int, TestFailure> = .Ok(8); return e }
}

// --- String(syntax): a macro reads its input as plain text -------------------
// Reflection hands a macro its input as syntax; `String` renders the text it
// was written with, so a lint or generator can search and join it.

comptime macro mxMarkerText {
    kind { function }
    expand(input: Syntax) -> Syntax {
        let text: String = String(input)
        var answer: Int = 0
        if text.contains("marker") {
            answer = answer + 1
        }
        if text.contains("+") {
            answer = answer + 10
        }
        return quote {
            function mxMarkerTextResult() -> Int {
                return #{answer}
            }
        }
    }
}

mxMarkerText!(let marker = 7 + 2)

construct MxxStringOfSyntax() extends Test {
    test { return mxMarkerTextResult() }
    expect { let e: Result<Int, TestFailure> = .Ok(11); return e }
}
