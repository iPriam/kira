Test StrxClsBaseFieldSum {
    test {
        let v = StrxCVehicle()
        let c = StrxCCar()
        let t = StrxCTruck()
        return v.base + c.base + t.base
    }
    // 5 + 10 + 15 = 30
    expect { let e: Result<Int, TestFailure> = .Ok(30); return e }
