    test {
        let v = StrxCVehicle()
        return v.cost(10)
    }
    // 5+10 = 15
    expect { let e: Result<Int, TestFailure> = .Ok(15); return e }
}

construct StrxClsCarCost10() extends Test {
    test {
        let c = StrxCCar()
        return c.cost(10)
    }
    // 10+10*2 = 30
    expect { let e: Result<Int, TestFailure> = .Ok(30); return e }
