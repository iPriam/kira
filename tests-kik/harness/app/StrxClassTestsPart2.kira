construct StrxClsTruckCost10() extends Test {
    test {
        let t = StrxCTruck()
        return t.cost(10)
    }
    // StrxCCar.cost(10)=15+20=35; +3=38
    expect { let e: Result<Int, TestFailure> = .Ok(38); return e }
