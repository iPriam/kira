import Foundation

// StrxClassTests.kira — deep class/inheritance coverage for `kira test`.
// PREFIX: strx / Strx  (all top-level names use this prefix).
//
// PARITY RULE: no inherited base method ever calls self.<m>() where a
// descendant overrides <m>. Super-calls use only parent-qualified
// Parent.method() inside overrides. Inherited methods read only self fields
// or call parent-qualified methods, which is consistent across all backends.

// ---------------------------------------------------------------------------
// H4 Tests
// ---------------------------------------------------------------------------

construct StrxClsVehicleCost5() extends Test {
    test {
        let v = StrxCVehicle()
        return v.cost(5)
    }
    // 5 + 5 = 10
    expect { let e: Result<Int, TestFailure> = .Ok(10); return e }
}

construct StrxClsCarCost5() extends Test {
    test {
        let c = StrxCCar()
        return c.cost(5)
    }
    // 10 + 5*2 = 20
    expect { let e: Result<Int, TestFailure> = .Ok(20); return e }
}

construct StrxClsTruckCost5() extends Test {
    test {
        let t = StrxCTruck()
        return t.cost(5)
    }
    // StrxCCar.cost(5) = 15+10 = 25; +3 = 28
    expect { let e: Result<Int, TestFailure> = .Ok(28); return e }
}

construct StrxClsVehicleLoop() extends Test {
    test {
        let v = StrxCVehicle()
        var acc = 0
        var km = 0
        while km < 5 {
            acc = acc + v.cost(km)
            km = km + 1
        }
        return acc
    }
    // sum(5+km for km=0..4) = 5+6+7+8+9 = 35
    expect { let e: Result<Int, TestFailure> = .Ok(35); return e }
}

construct StrxClsCarLoop() extends Test {
    test {
        let c = StrxCCar()
        var acc = 0
        var km = 0
        while km < 5 {
            acc = acc + c.cost(km)
            km = km + 1
        }
        return acc
    }
    // sum(10+km*2 for km=0..4) = 10+12+14+16+18 = 70
    expect { let e: Result<Int, TestFailure> = .Ok(70); return e }
}

construct StrxClsTruckLoop() extends Test {
    test {
        let t = StrxCTruck()
        var acc = 0
        var km = 0
        while km < 5 {
            acc = acc + t.cost(km)
            km = km + 1
        }
        return acc
    }
    // StrxCCar.cost(km)=15+km*2 then +3; sum(18+km*2 for km=0..4) = 18+20+22+24+26 = 110
    expect { let e: Result<Int, TestFailure> = .Ok(110); return e }
}

