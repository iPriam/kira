import Foundation

// StrxStringTests.kira — deep string coverage for `kira test`.
// PREFIX: strx / Strx  (all top-level names use this prefix).
// This file imports Foundation (imports are file-scoped); harness flat namespace already has it.

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

function strxBorLen(s: borrow String) -> Int {
    return s.count
}

function strxMvLen(s: String) -> Int {
    return s.count
}

// Returns one of 5 strings by i%5.
// Period: "apple"(5) "go"(2) "three"(5) "by"(2) "x"(1) → sum per period = 15
function strxPk(i: Int) -> String {
    let m = i % 5
    if m == 0 {
        return "apple" }
    if m == 1 {
        return "go" }
    if m == 2 {
        return "three" }
    if m == 3 {
        return "by" }
    return "x"
}

// ---------------------------------------------------------------------------
// Structs
// ---------------------------------------------------------------------------

struct StrxBox {
    var name: String
    var code: Int

    function nameLen() -> Int {
        return self.name.count
    }

    function coded() -> Int {
        return self.code + 1
    }
}

function strxBoxBor(b: borrow StrxBox) -> Int {
    return b.name.count + b.code
}

struct StrxBoxInner {
    var word: String
}

struct StrxBoxOuter {
    var inner: StrxBoxInner
    var tag: String
    var n: Int
}

function strxOutLen(o: borrow StrxBoxOuter) -> Int {
    return o.inner.word.count + o.tag.count + o.n
}

// ---------------------------------------------------------------------------
// Enum with String payload
// ---------------------------------------------------------------------------

enum StrxLbl {
    Named(String)
    Empty
}

function strxLblLen(l: borrow StrxLbl) -> Int {
    match l {
        Named(s) -> { return s.count }
        Empty -> { return 0 }
    }
}

// Period of 3: Named("hello")(5), Empty(0), Named("ok")(2) → sum = 7
function strxLblFor(i: Int) -> StrxLbl {
    let m = i % 3
    if m == 0 {
        return .Named("hello") }
    if m == 1 {
        return .Empty }
    return .Named("ok")
}

// ---------------------------------------------------------------------------
// Literal .count tests
// ---------------------------------------------------------------------------

construct StrxLitA() extends Test {
    test { return "a".count }
    expect { let e: Result<Int, TestFailure> = .Ok(1); return e }
}

construct StrxLitHello() extends Test {
    test { return "hello".count }
    expect { let e: Result<Int, TestFailure> = .Ok(5); return e }
}

construct StrxLitEmpty() extends Test {
    test { return "".count }
    expect { let e: Result<Int, TestFailure> = .Ok(0); return e }
}

construct StrxLitTen() extends Test {
    test { return "abcdefghij".count }
    expect { let e: Result<Int, TestFailure> = .Ok(10); return e }
}

construct StrxLitKira() extends Test {
    test { return "kira".count }
    expect { let e: Result<Int, TestFailure> = .Ok(4); return e }
}

construct StrxLitSpace() extends Test {
    test { return "hello world".count }
    expect { let e: Result<Int, TestFailure> = .Ok(11); return e }
}

construct StrxLitTwelve() extends Test {
    test { return "123456789012".count }
    expect { let e: Result<Int, TestFailure> = .Ok(12); return e }
}

// ---------------------------------------------------------------------------
// Borrow-len helper tests
// ---------------------------------------------------------------------------

construct StrxBorLitXyz() extends Test {
    test { return strxBorLen("xyz") }
    expect { let e: Result<Int, TestFailure> = .Ok(3); return e }
}

construct StrxBorLitEmpty() extends Test {
    test { return strxBorLen("") }
    expect { let e: Result<Int, TestFailure> = .Ok(0); return e }
}

construct StrxBorVar() extends Test {
    test {
        let s = "reuse"
        return strxBorLen(s)
    }
    expect { let e: Result<Int, TestFailure> = .Ok(5); return e }
}

construct StrxBorVarTwice() extends Test {
    test {
        let s = "ab"
        var out = strxBorLen(s)
        out = out + strxBorLen(s)
        return out
    }
    // 2 + 2 = 4
    expect { let e: Result<Int, TestFailure> = .Ok(4); return e }
}

construct StrxBorSix() extends Test {
    test { return strxBorLen("abcdef") }
    expect { let e: Result<Int, TestFailure> = .Ok(6); return e }
}

construct StrxBorMixed() extends Test {
    test {
        var out = strxBorLen("xy")
        out = out + strxBorLen("abc")
        return out
    }
    // 2 + 3 = 5
    expect { let e: Result<Int, TestFailure> = .Ok(5); return e }
}

// ---------------------------------------------------------------------------
// Move-len helper tests
// ---------------------------------------------------------------------------

construct StrxMvLit() extends Test {
    test { return strxMvLen(move "consume") }
    expect { let e: Result<Int, TestFailure> = .Ok(7); return e }
}

construct StrxMvVar() extends Test {
    test {
        let s = "transfer"
        return strxMvLen(move s)
    }
    expect { let e: Result<Int, TestFailure> = .Ok(8); return e }
}

// ---------------------------------------------------------------------------
// String-returning function tests (bind result before .count)
// ---------------------------------------------------------------------------

construct StrxPkApple() extends Test {
    test {
        let s = strxPk(0)
        return s.count
    }
    // "apple" = 5
    expect { let e: Result<Int, TestFailure> = .Ok(5); return e }
}

construct StrxPkGo() extends Test {
    test {
        let s = strxPk(1)
        return s.count
    }
    // "go" = 2
    expect { let e: Result<Int, TestFailure> = .Ok(2); return e }
}

construct StrxPkThreeStr() extends Test {
    test {
        let s = strxPk(2)
        return s.count
    }
    // "three" = 5
    expect { let e: Result<Int, TestFailure> = .Ok(5); return e }
}

construct StrxPkBy() extends Test {
    test {
        let s = strxPk(3)
        return s.count
    }
    // "by" = 2
    expect { let e: Result<Int, TestFailure> = .Ok(2); return e }
}

construct StrxPkX() extends Test {
    test {
        let s = strxPk(4)
        return s.count
    }
    // "x" = 1
    expect { let e: Result<Int, TestFailure> = .Ok(1); return e }
}

construct StrxPkWrap() extends Test {
    test {
        let s = strxPk(5)
        return s.count
    }
    // 5 % 5 = 0 -> "apple" = 5
    expect { let e: Result<Int, TestFailure> = .Ok(5); return e }
}

construct StrxPkBorBound() extends Test {
    test {
        let s = strxPk(2)
        return strxBorLen(s)
    }
    // "three" = 5
    expect { let e: Result<Int, TestFailure> = .Ok(5); return e }
}

construct StrxPkLoop20() extends Test {
    test {
        var total = 0
        var i = 0
        while i < 20 {
            let s = strxPk(i)
            total = total + s.count
            i = i + 1
        }
        return total
    }
    // 4 periods of 15 = 60
    expect { let e: Result<Int, TestFailure> = .Ok(60); return e }
}

construct StrxPkLoop40() extends Test {
    test {
        var total = 0
        var i = 0
        while i < 40 {
            let s = strxPk(i)
            total = total + s.count
            i = i + 1
        }
        return total
    }
    // 8 periods of 15 = 120
    expect { let e: Result<Int, TestFailure> = .Ok(120); return e }
}

// Return a String from the test block directly
construct StrxRetHello() extends Test {
    test { return "hello" }
    expect { let e: Result<String, TestFailure> = .Ok("hello"); return e }
}

construct StrxRetPk0() extends Test {
    test {
        let s = strxPk(0)
        return s
    }
    expect { let e: Result<String, TestFailure> = .Ok("apple"); return e }
}

construct StrxRetPk3() extends Test {
    test {
        let s = strxPk(3)
        return s
    }
    expect { let e: Result<String, TestFailure> = .Ok("by"); return e }
}

// ---------------------------------------------------------------------------
// Struct with String field
// ---------------------------------------------------------------------------

construct StrxBoxNameLen() extends Test {
    test {
        let b = StrxBox { name: "test", code: 0 }
        return b.name.count
    }
    // "test" = 4
    expect { let e: Result<Int, TestFailure> = .Ok(4); return e }
}

construct StrxBoxMethod() extends Test {
    test {
        let b = StrxBox { name: "hello", code: 0 }
        return b.nameLen()
    }
    // "hello" = 5
    expect { let e: Result<Int, TestFailure> = .Ok(5); return e }
}

construct StrxBoxCoded() extends Test {
    test {
        let b = StrxBox { name: "", code: 99 }
        return b.coded()
    }
    // 99 + 1 = 100
    expect { let e: Result<Int, TestFailure> = .Ok(100); return e }
}

construct StrxBoxBorFn() extends Test {
    test {
        let b = StrxBox { name: "abc", code: 7 }
        return strxBoxBor(b)
    }
    // 3 + 7 = 10
    expect { let e: Result<Int, TestFailure> = .Ok(10); return e }
}

construct StrxBoxMutCode() extends Test {
    test {
        var b = StrxBox { name: "x", code: 0 }
        var i = 0
        while i < 10 {
            b.code = b.code + 1
            i = i + 1
        }
        return b.code
    }
    // 10
    expect { let e: Result<Int, TestFailure> = .Ok(10); return e }
}

construct StrxBoxNamePersist() extends Test {
    test {
        var b = StrxBox { name: "hello", code: 0 }
        b.code = 999
        return b.name.count
    }
    // "hello" = 5 (name not changed)
    expect { let e: Result<Int, TestFailure> = .Ok(5); return e }
}

construct StrxBoxCopyIndep() extends Test {
    test {
        let b = StrxBox { name: "abc", code: 5 }
        var c = b
        c.code = 99
        return b.code
    }
    // original unchanged = 5
    expect { let e: Result<Int, TestFailure> = .Ok(5); return e }
}

construct StrxBoxLoopBuild() extends Test {
    test {
        var total = 0
        var i = 0
        while i < 5 {
            let nm = strxPk(i)
            let b = StrxBox { name: move nm, code: i }
            total = total + b.nameLen()
            i = i + 1
        }
        return total
    }
    // 1 period: 5+2+5+2+1 = 15
    expect { let e: Result<Int, TestFailure> = .Ok(15); return e }
}

construct StrxBoxLoopAcc() extends Test {
    test {
        var acc = 0
        var i = 0
        while i < 8 {
            let nm = strxPk(i)
            let b = StrxBox { name: move nm, code: i }
            acc = acc + b.nameLen() + b.code
            i = i + 1
        }
        return acc
    }
    // i=0..7: nameLen=5,2,5,2,1,5,2,5 sum=27; code=0+1+2+3+4+5+6+7=28; total=55
    expect { let e: Result<Int, TestFailure> = .Ok(55); return e }
}

