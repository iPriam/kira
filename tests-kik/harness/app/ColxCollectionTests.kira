import Foundation

// ColxCollectionTests.kira
// Deep array test suite. All top-level names use colx / Colx prefix.
// ~85 tests (including ~20 trap tests).

// ---------------------------------------------------------------------------
// Struct types
// ---------------------------------------------------------------------------

struct ColxPt {
    var x: Int
    var y: Int
}

struct ColxBox {
    var lo: Int
    var hi: Int

    function size() -> Int {
        return self.hi - self.lo
    }

    function mid() -> Int {
        return (self.lo + self.hi) / 2
    }
}

struct ColxGrid {
    var cells: [Int]

    function sum() -> Int {
        var t = 0
        var i = 0
        while i < self.cells.count {
            t = t + self.cells[i]
            i = i + 1
        }
        return t
    }

    function cellCount() -> Int {
        return self.cells.count
    }
}

// ---------------------------------------------------------------------------
// Helper functions
// ---------------------------------------------------------------------------

function colxSum(xs: borrow [Int]) -> Int {
    var total = 0
    var i = 0
    while i < xs.count {
        total = total + xs[i]
        i = i + 1
    }
    return total
}

function colxMin(xs: borrow [Int]) -> Int {
    var m = xs[0]
    var i = 1
    while i < xs.count {
        if xs[i] < m {
            m = xs[i]
        }
        i = i + 1
    }
    return m
}

function colxMax(xs: borrow [Int]) -> Int {
    var m = xs[0]
    var i = 1
    while i < xs.count {
        if xs[i] > m {
            m = xs[i]
        }
        i = i + 1
    }
    return m
}

function colxContainsVal(xs: borrow [Int], val: Int) -> Bool {
    var i = 0
    while i < xs.count {
        if xs[i] == val {
            return true
        }
        i = i + 1
    }
    return false
}

function colxBuildRange(n: Int) -> [Int] {
    var xs: [Int] = []
    var i = 0
    while i < n {
        xs.append(i)
        i = i + 1
    }
    return xs
}

function colxBuildSquares(n: Int) -> [Int] {
    var xs: [Int] = []
    var i = 0
    while i < n {
        xs.append(i * i)
        i = i + 1
    }
    return xs
}

function colxBuildFib(n: Int) -> [Int] {
    var xs: [Int] = []
    if n == 0 {
        return xs
    }
    xs.append(0)
    if n == 1 {
        return xs
    }
    xs.append(1)
    var i = 2
    while i < n {
        let p1 = xs[i - 1]
        let p2 = xs[i - 2]
        xs.append(p1 + p2)
        i = i + 1
    }
    return xs
}

function colxReverse(xs: borrow [Int]) -> [Int] {
    var out: [Int] = []
    var i = xs.count
    while i > 0 {
        i = i - 1
        out.append(xs[i])
    }
    return out
}

function colxCountGt(xs: borrow [Int], thresh: Int) -> Int {
    var c = 0
    var i = 0
    while i < xs.count {
        if xs[i] > thresh {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

function colxProduct(xs: borrow [Int]) -> Int {
    var p = 1
    var i = 0
    while i < xs.count {
        p = p * xs[i]
        i = i + 1
    }
    return p
}

// ---------------------------------------------------------------------------
// GROUP A - Empty / count
// ---------------------------------------------------------------------------

Test ColxEmptyCount {
    test {
        let xs: [Int] = []
        return xs.count
    }
    expect { let e: Result<Int, TestFailure> = .Ok(0); return e }
}

Test ColxOneAppendCount {
    test {
        var xs: [Int] = []
        xs.append(42)
        return xs.count
    }
    expect { let e: Result<Int, TestFailure> = .Ok(1); return e }
}

Test ColxFiveAppendCount {
    test {
        var xs: [Int] = []
        xs.append(1)
        xs.append(2)
        xs.append(3)
        xs.append(4)
        xs.append(5)
        return xs.count
    }
    expect { let e: Result<Int, TestFailure> = .Ok(5); return e }
}

Test ColxTrapEmptyIdx0 {
    test {
        var xs: [Int] = []
        let _ = xs[0]
        return 0
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Runtime("")); return e }
}

Test ColxTrapEmptyIdx99 {
    test {
        var xs: [Int] = []
        let _ = xs[99]
        return 0
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Runtime("")); return e }
}

// ---------------------------------------------------------------------------
// GROUP B - Sums via helpers
// ---------------------------------------------------------------------------

Test ColxSumLiteral {
    test {
        var xs: [Int] = []
        xs.append(1)
        xs.append(2)
        xs.append(3)
        xs.append(4)
        xs.append(5)
        return colxSum(xs)
    }
    expect { let e: Result<Int, TestFailure> = .Ok(15); return e }
}

Test ColxSumRange10 {
    test {
        let xs = colxBuildRange(10)
        return colxSum(xs)
    }
    // 0+1+...+9 = 45
    expect { let e: Result<Int, TestFailure> = .Ok(45); return e }
}

Test ColxSumSquares5 {
    test {
        let xs = colxBuildSquares(5)
        return colxSum(xs)
    }
    // 0+1+4+9+16 = 30
    expect { let e: Result<Int, TestFailure> = .Ok(30); return e }
}

Test ColxSumSquares10 {
    test {
        let xs = colxBuildSquares(10)
        return colxSum(xs)
    }
    // 0+1+4+9+16+25+36+49+64+81 = 285
    expect { let e: Result<Int, TestFailure> = .Ok(285); return e }
}

Test ColxSumFib8 {
    test {
        let xs = colxBuildFib(8)
        return colxSum(xs)
    }
    // [0,1,1,2,3,5,8,13] -> 33
    expect { let e: Result<Int, TestFailure> = .Ok(33); return e }
}

Test ColxForInSumLiteral {
    test {
        var acc = 0
        for v in [10, 20, 30, 40, 50] {
            acc = acc + v
        }
        return acc
    }
    // 10+20+30+40+50 = 150
    expect { let e: Result<Int, TestFailure> = .Ok(150); return e }
}

Test ColxForInProductLiteral {
    test {
        var p = 1
        for v in [1, 2, 3, 4, 5] {
            p = p * v
        }
        return p
    }
    // 1*2*3*4*5 = 120
    expect { let e: Result<Int, TestFailure> = .Ok(120); return e }
}

Test ColxForInCountGt4 {
    test {
        var c = 0
        for v in [3, 1, 4, 1, 5, 9, 2, 6, 5, 3] {
            if v > 4 {
                c = c + 1
            }
        }
        return c
    }
    // elements >4: 5,9,6,5 => 4
    expect { let e: Result<Int, TestFailure> = .Ok(4); return e }
}

Test ColxForInMax {
    test {
        var m = 0
        for v in [3, 1, 4, 1, 5, 9, 2, 6, 5, 3] {
            if v > m {
                m = v
            }
        }
        return m
    }
    expect { let e: Result<Int, TestFailure> = .Ok(9); return e }
}

Test ColxForInSquaresSum {
    test {
        var acc = 0
        for v in [1, 2, 3, 4, 5] {
            acc = acc + v * v
        }
        return acc
    }
    // 1+4+9+16+25 = 55
    expect { let e: Result<Int, TestFailure> = .Ok(55); return e }
}

// ---------------------------------------------------------------------------
// GROUP C - Min / Max
// ---------------------------------------------------------------------------

Test ColxMinManual5 {
    test {
        var xs: [Int] = []
        xs.append(5)
        xs.append(3)
        xs.append(8)
        xs.append(2)
        xs.append(7)
        return colxMin(xs)
    }
    expect { let e: Result<Int, TestFailure> = .Ok(2); return e }
}

Test ColxMaxManual5 {
    test {
        var xs: [Int] = []
        xs.append(5)
        xs.append(3)
        xs.append(8)
        xs.append(2)
        xs.append(7)
        return colxMax(xs)
    }
    expect { let e: Result<Int, TestFailure> = .Ok(8); return e }
}

Test ColxMinAppend5 {
    test {
        var xs: [Int] = []
        xs.append(3)
        xs.append(1)
        xs.append(4)
        xs.append(1)
        xs.append(5)
        return colxMin(xs)
    }
    expect { let e: Result<Int, TestFailure> = .Ok(1); return e }
}

Test ColxMaxRange10 {
    test {
        let xs = colxBuildRange(10)
        return colxMax(xs)
    }
    expect { let e: Result<Int, TestFailure> = .Ok(9); return e }
}

Test ColxMinSquares8 {
    test {
        let xs = colxBuildSquares(8)
        return colxMin(xs)
    }
    // squares[0]=0
    expect { let e: Result<Int, TestFailure> = .Ok(0); return e }
}

Test ColxMaxSquares5 {
    test {
        let xs = colxBuildSquares(5)
        return colxMax(xs)
    }
    // [0,1,4,9,16] -> max=16
    expect { let e: Result<Int, TestFailure> = .Ok(16); return e }
}

Test ColxMinFib8 {
    test {
        let xs = colxBuildFib(8)
        return colxMin(xs)
    }
    // [0,1,1,2,3,5,8,13] -> min=0
    expect { let e: Result<Int, TestFailure> = .Ok(0); return e }
}

Test ColxMaxFib8 {
    test {
        let xs = colxBuildFib(8)
        return colxMax(xs)
    }
    // max=13
    expect { let e: Result<Int, TestFailure> = .Ok(13); return e }
}

// ---------------------------------------------------------------------------
// GROUP D - Contains
// ---------------------------------------------------------------------------

Test ColxContainsTrue {
    test {
        let xs = colxBuildRange(10)
        return colxContainsVal(xs, 5)
    }
    expect { let e: Result<Bool, TestFailure> = .Ok(true); return e }
}

Test ColxContainsFalse {
    test {
        let xs = colxBuildRange(10)
        return colxContainsVal(xs, 10)
    }
    expect { let e: Result<Bool, TestFailure> = .Ok(false); return e }
}

Test ColxContainsFirst {
    test {
        let xs = colxBuildRange(10)
        return colxContainsVal(xs, 0)
    }
    expect { let e: Result<Bool, TestFailure> = .Ok(true); return e }
}

Test ColxContainsLast {
    test {
        let xs = colxBuildRange(10)
        return colxContainsVal(xs, 9)
    }
    expect { let e: Result<Bool, TestFailure> = .Ok(true); return e }
}

Test ColxContainsMissing {
    test {
        var xs: [Int] = []
        xs.append(2)
        xs.append(4)
        xs.append(6)
        xs.append(8)
        return colxContainsVal(xs, 5)
    }
    expect { let e: Result<Bool, TestFailure> = .Ok(false); return e }
}

