// Group 3: borrow mut writeback
// ---------------------------------------------------------------------------

construct StxBorrowBumpX() extends Test {
    test {
        var p = StxPoint { x: 5, y: 3 }
        stxBumpX(p)
        return p.x
    }
    expect { let e: Result<Int, TestFailure> = .Ok(6); return e }
}

construct StxBorrowBumpBoth() extends Test {
    // p={5,3}, bumpBoth → {6,4}, sum=10
    test {
        var p = StxPoint { x: 5, y: 3 }
        stxBumpBoth(p)
        return p.x + p.y
    }
    expect { let e: Result<Int, TestFailure> = .Ok(10); return e }
}

construct StxBorrowBumpLoop() extends Test {
    // p={0,0}, 10x bumpBoth → {10,10}, return p.x=10
    test {
        var p = StxPoint { x: 0, y: 0 }
        var i = 0
        while i < 10 {
            stxBumpBoth(p)
            i = i + 1
        }
        return p.x
    }
    expect { let e: Result<Int, TestFailure> = .Ok(10); return e }
}

