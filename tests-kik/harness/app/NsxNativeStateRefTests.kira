import Foundation

// Native callback state is affine and reference-counted. Prefix: nsx / Nsx.
//
// `NativeState<T>` is one tracked owner. `nativeUserData` explicitly clones that
// owner; `nativeUserDataBorrow` exposes only a non-owning raw userdata word for
// call-scoped FFI. Kira cannot manufacture or destroy ownership through RawPtr:
// every Kira-side owner therefore remains an affine value the compiler can drop.

struct NsxCounter {
    var hits: Int = 0
}

function nsxExport(start: Int) -> NativeState<NsxCounter> {
    let state = nativeState(NsxCounter { hits: start })
    // `nativeUserData` is the explicit tracked-owner clone. The local owner dies
    // with this frame; the returned owner keeps the state alive.
    return nativeUserData(state)
}

function nsxBump(state: borrow NativeState<NsxCounter>) {
    var view = nativeRecover<NsxCounter>(state)
    view.hits = view.hits + 1
    return
}

function nsxConsume(state: NsxCounter) -> Int {
    let boxed = nativeState(state)
    let owner = nativeUserData(boxed)
    nsxBump(owner)
    return nativeRecover<NsxCounter>(owner).hits
}

construct NsxTwoClonesAreTwoTrackedOwners() extends Test {
    test {
        let handle = nativeState(NsxCounter { hits: 7 })
        let first = nativeUserData(handle)
        let second = nativeUserData(handle)
        nativeUserDataRelease(first)
        nsxBump(second)
        let seen = nativeRecover<NsxCounter>(second).hits
        nativeUserDataRelease(second)
        return seen
    }
    expect { let e: Result<Any, TestFailure> = .Ok(8) return e }
}

construct NsxAHandleReleasesWithItsScopeInALoop() extends Test {
    test {
        var total = 0
        var i = 0
        while i < 50 {
            total = total + nsxConsume(NsxCounter { hits: i })
            i = i + 1
        }
        return total
    }
    expect { let e: Result<Any, TestFailure> = .Ok(1275) return e }
}

construct NsxAMovedHandleTransfersItsOwner() extends Test {
    test {
        let first = nativeState(NsxCounter { hits: 20 })
        let second = move first
        nsxBump(second)
        return nativeRecover<NsxCounter>(second).hits
    }
    expect { let e: Result<Any, TestFailure> = .Ok(21) return e }
}

construct NsxOverwritingAHandleReleasesTheOldOne() extends Test {
    test {
        var slot = nativeState(NsxCounter { hits: 1 })
        let kept = nativeUserData(slot)
        slot = nativeState(NsxCounter { hits: 2 })
        nsxBump(kept)
        let seen = nativeRecover<NsxCounter>(kept).hits * 10 + nativeRecover<NsxCounter>(slot).hits
        nativeUserDataRelease(kept)
        return seen
    }
    expect { let e: Result<Any, TestFailure> = .Ok(22) return e }
}

construct NsxTheDeprecatedFreeIsOneRelease() extends Test {
    test {
        let handle = nativeState(NsxCounter { hits: 5 })
        let kept = nativeUserData(handle)
        nativeStateFree(handle)
        nsxBump(kept)
        let seen = nativeRecover<NsxCounter>(kept).hits
        nativeUserDataRelease(kept)
        return seen
    }
    expect { let e: Result<Any, TestFailure> = .Ok(6) return e }
}

struct NsxDropLeaf: Drop {
    var hits: Int = 0
    function drop(borrow mut self) { return }
}

struct NsxDropBox {
    var leaf: NsxDropLeaf
}

construct NsxNestedDropStateCanBeRecoveredAndReplaced() extends Test {
    test {
        let owner = nativeState(NsxDropBox { leaf: NsxDropLeaf { hits: 4 } })
        var view = nativeRecover<NsxDropBox>(owner)
        view.leaf = NsxDropLeaf { hits: 9 }
        return view.leaf.hits
    }
    expect { let e: Result<Any, TestFailure> = .Ok(9) return e }
}

struct NsxOwnerBox {
    var child: NativeState<NsxCounter>
}

construct NsxNestedNativeStateKeepsItsAffineOwner() extends Test {
    test {
        let child = nativeState(NsxCounter { hits: 30 })
        let outer = nativeState(NsxOwnerBox { child: move child })
        var view = nativeRecover<NsxOwnerBox>(outer)
        var childView = nativeRecover<NsxCounter>(view.child)
        childView.hits = childView.hits + 2
        return childView.hits
    }
    expect { let e: Result<Any, TestFailure> = .Ok(32) return e }
}
