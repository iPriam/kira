construct ColxARowSum5() extends Test {
    test {
        var vals: [Int] = []
        vals.append(1)
        vals.append(2)
        vals.append(3)
        vals.append(4)
        vals.append(5)
        let row = ColxARow { vals: move vals }
        return row.rowSum()
    }
    expect { let e: Result<Any, TestFailure> = .Ok(15) return e }
}

construct ColxARowCount5() extends Test {
    test {
        var vals: [Int] = []
        vals.append(1)
        vals.append(2)
        vals.append(3)
        vals.append(4)
        vals.append(5)
        let row = ColxARow { vals: move vals }
        return row.rowCount()
    }
    expect { let e: Result<Any, TestFailure> = .Ok(5) return e }
}

