        xs.append(8)
        xs.append(1)
        xs.append(9)
        xs.append(2)
        xs.append(7)
        xs.append(4)
        xs.append(6)
        let s = colxaSorted(xs)
        return colxSum(s)
    }
    // [1..9] sum=45
    expect { let e: Result<Any, TestFailure> = .Ok(45) return e }
}

construct ColxASortedDuplicates() extends Test {
    test {
        var xs: [Int] = []
        xs.append(7)
        xs.append(7)
        xs.append(3)
        xs.append(7)
        xs.append(3)
        xs.append(1)
        let s = colxaSorted(xs)
        return s[0] + s[5]
    }
    // sorted=[1,3,3,7,7,7] -> s[0]=1, s[5]=7 -> 8
    expect { let e: Result<Any, TestFailure> = .Ok(8) return e }
}

construct ColxASortedDuplicatesSum() extends Test {
    test {
        var xs: [Int] = []
        xs.append(7)
        xs.append(7)
        xs.append(3)
        xs.append(7)
        xs.append(3)
        xs.append(1)
        let s = colxaSorted(xs)
        return colxSum(s)
    }
    // 1+3+3+7+7+7=28
    expect { let e: Result<Any, TestFailure> = .Ok(28) return e }
}

construct ColxASortedTwo() extends Test {
    test {
        var xs: [Int] = []
        xs.append(100)
        xs.append(1)
        let s = colxaSorted(xs)
        return s[0] * 1000 + s[1]
    }
    // sorted=[1,100] -> 1*1000+100=1100
    expect { let e: Result<Any, TestFailure> = .Ok(1100) return e }
}

construct ColxASortedSingle() extends Test {
    test {
        var xs: [Int] = []
        xs.append(42)
        let s = colxaSorted(xs)
        return s[0]
    }
    expect { let e: Result<Any, TestFailure> = .Ok(42) return e }
}

construct ColxASortedAlreadySorted() extends Test {
    test {
        let xs = colxBuildRange(8)
        let s = colxaSorted(xs)
        return s[0] + s[7]
    }
    // [0,1,2,3,4,5,6,7] sorted = same -> s[0]=0, s[7]=7 -> 7
    expect { let e: Result<Any, TestFailure> = .Ok(7) return e }
}

construct ColxASortedReverseInput() extends Test {
    test {
        // Build [9,8,7,6,5,4,3,2,1,0]
        var xs: [Int] = []
        var i = 9
        while i >= 0 {
            xs.append(i)
            i = i - 1
        }
        let s = colxaSorted(xs)
        return s[0] + s[9]
    }
    // sorted=[0..9], s[0]=0, s[9]=9 -> 9
    expect { let e: Result<Any, TestFailure> = .Ok(9) return e }
}

construct ColxASortedCount() extends Test {
    test {
        var xs: [Int] = []
        xs.append(3)
        xs.append(1)
        xs.append(4)
        let s = colxaSorted(xs)
        return s.count
    }
    expect { let e: Result<Any, TestFailure> = .Ok(3) return e }
}

