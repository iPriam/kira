construct ColxASortedFirst() extends Test {
    test {
        var xs: [Int] = []
        xs.append(5)
        xs.append(3)
        xs.append(8)
        xs.append(1)
        xs.append(9)
        xs.append(2)
        xs.append(7)
        xs.append(4)
        xs.append(6)
        let s = colxaSorted(xs)
        return s[0]
    }
    expect { let e: Result<Any, TestFailure> = .Ok(1) return e }
}

construct ColxASortedLast() extends Test {
