construct StrxClsTriSides() extends Test {
    test {
        let t = StrxCTriangle()
        return t.sides
    }
    expect { let e: Result<Any, TestFailure> = .Ok(3) return e }
}

construct StrxClsRectSides() extends Test {
    test {
        let r = StrxCRect()
        return r.sides
    }
    expect { let e: Result<Any, TestFailure> = .Ok(4) return e }
}

construct StrxClsTriArea() extends Test {
    test {
        var t = StrxCTriangle()
        t.base_len = 5
        return t.area(2)
    }
    // 5 * 2 = 10
    expect { let e: Result<Any, TestFailure> = .Ok(10) return e }
}

construct StrxClsRectArea() extends Test {
    test {
        var r = StrxCRect()
        r.width = 3
        r.height = 4
        return r.area(2)
    }
    // 3 * 4 * 2 = 24
    expect { let e: Result<Any, TestFailure> = .Ok(24) return e }
}

construct StrxClsTriBaseFee() extends Test {
    test {
        let t = StrxCTriangle()
        return t.baseFee()
    }
    // inherited, not overridden -> 1
    expect { let e: Result<Any, TestFailure> = .Ok(1) return e }
}

construct StrxClsRectBaseFee() extends Test {
    test {
        let r = StrxCRect()
        return r.baseFee()
    }
    expect { let e: Result<Any, TestFailure> = .Ok(1) return e }
}

construct StrxClsArrTriLoop() extends Test {
    test {
        var tris: [StrxCTriangle] = []
        var i = 0
        while i < 5 {
            var t = StrxCTriangle()
            t.base_len = i + 1
            tris.append(move t)
            i = i + 1
        }
        var total = 0
        for j in 0..tris.count {
            total = total + tris[j].area(2)
        }
        return total
    }
    // area(2): 1*2+2*2+3*2+4*2+5*2 = 2+4+6+8+10 = 30
    expect { let e: Result<Any, TestFailure> = .Ok(30) return e }
}

construct StrxClsArrTriSides() extends Test {
    test {
        var tris: [StrxCTriangle] = []
        var i = 0
        while i < 5 {
            tris.append(StrxCTriangle())
            i = i + 1
        }
        var total = 0
        for j in 0..tris.count {
            total = total + tris[j].sides
        }
        return total
    }
    // 5 * 3 = 15
    expect { let e: Result<Any, TestFailure> = .Ok(15) return e }
}

construct StrxClsArrTriAcc() extends Test {
    test {
        var tris: [StrxCTriangle] = []
        var i = 0
        while i < 5 {
            var t = StrxCTriangle()
            t.base_len = i + 1
            tris.append(move t)
            i = i + 1
        }
        var total = 0
        for j in 0..tris.count {
            total = total + tris[j].area(2) + tris[j].sides + tris[j].baseFee()
        }
        return total
    }
    // area: 30; sides: 5*3=15; baseFee: 5*1=5 -> 50
    expect { let e: Result<Any, TestFailure> = .Ok(50) return e }
}

construct StrxClsArrRectLoop() extends Test {
    test {
        var rects: [StrxCRect] = []
        var i = 0
        while i < 4 {
            var r = StrxCRect()
            r.width = i + 1
            r.height = 2
            rects.append(move r)
            i = i + 1
        }
        var total = 0
        for j in 0..rects.count {
            total = total + rects[j].area(1)
        }
        return total
    }
    // width*2*1: 1*2+2*2+3*2+4*2 = 2+4+6+8 = 20
    expect { let e: Result<Any, TestFailure> = .Ok(20) return e }
}

construct StrxClsArrRectSides() extends Test {
    test {
        var rects: [StrxCRect] = []
        var i = 0
        while i < 3 {
            rects.append(StrxCRect())
            i = i + 1
        }
        var total = 0
        for j in 0..rects.count {
            total = total + rects[j].sides
        }
        return total
    }
    // 3 * 4 = 12
    expect { let e: Result<Any, TestFailure> = .Ok(12) return e }
}


// ---------------------------------------------------------------------------
// H9: self-dispatch from an inherited body, which the parity rule above used
// to avoid.
//
// The rule at the top of this file says no inherited base method may call
// `self.<m>()` where a descendant overrides `<m>`, because that dispatch was
// virtual on vm and hybrid and static on llvm. It is not any more: classes are
// monomorphized, so a parent's body is registered once per descendant with the
// receiver typed as the concrete class, and `self` is therefore statically the
// leaf on every backend. Static and virtual dispatch coincide, and the case the
// rule steered around has one answer everywhere.
//
// These are the cases that would have diverged. They are here so that a change
// which reintroduces a shared parent body — a vtable, or any lowering that
// stops monomorphizing — fails rather than quietly bringing back a program
// whose answer depends on its backend.
// ---------------------------------------------------------------------------

class StrxCDispatchBase {
    function tier() -> Int {
        return 1
    }

    // The shape the parity rule forbade: an inherited body reaching a method
    // the descendant replaced.
    function viaSelf() -> Int {
        return 100 + self.tier()
    }

    // Two hops, so a lowering that resolved the first correctly and the second
    // statically is caught as well.
    function viaSelfTwice() -> Int {
        return self.viaSelf() + self.tier()
    }
}

class StrxCDispatchMiddle extends StrxCDispatchBase {
    override function tier() -> Int {
        return 2
    }
}

class StrxCDispatchLeaf extends StrxCDispatchMiddle {
    override function tier() -> Int {
        return 3
    }

    // Calls up to the grandparent's body, which itself dispatches back down
    // through `self` — the two directions in one expression.
    override function viaSelf() -> Int {
        return 1000 + StrxCDispatchBase.viaSelf() + self.tier()
    }
}

construct StrxClsSelfDispatchAtTheBase() extends Test {
    test {
        let base = StrxCDispatchBase()
        return base.viaSelf()
    }
    // 100 + 1: nothing overrides anything.
    expect { let e: Result<Any, TestFailure> = .Ok(101) return e }
}

construct StrxClsSelfDispatchReachesTheOverride() extends Test {
    test {
        let middle = StrxCDispatchMiddle()
        return middle.viaSelf()
    }
    // 100 + 2: the inherited body reaches the descendant's `tier`, not its own.
    expect { let e: Result<Any, TestFailure> = .Ok(102) return e }
}

construct StrxClsSelfDispatchThroughTwoHops() extends Test {
    test {
        let middle = StrxCDispatchMiddle()
        return middle.viaSelfTwice()
    }
    // (100 + 2) + 2.
    expect { let e: Result<Any, TestFailure> = .Ok(104) return e }
}

construct StrxClsSelfDispatchUpThenDown() extends Test {
    test {
        let leaf = StrxCDispatchLeaf()
        return leaf.viaSelf()
    }
    // 1000 + (100 + 3) + 3: the grandparent's body runs against the leaf, so
    // its `self.tier()` is the leaf's.
    expect { let e: Result<Any, TestFailure> = .Ok(1106) return e }
}

construct StrxClsSelfDispatchUpThenDownTwice() extends Test {
    test {
        let leaf = StrxCDispatchLeaf()
        return leaf.viaSelfTwice()
    }
    // The inherited `viaSelfTwice` calls the leaf's `viaSelf` (1106) and then
    // the leaf's `tier` (3).
    expect { let e: Result<Any, TestFailure> = .Ok(1109) return e }
}

class StrxCDispatchLeft {
    function who() -> Int {
        return 1
    }
}

class StrxCDispatchRight {
    function tag() -> Int {
        return 20
    }
}

class StrxCDispatchMulti extends StrxCDispatchLeft, StrxCDispatchRight {
    override function who() -> Int {
        return 5
    }

    function both() -> Int {
        return self.who() + self.tag()
    }
}

construct StrxClsSelfDispatchAcrossTwoParents() extends Test {
    test {
        let multi = StrxCDispatchMulti()
        return multi.both()
    }
    // 5 + 20: the override on one side and the inherited method on the other,
    // reached through the same `self`.
    expect { let e: Result<Any, TestFailure> = .Ok(25) return e }
}

construct StrxClsSelfDispatchOverAnArray() extends Test {
    test {
        var items: [StrxCDispatchMiddle] = []
        var i = 0
        while i < 3 {
            items.append(StrxCDispatchMiddle())
            i = i + 1
        }
        var total = 0
        for j in 0..items.count {
            total = total + items[j].viaSelf()
        }
        return total
    }
    // 3 * 102, so the dispatch holds for an instance reached through storage
    // rather than a binding.
    expect { let e: Result<Any, TestFailure> = .Ok(306) return e }
}
