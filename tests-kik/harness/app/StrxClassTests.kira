import Foundation

// StrxClassTests.kira — deep class/inheritance coverage for `kira test`.
// PREFIX: strx / Strx  (all top-level names use this prefix).
//
// PARITY RULE: no inherited base method ever calls self.<m>() where a
// descendant overrides <m>. Super-calls use only parent-qualified
// Parent.method() inside overrides. Inherited methods read only self fields
// or call parent-qualified methods, which is consistent across all backends.

// ---------------------------------------------------------------------------
// H1: Three-level single inheritance, field-default overrides, super-calls
// ---------------------------------------------------------------------------

class StrxCBase {
    var points: Int = 10
    let rank: Int = 1

    // reads only self fields -> consistent on any subclass instance
    function score() -> Int {
        return self.points * self.rank
    }

    function tier() -> Int {
        return 1
    }
}

class StrxCSilver extends StrxCBase {
    override let rank = 3

    override function tier() -> Int {
        return 2
    }

    // parent-qualified super-call
    function bonus() -> Int {
        return StrxCBase.score() + self.points
    }
}

class StrxCGold extends StrxCSilver {
    override let rank = 7

    override function tier() -> Int {
        return 3
    }
}

// ---------------------------------------------------------------------------
// H2: Multiple inheritance with same-named members; parent-qualified dispatch
// ---------------------------------------------------------------------------

class StrxCX {
    let v: Int = 10

    function weight() -> Int {
        return 5
    }

    function compute(n: Int) -> Int {
        return n + 10
    }
}

class StrxCY {
    let v: Int = 20

    function weight() -> Int {
        return 8
    }

    function compute(n: Int) -> Int {
        return n + 20
    }
}

class StrxCMix extends StrxCX, StrxCY {
    function vSum() -> Int {
        return StrxCX.v + StrxCY.v
    }

    function wSum() -> Int {
        return StrxCX.weight() + StrxCY.weight()
    }

    function cSum(n: Int) -> Int {
        return StrxCX.compute(n) + StrxCY.compute(n)
    }
}

// ---------------------------------------------------------------------------
// H3: Array of leaf instances; overridden method dispatch in loops
// ---------------------------------------------------------------------------

class StrxCShape {
    let sides: Int = 0

    function area(k: Int) -> Int {
        return 0
    }

    // never overridden -> safe to call from any context
    function baseFee() -> Int {
        return 1
    }
}

class StrxCTriangle extends StrxCShape {
    override let sides = 3
    var base_len: Int = 1

    override function area(k: Int) -> Int {
        return self.base_len * k
    }
}

class StrxCRect extends StrxCShape {
    override let sides = 4
    var width: Int = 1
    var height: Int = 1

    override function area(k: Int) -> Int {
        return self.width * self.height * k
    }
}

// ---------------------------------------------------------------------------
// H4: Parameterized override + super-call chain, three levels
// ---------------------------------------------------------------------------

class StrxCVehicle {
    let base: Int = 5

    function cost(km: Int) -> Int {
        return self.base + km
    }
}

class StrxCCar extends StrxCVehicle {
    override let base = 10

    override function cost(km: Int) -> Int {
        return self.base + km * 2
    }
}

class StrxCTruck extends StrxCCar {
    override let base = 15

    // super-call via parent-qualified
    override function cost(km: Int) -> Int {
        return StrxCCar.cost(km) + 3
    }
}

// ---------------------------------------------------------------------------
// H5: Stateful class with mutable field, inheritance of non-conflicting methods
// ---------------------------------------------------------------------------

class StrxCCounter {
    var count: Int = 0

    function increment() -> Int {
        self.count = self.count + 1
        return self.count
    }

    function getCount() -> Int {
        return self.count
    }

    function reset() -> Int {
        self.count = 0
        return 0
    }
}

class StrxCSmartCounter extends StrxCCounter {
    var step: Int = 2

    function incrementBy(n: Int) -> Int {
        self.count = self.count + n
        return self.count
    }

    function addStep() -> Int {
        self.count = self.count + self.step
        return self.count
    }
}

// ---------------------------------------------------------------------------
// H6: Three-level hierarchy, field override chain, super-call in describe
// ---------------------------------------------------------------------------

class StrxCNode {
    var value: Int = 0
    let label: Int = 1

    function describe() -> Int {
        return self.value + self.label
    }
}

class StrxCLeaf extends StrxCNode {
    override let label = 10

    override function describe() -> Int {
        return self.value * self.label
    }
}

class StrxCDeepLeaf extends StrxCLeaf {
    override let label = 100

    // super-call: uses StrxCLeaf.describe() on self (self.label=100)
    override function describe() -> Int {
        return StrxCLeaf.describe() + self.label
    }
}

// ---------------------------------------------------------------------------
// H1 Tests
// ---------------------------------------------------------------------------

construct StrxClsBaseScore() extends Test {
    test {
        let a = StrxCBase()
        return a.score()
    }
    // 10 * 1 = 10
    expect { let e: Result<Int, TestFailure> = .Ok(10); return e }
}

construct StrxClsBaseTier() extends Test {
    test {
        let a = StrxCBase()
        return a.tier()
    }
    expect { let e: Result<Int, TestFailure> = .Ok(1); return e }
}

construct StrxClsSilverScore() extends Test {
    test {
        let s = StrxCSilver()
        return s.score()
    }
    // 10 * 3 = 30
    expect { let e: Result<Int, TestFailure> = .Ok(30); return e }
}

construct StrxClsSilverTier() extends Test {
    test {
        let s = StrxCSilver()
        return s.tier()
    }
    expect { let e: Result<Int, TestFailure> = .Ok(2); return e }
}

construct StrxClsSilverBonus() extends Test {
    test {
        let s = StrxCSilver()
        return s.bonus()
    }
    // StrxCBase.score() = 10*3=30; + points=10 -> 40
    expect { let e: Result<Int, TestFailure> = .Ok(40); return e }
}

construct StrxClsGoldScore() extends Test {
    test {
        let g = StrxCGold()
        return g.score()
    }
    // 10 * 7 = 70
    expect { let e: Result<Int, TestFailure> = .Ok(70); return e }
}

construct StrxClsGoldTier() extends Test {
    test {
        let g = StrxCGold()
        return g.tier()
    }
    expect { let e: Result<Int, TestFailure> = .Ok(3); return e }
}

construct StrxClsGoldBonus() extends Test {
    test {
        let g = StrxCGold()
        return g.bonus()
    }
    // inherited from Silver: StrxCBase.score()=10*7=70; + 10 = 80
    expect { let e: Result<Int, TestFailure> = .Ok(80); return e }
}

construct StrxClsGoldMutPoints() extends Test {
    test {
        var g = StrxCGold()
        var i = 0
        while i < 10 {
            g.points = g.points + 7
            i = i + 1
        }
        return g.points
    }
    // 10 + 70 = 80... wait 10 + 10*7 = 80
    expect { let e: Result<Int, TestFailure> = .Ok(80); return e }
}

construct StrxClsGoldMutScore() extends Test {
    test {
        var g = StrxCGold()
        var i = 0
        while i < 10 {
            g.points = g.points + 7
            i = i + 1
        }
        return g.score()
    }
    // points = 80; score = 80*7 = 560
    expect { let e: Result<Int, TestFailure> = .Ok(560); return e }
}

construct StrxClsBaseRankField() extends Test {
    test {
        let a = StrxCBase()
        return a.rank
    }
    expect { let e: Result<Int, TestFailure> = .Ok(1); return e }
}

construct StrxClsSilverRankField() extends Test {
    test {
        let s = StrxCSilver()
        return s.rank
    }
    expect { let e: Result<Int, TestFailure> = .Ok(3); return e }
}

construct StrxClsGoldRankField() extends Test {
    test {
        let g = StrxCGold()
        return g.rank
    }
    expect { let e: Result<Int, TestFailure> = .Ok(7); return e }
}

construct StrxClsTierSum() extends Test {
    test {
        let a = StrxCBase()
        let s = StrxCSilver()
        let g = StrxCGold()
        return a.tier() + s.tier() + g.tier()
    }
    // 1 + 2 + 3 = 6
    expect { let e: Result<Int, TestFailure> = .Ok(6); return e }
}

construct StrxClsScoreSum() extends Test {
    test {
        let a = StrxCBase()
        let s = StrxCSilver()
        let g = StrxCGold()
        return a.score() + s.score() + g.score()
    }
    // 10 + 30 + 70 = 110
    expect { let e: Result<Int, TestFailure> = .Ok(110); return e }
}

construct StrxClsSilverMutBonus() extends Test {
    test {
        var s = StrxCSilver()
        s.points = 20
        return s.bonus()
    }
    // StrxCBase.score() = 20*3=60; + 20 = 80
    expect { let e: Result<Int, TestFailure> = .Ok(80); return e }
}

construct StrxClsH1Loop() extends Test {
    test {
        let a = StrxCBase()
        let s = StrxCSilver()
        let g = StrxCGold()
        var acc = 0
        acc = acc + a.score() + a.tier()
        acc = acc + s.score() + s.tier()
        acc = acc + g.score() + g.tier()
        return acc
    }
    // (10+1) + (30+2) + (70+3) = 11+32+73 = 116
    expect { let e: Result<Int, TestFailure> = .Ok(116); return e }
}

// ---------------------------------------------------------------------------
// H2 Tests
// ---------------------------------------------------------------------------

construct StrxClsMixVSum() extends Test {
    test {
        let m = StrxCMix()
        return m.vSum()
    }
    // 10 + 20 = 30
    expect { let e: Result<Int, TestFailure> = .Ok(30); return e }
}

construct StrxClsMixWSum() extends Test {
    test {
        let m = StrxCMix()
        return m.wSum()
    }
    // 5 + 8 = 13
    expect { let e: Result<Int, TestFailure> = .Ok(13); return e }
}

construct StrxClsMixCSum5() extends Test {
    test {
        let m = StrxCMix()
        return m.cSum(5)
    }
    // (5+10) + (5+20) = 40
    expect { let e: Result<Int, TestFailure> = .Ok(40); return e }
}

construct StrxClsMixCSum0() extends Test {
    test {
        let m = StrxCMix()
        return m.cSum(0)
    }
    // (0+10) + (0+20) = 30
    expect { let e: Result<Int, TestFailure> = .Ok(30); return e }
}

construct StrxClsMixCLoop() extends Test {
    test {
        let m = StrxCMix()
        var sum = 0
        var n = 0
        while n < 5 {
            sum = sum + m.cSum(n)
            n = n + 1
        }
        return sum
    }
    // n=0: 30; n=1: 32; n=2: 34; n=3: 36; n=4: 38 -> 170
    expect { let e: Result<Int, TestFailure> = .Ok(170); return e }
}

construct StrxClsMixWLoopMul() extends Test {
    test {
        let m = StrxCMix()
        var acc = 0
        var k = 0
        while k < 4 {
            acc = acc + m.wSum() * k
            k = k + 1
        }
        return acc
    }
    // 0*13 + 1*13 + 2*13 + 3*13 = 0+13+26+39 = 78
    expect { let e: Result<Int, TestFailure> = .Ok(78); return e }
}

construct StrxClsMixAllFields() extends Test {
    test {
        let m = StrxCMix()
        return m.vSum() + m.wSum()
    }
    // 30 + 13 = 43
    expect { let e: Result<Int, TestFailure> = .Ok(43); return e }
}

// ---------------------------------------------------------------------------
// H3 Tests
// ---------------------------------------------------------------------------

construct StrxClsTriSides() extends Test {
    test {
        let t = StrxCTriangle()
        return t.sides
    }
    expect { let e: Result<Int, TestFailure> = .Ok(3); return e }
}

construct StrxClsRectSides() extends Test {
    test {
        let r = StrxCRect()
        return r.sides
    }
    expect { let e: Result<Int, TestFailure> = .Ok(4); return e }
}

construct StrxClsTriArea() extends Test {
    test {
        var t = StrxCTriangle()
        t.base_len = 5
        return t.area(2)
    }
    // 5 * 2 = 10
    expect { let e: Result<Int, TestFailure> = .Ok(10); return e }
}

construct StrxClsRectArea() extends Test {
    test {
        var r = StrxCRect()
        r.width = 3
        r.height = 4
        return r.area(2)
    }
    // 3 * 4 * 2 = 24
    expect { let e: Result<Int, TestFailure> = .Ok(24); return e }
}

construct StrxClsTriBaseFee() extends Test {
    test {
        let t = StrxCTriangle()
        return t.baseFee()
    }
    // inherited, not overridden -> 1
    expect { let e: Result<Int, TestFailure> = .Ok(1); return e }
}

construct StrxClsRectBaseFee() extends Test {
    test {
        let r = StrxCRect()
        return r.baseFee()
    }
    expect { let e: Result<Int, TestFailure> = .Ok(1); return e }
}

construct StrxClsArrTriLoop() extends Test {
    test {
        var tris: [StrxCTriangle] = []
        var i = 0
        while i < 5 {
            var t = StrxCTriangle()
            t.base_len = i + 1
            tris.append(move t)
            i = i + 1
        }
        var total = 0
        var j = 0
        while j < tris.count {
            total = total + tris[j].area(2)
            j = j + 1
        }
        return total
    }
    // area(2): 1*2+2*2+3*2+4*2+5*2 = 2+4+6+8+10 = 30
    expect { let e: Result<Int, TestFailure> = .Ok(30); return e }
}

construct StrxClsArrTriSides() extends Test {
    test {
        var tris: [StrxCTriangle] = []
        var i = 0
        while i < 5 {
            tris.append(StrxCTriangle())
            i = i + 1
        }
        var total = 0
        var j = 0
        while j < tris.count {
            total = total + tris[j].sides
            j = j + 1
        }
        return total
    }
    // 5 * 3 = 15
    expect { let e: Result<Int, TestFailure> = .Ok(15); return e }
}

construct StrxClsArrTriAcc() extends Test {
    test {
        var tris: [StrxCTriangle] = []
        var i = 0
        while i < 5 {
            var t = StrxCTriangle()
            t.base_len = i + 1
            tris.append(move t)
            i = i + 1
        }
        var total = 0
        var j = 0
        while j < tris.count {
            total = total + tris[j].area(2) + tris[j].sides + tris[j].baseFee()
            j = j + 1
        }
        return total
    }
    // area: 30; sides: 5*3=15; baseFee: 5*1=5 -> 50
    expect { let e: Result<Int, TestFailure> = .Ok(50); return e }
}

construct StrxClsArrRectLoop() extends Test {
    test {
        var rects: [StrxCRect] = []
        var i = 0
        while i < 4 {
            var r = StrxCRect()
            r.width = i + 1
            r.height = 2
            rects.append(move r)
            i = i + 1
        }
        var total = 0
        var j = 0
        while j < rects.count {
            total = total + rects[j].area(1)
            j = j + 1
        }
        return total
    }
    // width*2*1: 1*2+2*2+3*2+4*2 = 2+4+6+8 = 20
    expect { let e: Result<Int, TestFailure> = .Ok(20); return e }
}

construct StrxClsArrRectSides() extends Test {
    test {
        var rects: [StrxCRect] = []
        var i = 0
        while i < 3 {
            rects.append(StrxCRect())
            i = i + 1
        }
        var total = 0
        var j = 0
        while j < rects.count {
            total = total + rects[j].sides
            j = j + 1
        }
        return total
    }
    // 3 * 4 = 12
    expect { let e: Result<Int, TestFailure> = .Ok(12); return e }
}

