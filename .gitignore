/target
.kira-build/
.DS_Store

# Agent scratch. Nothing here is tracked, which is what lets scratch tooling
# (including Python) exist without ever reaching a commit.
.codex/tmp/
.codex/scheduled_tasks.lock
# One machine's tool permissions, beside the settings the repository does share.
.codex/settings.local.json
Cargo.lock
kira.lock

# The archives an example's README tells a reader to build. They are outputs of
# the commands beside them, per platform, and a checkout builds its own.
examples/*/NativeLibs/lib/

# A stray compiler output in the root is never ours to keep.
/a.out
