#platforms

// ============================================================================
// KEYWORDS - Function and Variable Declarations
// ============================================================================
func main() {
    let x: int = 42;
    let y: float = 3.14;
    let z: bool = true;
    let message: string = "Hello, Kira!";
    
    return;
}

// ============================================================================
// KEYWORDS - Control Flow (if/else)
// ============================================================================
func testIfElse(value: int) {
    if value > 0 {
        printIn("positive");
    } else {
        printIn("non-positive");
    }
    
    if value == 0 {
        printIn("zero");
    } else {
        if value < 0 {
            printIn("negative");
        } else {
            printIn("positive");
        }
    }
}

// ============================================================================
// KEYWORDS - Loops (for, while, break, continue)
// ============================================================================
func testLoops() {
    // For loop with range operator
    for i in 0..10 {
        if i == 5 {
            continue;
        }
        printIn("iteration");
    }
    
    // For loop with inclusive range operator
    for j in 0..=10 {
        printIn("inclusive iteration");
    }
    
    // While loop
    while true {
        break;
    }
    
    let counter: int = 0;
    while counter < 10 {
        counter = counter + 1;
        if counter == 5 {
            continue;
        }
    }
}

