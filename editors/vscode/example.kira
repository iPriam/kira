// ============================================================================
// COMPLEX EXAMPLES - Combining Multiple Features
// ============================================================================
@Native
func complexExample(value: int) {
    // Comment in function
    let result: int = 0;
    
    if value > 0 {
        for i in 0..value {
            result = result + i;
            if result > 100 {
                break;
            }
        }
    } else {
        while result < 10 {
            result = result + 1;
        }
    }
    
    printIn("Result calculated");
    return;
}

@Runtime
@Platforms(linux, macos)
func multiAttributeFunction() {
    let x: int = 42;
    let y: float = 3.14;
    let z: bool = true;
    let s: string = "test";
    
    if x > 0 && z {
        printIn("condition met");
    }
}

// ============================================================================
// EDGE CASES
// ============================================================================
func edgeCases() {
    // Keywords should not match partial words
    let function: int = 0;
    let letter: int = 0;
    let structure: int = 0;
    
    // Types should not match partial words
    let integer: int = 0;
    let floating: float = 0.0;
    let boolean: bool = false;
    let stringValue: string = "";
    
    // Multiple operators in expression
    let complex: int = 1 + 2 * 3 - 4 / 2 % 3;
    let comparison: bool = 1 < 2 && 3 > 2 || 4 == 4 && 5 != 6;
}
