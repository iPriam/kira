// Kira syntax showcase for editor tooling: a trait with a default method, a
// struct that conforms to it, an enum read back with `match`, a construct
// family with a backed declaration, a borrowed parameter, and a foreign
// declaration that retains one of its arguments.

trait Describable {
    function describe(borrow self) -> String
    function announce(borrow self) -> String {
        return "It is " + self.describe()
    }
}

struct Point: Describable {
    let x: Int
    let y: Int

    function describe(borrow self) -> String {
        return "a point"
    }
}

enum Shape {
    Circle(Int)
    Rectangle(Int)
    Empty
}

function area(shape: Shape) -> Int {
    match shape {
        Circle(radius) -> { return radius * radius * 3 }
        Rectangle(side) -> { return side * side }
        Empty -> { return 0 }
    }
}

// The family every backed declaration below extends.
construct Test {
    requires {
        function test() -> Int
        function expect() -> Int
    }
}

// A construct-backed declaration: no fields of its own, just the two
// members `requires` asked for.
construct AreaOfACircleIsRadiusSquaredTimesThree() extends Test {
    test { return area(.Circle(3)) }
    expect { return 27 }
}

// A borrowed parameter: the caller keeps ownership after the call.
function sumOfCoordinates(point: borrow Point) -> Int {
    return point.x + point.y
}

// `retains:` names the parameter the callee keeps a pointer to past the
// call, so a caller passing a named value must `move` it in.
@FFI.Extern { library: kira_example; symbol: kira_example_keep; abi: c; retains: text; }
function keep(text: CString) -> Void;

@Main
function main() {
    let origin = Point { x = 0, y = 0 }
    print(origin.announce())
    print(area(.Rectangle(4)))
    print(sumOfCoordinates(origin))
}
