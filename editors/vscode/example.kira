    bottomRight: Point
}

struct Person {
    name: string,
    age: int,
    height: float,
    isActive: bool
}

// ============================================================================
// TYPES - All Built-in Types
// ============================================================================
func testTypes() {
    let intValue: int = 100;
    let floatValue: float = 99.99;
    let boolValue: bool = false;
    let stringValue: string = "test";
    
    // Types in various contexts
    let a: int;
    let b: float;
    let c: bool;
    let d: string;
}

// ============================================================================
// LITERALS - Numbers
// ============================================================================
func testNumericLiterals() {
    let integer: int = 42;
    let negative: int = -100;
    let zero: int = 0;
    let large: int = 1000000;
    
    let floatingPoint: float = 3.14;
    let negativeFloat: float = -2.5;
    let zeroFloat: float = 0.0;
    let scientific: float = 1.5;
}

// ============================================================================
// LITERALS - Booleans
// ============================================================================
func testBooleanLiterals() {
    let trueValue: bool = true;
    let falseValue: bool = false;
    
    if true {
        printIn("always true");
    }
    
    if false {
        printIn("never executed");
    }
}

// ============================================================================
// LITERALS - Strings
// ============================================================================
func testStringLiterals() {
    let simple: string = "hello";
    let withSpaces: string = "hello world";
    let empty: string = "";
    let withNumbers: string = "test123";
    let withSpecialChars: string = "test!@#$%";
}

// ============================================================================
// OPERATORS - Arithmetic
// ============================================================================
func testArithmeticOperators(a: int, b: int) {
    let sum: int = a + b;
    let difference: int = a - b;
    let product: int = a * b;
    let quotient: int = a / b;
    let remainder: int = a % b;
}

// ============================================================================
// OPERATORS - Comparison
// ============================================================================
func testComparisonOperators(x: int, y: int) {
    let equal: bool = x == y;
    let notEqual: bool = x != y;
    let lessThan: bool = x < y;
    let greaterThan: bool = x > y;
    let lessOrEqual: bool = x <= y;
    let greaterOrEqual: bool = x >= y;
}

// ============================================================================
// OPERATORS - Logical
// ============================================================================
func testLogicalOperators(a: bool, b: bool) {
    let andResult: bool = a && b;
    let orResult: bool = a || b;
    let notResult: bool = !a;
    
    if a && b {
        printIn("both true");
    }
    
    if a || b {
        printIn("at least one true");
    }
    
    if !a {
        printIn("a is false");
    }
}

// ============================================================================
// OPERATORS - Assignment
// ============================================================================
func testAssignment() {
    let x: int = 10;
    x = 20;
    x = x + 5;
}

// ============================================================================
// OPERATORS - Range
// ============================================================================
func testRangeOperators() {
    // Exclusive range
    for i in 0..10 {
        printIn("exclusive");
    }
    
    // Inclusive range
    for j in 0..=10 {
        printIn("inclusive");
    }
    
    for k in 1..100 {
        printIn("range");
    }
}

// ============================================================================
// BUILT-IN FUNCTIONS
// ============================================================================
func testBuiltInFunctions() {
    printIn("Hello, World!");
    printIn("Testing built-in function");
    printIn("Multiple calls");
}

